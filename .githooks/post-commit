#!/usr/bin/env bash
# ae-sdd Rust-only post-commit harness/build/distribution hook.
# A completed Git commit is never rolled back when the follow-up chain fails.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ] || [ ! -f "$REPO_ROOT/source/SKILL.md" ]; then
    exit 0
fi

if [ "${SKIP_AE_SDD_HOOK:-0}" = "1" ]; then
    echo "ae-sdd post-commit: skipped by SKIP_AE_SDD_HOOK=1"
    exit 0
fi

CHANGED="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || true)"
MEANINGFUL="$(printf '%s\n' "$CHANGED" | grep -vE '^(source/CHANGELOG/|README\.md$|\.githooks/)' || true)"
if [ -z "$MEANINGFUL" ]; then
    exit 0
fi

run_build_tool() {
    if [ -x "$REPO_ROOT/target/release/ae-sdd-build.exe" ]; then
        "$REPO_ROOT/target/release/ae-sdd-build.exe" "$@"
    elif [ -x "$REPO_ROOT/target/release/ae-sdd-build" ]; then
        "$REPO_ROOT/target/release/ae-sdd-build" "$@"
    elif command -v cargo >/dev/null 2>&1; then
        (cd "$REPO_ROOT" && cargo run -p ae-sdd-build --release -- "$@")
    else
        echo "ae-sdd post-commit: ae-sdd-build and cargo are unavailable" >&2
        return 127
    fi
}

COMMIT_ID="$(git rev-parse HEAD 2>/dev/null || true)"
if [ -z "$COMMIT_ID" ]; then
    echo "ae-sdd post-commit: HEAD could not be resolved; follow-up chain did not run" >&2
    exit 0
fi
USER_HOME="${HOME:-$REPO_ROOT}"
DISTRIBUTOR_REGISTRY="$USER_HOME/.ae-sdd/distributors.json"
# The package directory is replaced by an atomic rename, so it must not be held
# open by any other process. `dist/ae-sdd` acquired a stale directory handle that
# survives daemon restarts, which failed every post-commit compile with
# `os error 32`. `dist/package` is an equivalent gitignored output location.
PACKAGE_DIR="$REPO_ROOT/dist/package"

echo "ae-sdd post-commit: generating native harness"
HARNESS_OUTPUT="$(
    run_build_tool harness \
        --source "$REPO_ROOT/source/SKILL.md" \
        --source "$REPO_ROOT/source/HARNESS.md" \
        --target "$REPO_ROOT/.harness/agent.md" \
        --title "ae-sdd Agent Harness" \
        --allowed-root "$REPO_ROOT" 2>&1
)"
HARNESS_STATUS=$?
printf '%s\n' "$HARNESS_OUTPUT" | tail -30
if [ "$HARNESS_STATUS" -ne 0 ]; then
    echo "ae-sdd post-commit: native harness generation failed; commit remains intact" >&2
    exit 0
fi

# Hosts come from ~/.ae-sdd/distributors.json, which is the only place they are
# declared. This list used to be hardcoded here as well, and the two drifted in
# both directions: qoder was registered but never listed, so it silently went
# four minor versions stale, while harness was listed but never registered, so
# `create_dir_all` invented ~/.harness/skills/ae-sdd for a host that was not
# installed. Registering a host is now the single edit.
#
# A host whose `detect` fails is skipped and named rather than having its
# directory created. Managed L2 instruction files come from each entry's
# l2GlobalFile; an entry without one stays package-only. A target that is
# missing or carries no ae-sdd-l2-ssot anchor is reported as a skip and is never
# created or bootstrapped.
if [ ! -f "$DISTRIBUTOR_REGISTRY" ]; then
    echo "ae-sdd post-commit: distributor registry $DISTRIBUTOR_REGISTRY is absent; no host received the package" >&2
    exit 0
fi
echo "ae-sdd post-commit: compiling, verifying, distributing, and syncing managed L2 instructions"
POST_COMMIT_OUTPUT="$(
    run_build_tool post-commit \
        --repository-root "$REPO_ROOT" \
        --source "$REPO_ROOT/source" \
        --package "$PACKAGE_DIR" \
        --commit "$COMMIT_ID" \
        --allowed-root "$REPO_ROOT" \
        --allowed-root "$USER_HOME" \
        --distributor-registry "$DISTRIBUTOR_REGISTRY" \
        --registry-home "$USER_HOME" 2>&1
)"
POST_COMMIT_STATUS=$?
printf '%s\n' "$POST_COMMIT_OUTPUT" | tail -30
if [ "$POST_COMMIT_STATUS" -ne 0 ]; then
    echo "ae-sdd post-commit: native compile/verify/distribution or managed L2 sync failed; commit remains intact" >&2
    exit 0
fi

echo "ae-sdd post-commit: native harness and distribution completed"
exit 0
