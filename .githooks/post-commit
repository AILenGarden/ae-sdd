#!/usr/bin/env bash
# ae-sdd native post-commit distribution hook.
# A completed Git commit is never rolled back when distribution fails.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ] || [ ! -f "$REPO_ROOT/source/SKILL.md" ]; then
    exit 0
fi

if [ "${SKIP_AE_SDD_HOOK:-0}" = "1" ]; then
    echo "ae-sdd post-commit: skipped by SKIP_AE_SDD_HOOK=1"
    exit 0
fi

CHANGED="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || true)"
MEANINGFUL="$(printf '%s\n' "$CHANGED" | grep -vE '^(source/CHANGELOG/|README\.md$|\.githooks/)' || true)"
if [ -z "$MEANINGFUL" ]; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "ae-sdd post-commit: cargo is unavailable; native distribution did not run" >&2
    exit 0
fi

case "$REPO_ROOT${HOME:-}" in
    *\"*)
        echo "ae-sdd post-commit: paths containing a quote are unsupported" >&2
        exit 0
        ;;
esac

COMMIT_ID="$(git rev-parse HEAD 2>/dev/null || printf 'unknown')"
TMP_DIR="$(mktemp -d 2>/dev/null || true)"
if [ -z "$TMP_DIR" ]; then
    echo "ae-sdd post-commit: could not create a private request directory" >&2
    exit 0
fi
trap 'rm -rf "$TMP_DIR"' EXIT

COMPILE_REQUEST="$TMP_DIR/compile.json"
DISTRIBUTE_REQUEST="$TMP_DIR/distribute.json"
PACKAGE_DIR="$REPO_ROOT/dist/ae-sdd"
USER_HOME="${HOME:-$REPO_ROOT}"

cat >"$COMPILE_REQUEST" <<EOF
{
  "schemaVersion": "ae-sdd-native-job/v1",
  "entrypoint": "post-commit.compile",
  "actor": "git:post-commit",
  "reason": "compile declarative package after a functional commit",
  "idempotencyKey": "post-commit-$COMMIT_ID-compile",
  "mode": "apply",
  "allowedRoots": ["$REPO_ROOT"],
  "job": {
    "kind": "compile",
    "input": {
      "sourceDirectory": "$REPO_ROOT/source",
      "outputDirectory": "$PACKAGE_DIR",
      "generatedConfigs": []
    }
  }
}
EOF

cat >"$DISTRIBUTE_REQUEST" <<EOF
{
  "schemaVersion": "ae-sdd-native-job/v1",
  "entrypoint": "post-commit.distribute",
  "actor": "git:post-commit",
  "reason": "distribute the verified native package after compile",
  "idempotencyKey": "post-commit-$COMMIT_ID-distribute",
  "mode": "apply",
  "allowedRoots": ["$REPO_ROOT", "$USER_HOME"],
  "job": {
    "kind": "distribute",
    "input": {
      "packageDirectory": "$PACKAGE_DIR",
      "targetDirectories": [
        "$USER_HOME/.claude/skills/ae-sdd",
        "$USER_HOME/.codex/skills/ae-sdd",
        "$USER_HOME/.zcode/skills/ae-sdd",
        "$USER_HOME/.mavis/skills/ae-sdd",
        "$USER_HOME/.hermes/skills/ae-sdd"
      ]
    }
  }
}
EOF

echo "ae-sdd post-commit: compiling native distribution package"
COMPILE_OUTPUT="$(
    cd "$REPO_ROOT" &&
    cargo run -p ae-sdd-build --release -- native-job --request "$COMPILE_REQUEST" 2>&1
)"
COMPILE_STATUS=$?
printf '%s\n' "$COMPILE_OUTPUT" | tail -30
if [ "$COMPILE_STATUS" -ne 0 ]; then
    echo "ae-sdd post-commit: native compile failed; commit remains intact" >&2
    exit 0
fi

echo "ae-sdd post-commit: distributing verified native package"
DISTRIBUTE_OUTPUT="$(
    cd "$REPO_ROOT" &&
    cargo run -p ae-sdd-build --release -- native-job --request "$DISTRIBUTE_REQUEST" 2>&1
)"
DISTRIBUTE_STATUS=$?
printf '%s\n' "$DISTRIBUTE_OUTPUT" | tail -30
if [ "$DISTRIBUTE_STATUS" -ne 0 ]; then
    echo "ae-sdd post-commit: native distribution failed; commit remains intact" >&2
    exit 0
fi

echo "ae-sdd post-commit: native compile and distribution completed"
exit 0
