#!/usr/bin/env bash
# ae-sdd post-commit hook（v3.4.4 单入口版）
#
# 触发条件：ae-sdd 母版仓的任意 commit 提交完成
# 动作：调 scripts/distribute.py 单入口 orchestrator，由它内部串联：
#   build_dist → 遍历分发器（claude/codex/zcode/hermes copytree + mavis harness_mount）
#   每个分发器各自 compile/install/verify/cleanup
#
# 跳过策略：
#   - 非母版仓库（无 source/SKILL.md）：静默退出 0
#   - 仅修改 CHANGELOG/ 或 README.md：跳过（无功能性变更）
#   - SKIP_AE_SDD_HOOK=1 环境变量：跳过（紧急旁路）
#   - 任何步骤失败：不回滚（commit 已落库），仅输出错误，不阻断 git

set -u  # 不开 -e：单步失败不阻断后续

REPO_ROOT="$(git rev-parse --show-toplevel)"
AE_SDD="$REPO_ROOT"

# ── 0. 旁路开关 ───────────────────────────────────────────────────────
if [ "${SKIP_AE_SDD_HOOK:-0}" = "1" ]; then
    echo "⏭️  ae-sdd post-commit: SKIP_AE_SDD_HOOK=1，跳过"
    exit 0
fi

# ── 1. 仅母版仓触发 ──────────────────────────────────────────────────
if [ ! -f "$AE_SDD/source/SKILL.md" ]; then
    exit 0
fi

# ── 2. 跳过 CHANGELOG-only / README-only 提交 ─────────────────────────
CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || echo "")
HAS_MEANINGFUL=$(echo "$CHANGED" | grep -vE '^(source/CHANGELOG/|README\.md$|\.githooks/)' || true)
if [ -z "$HAS_MEANINGFUL" ]; then
    exit 0
fi

echo "🔄 ae-sdd post-commit: 检测到功能性变更，启动分发闭环..."

# ── 3. 探测 Python ───────────────────────────────────────────────────
PYTHON=""
for cand in python python3 py; do
    if command -v "$cand" >/dev/null 2>&1; then
        PYTHON=$(command -v "$cand")
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "⚠️  ae-sdd post-commit: 找不到 python，跳过分发"
    exit 0
fi

# ── 4. 单入口：distribute.py ─────────────────────────────────────────
# distribute.py 内部：build_dist → 遍历 active 分发器 → 各自编译+安装+校验+清理
# --quiet：post-commit 场景只输出关键状态
# --from-commit：标记由 hook 触发（影响日志详尽度）
# 各分发器独立 try/except，单步失败不阻断其他分发器（保持"失败不阻断 git"语义）
if [ -f "$AE_SDD/scripts/distribute.py" ]; then
    if "$PYTHON" "$AE_SDD/scripts/distribute.py" --quiet --from-commit 2>&1 | tail -30; then
        echo "✅ ae-sdd post-commit: 分发闭环结束"
    else
        echo "⚠️  ae-sdd post-commit: distribute.py 返回非零（commit 已落库，未回滚）"
    fi
else
    echo "⚠️  ae-sdd post-commit: scripts/distribute.py 不存在，跳过"
fi

exit 0
