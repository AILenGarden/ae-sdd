#!/usr/bin/env bash
# ae-sdd post-commit hook
#
# 触发条件：ae-sdd 母版仓的任意 commit 提交完成
# 动作链（v3.4.0）：
#   1. source/ → dist/ae-sdd/    (build_dist.py)
#   2. dist/ae-sdd/ → ~/.claude/skills/ae-sdd + ~/.zcode/skills/ae-sdd  (install.py)
#   3. source/HARNESS+SKILL → harness/.harness/agent.md  (convert-ae-sdd-to-harness.ps1)
#   4. mavis harness remount ae-sdd
#
# 跳过策略：
#   - 非母版仓库（无 source/SKILL.md）：静默退出 0
#   - 仅修改 CHANGELOG/ 或 README.md：跳过（无功能性变更）
#   - SKIP_AE_SDD_HOOK=1 环境变量：跳过（紧急旁路）
#   - 任何步骤失败：不回滚（commit 已落库），仅输出错误，不阻断 git

set -u  # 不开 -e：单步失败不阻断后续

REPO_ROOT="$(git rev-parse --show-toplevel)"
AE_SDD="$REPO_ROOT"

# ── 0. 旁路开关 ───────────────────────────────────────────────
if [ "${SKIP_AE_SDD_HOOK:-0}" = "1" ]; then
    echo "⏭️  ae-sdd post-commit: SKIP_AE_SDD_HOOK=1，跳过"
    exit 0
fi

# ── 1. 仅母版仓触发 ──────────────────────────────────────────
if [ ! -f "$AE_SDD/source/SKILL.md" ]; then
    exit 0
fi

# ── 2. 跳过 CHANGELOG-only / README-only 提交 ─────────────────
CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || echo "")
HAS_MEANINGFUL=$(echo "$CHANGED" | grep -vE '^(source/CHANGELOG/|README\.md$|\.githooks/)' || true)
if [ -z "$HAS_MEANINGFUL" ]; then
    exit 0
fi

echo "🔄 ae-sdd post-commit: 检测到功能性变更，启动分发闭环..."

# ── 3. 探测 Python ───────────────────────────────────────────
PYTHON=""
for cand in python python3 py; do
    if command -v "$cand" >/dev/null 2>&1; then
        PYTHON=$(command -v "$cand")
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "⚠️  ae-sdd post-commit: 找不到 python，跳过 build/install"
    exit 0
fi

# ── 4. build_dist ────────────────────────────────────────────
if [ -f "$AE_SDD/scripts/build_dist.py" ]; then
    if "$PYTHON" "$AE_SDD/scripts/build_dist.py" --quiet 2>&1 | tail -20; then
        echo "✅ build_dist: OK"
    else
        echo "⚠️  build_dist: 失败（commit 已落库，未回滚）"
    fi
else
    echo "⏭️  build_dist.py 不存在，跳过"
fi

# ── 5. install ───────────────────────────────────────────────
if [ -f "$AE_SDD/scripts/install.py" ]; then
    for target in "$HOME/.claude/skills/ae-sdd" "$HOME/.zcode/skills/ae-sdd"; do
        if "$PYTHON" "$AE_SDD/scripts/install.py" --quiet --target "$target" 2>&1 | tail -10; then
            echo "✅ install → $target: OK"
        else
            echo "⚠️  install → $target: 失败"
        fi
    done
else
    echo "⏭️  install.py 不存在，跳过"
fi

# ── 6. harness adapter ───────────────────────────────────────
ADAPTER="$HOME/.zcode/skills/ae-sdd-harness-adapter/scripts/convert-ae-sdd-to-harness.ps1"
if [ -f "$ADAPTER" ]; then
    if command -v powershell >/dev/null 2>&1; then
        if powershell -NoProfile -ExecutionPolicy Bypass -File "$ADAPTER" -Source "$AE_SDD" -DryRun:$false 2>&1 | tail -15; then
            echo "✅ harness adapter: OK"
        else
            echo "⚠️  harness adapter: 失败（agent.md 可能停留在旧版本）"
        fi
    elif command -v pwsh >/dev/null 2>&1; then
        if pwsh -NoProfile -File "$ADAPTER" -Source "$AE_SDD" -DryRun:$false 2>&1 | tail -15; then
            echo "✅ harness adapter: OK"
        else
            echo "⚠️  harness adapter: 失败"
        fi
    else
        echo "⏭️  powershell 未安装，跳过 harness adapter"
    fi
else
    echo "⏭️  ae-sdd-harness-adapter 未安装，跳过"
fi

# ── 7. mavis remount ─────────────────────────────────────────
MAVIS_CMD=""
if command -v mavis >/dev/null 2>&1; then
    MAVIS_CMD="mavis"
elif [ -x "$HOME/.mavis/bin/mavis.cmd" ]; then
    MAVIS_CMD="$HOME/.mavis/bin/mavis.cmd"
fi

if [ -n "$MAVIS_CMD" ] && [ -d "$AE_SDD/harness" ]; then
    "$MAVIS_CMD" harness unmount d-item-ae-sdd-harness >/dev/null 2>&1 || true
    if "$MAVIS_CMD" harness mount "$AE_SDD/harness" 2>&1 | tail -5; then
        echo "✅ mavis harness remount: OK"
    else
        echo "⚠️  mavis harness remount: 失败（产物已写入，需手动 mount）"
    fi
else
    echo "⏭️  mavis 未安装或 harness/ 不存在，跳过 remount"
fi

echo "✅ ae-sdd post-commit: 分发闭环结束"
exit 0