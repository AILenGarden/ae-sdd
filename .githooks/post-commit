#!/usr/bin/env bash
# ae-sdd Rust-only post-commit harness/build/distribution hook.
# A completed Git commit is never rolled back when the follow-up chain fails.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ] || [ ! -f "$REPO_ROOT/source/SKILL.md" ]; then
    exit 0
fi

if [ "${SKIP_AE_SDD_HOOK:-0}" = "1" ]; then
    echo "ae-sdd post-commit: skipped by SKIP_AE_SDD_HOOK=1"
    exit 0
fi

CHANGED="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || true)"
MEANINGFUL="$(printf '%s\n' "$CHANGED" | grep -vE '^(source/CHANGELOG/|README\.md$|\.githooks/)' || true)"
if [ -z "$MEANINGFUL" ]; then
    exit 0
fi

run_build_tool() {
    if [ -x "$REPO_ROOT/target/release/ae-sdd-build.exe" ]; then
        "$REPO_ROOT/target/release/ae-sdd-build.exe" "$@"
    elif [ -x "$REPO_ROOT/target/release/ae-sdd-build" ]; then
        "$REPO_ROOT/target/release/ae-sdd-build" "$@"
    elif command -v cargo >/dev/null 2>&1; then
        (cd "$REPO_ROOT" && cargo run -p ae-sdd-build --release -- "$@")
    else
        echo "ae-sdd post-commit: ae-sdd-build and cargo are unavailable" >&2
        return 127
    fi
}

COMMIT_ID="$(git rev-parse HEAD 2>/dev/null || true)"
if [ -z "$COMMIT_ID" ]; then
    echo "ae-sdd post-commit: HEAD could not be resolved; follow-up chain did not run" >&2
    exit 0
fi
USER_HOME="${HOME:-$REPO_ROOT}"
PACKAGE_DIR="$REPO_ROOT/dist/ae-sdd"

echo "ae-sdd post-commit: generating native harness"
HARNESS_OUTPUT="$(
    run_build_tool harness \
        --source "$REPO_ROOT/source/SKILL.md" \
        --source "$REPO_ROOT/source/HARNESS.md" \
        --target "$REPO_ROOT/.harness/agent.md" \
        --title "ae-sdd Agent Harness" \
        --allowed-root "$REPO_ROOT" 2>&1
)"
HARNESS_STATUS=$?
printf '%s\n' "$HARNESS_OUTPUT" | tail -30
if [ "$HARNESS_STATUS" -ne 0 ]; then
    echo "ae-sdd post-commit: native harness generation failed; commit remains intact" >&2
    exit 0
fi

echo "ae-sdd post-commit: compiling, verifying, and distributing native package"
POST_COMMIT_OUTPUT="$(
    run_build_tool post-commit \
        --repository-root "$REPO_ROOT" \
        --source "$REPO_ROOT/source" \
        --package "$PACKAGE_DIR" \
        --commit "$COMMIT_ID" \
        --allowed-root "$REPO_ROOT" \
        --allowed-root "$USER_HOME" \
        --target "$USER_HOME/.claude/skills/ae-sdd" \
        --target "$USER_HOME/.codex/skills/ae-sdd" \
        --target "$USER_HOME/.zcode/skills/ae-sdd" \
        --target "$USER_HOME/.harness/skills/ae-sdd" \
        --target "$USER_HOME/.hermes/skills/ae-sdd" 2>&1
)"
POST_COMMIT_STATUS=$?
printf '%s\n' "$POST_COMMIT_OUTPUT" | tail -30
if [ "$POST_COMMIT_STATUS" -ne 0 ]; then
    echo "ae-sdd post-commit: native compile/verify/distribution failed; commit remains intact" >&2
    exit 0
fi

echo "ae-sdd post-commit: native harness and distribution completed"
exit 0
