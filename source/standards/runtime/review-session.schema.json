{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ae-sdd.local/schema/review-session.v1.json",
  "title": "ae-sdd ReviewSession v1 wire shape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "workItemId",
    "tier",
    "requiredRoles",
    "inputFingerprint",
    "rulesetFingerprint",
    "round",
    "cleanStreak",
    "budget",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "reviewId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workItemId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "storyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tier": { "type": "integer", "minimum": 1, "maximum": 3 },
    "requiredRoles": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string" } },
    "inputFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rulesetFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "round": { "type": "integer", "minimum": 0 },
    "cleanStreak": { "type": "integer", "minimum": 0 },
    "budget": { "type": "object" },
    "status": { "enum": ["pending", "running", "changes_required", "passed", "invalid_infra", "stalled", "aborted"] }
  }
}
