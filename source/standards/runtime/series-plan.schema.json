{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ae-sdd.local/schema/series-plan.v1.json",
  "title": "ae-sdd SeriesPlan v1 wire shape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seriesId",
    "workItemId",
    "seriesKind",
    "role",
    "methodologyRef",
    "contextRef",
    "deliverableContract",
    "allowedOperations",
    "allowedPaths",
    "dependencyIds",
    "sourceRevision",
    "inputFingerprint",
    "deadlineUnixMs",
    "retryPolicy",
    "planDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "seriesId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workItemId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "storyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "seriesKind": { "type": "string", "minLength": 1, "maxLength": 64 },
    "role": { "const": "series" },
    "methodologyRef": { "type": "object" },
    "contextRef": { "type": "object" },
    "deliverableContract": { "type": "object" },
    "allowedOperations": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
    "allowedPaths": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "object" } },
    "dependencyIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
    "sourceRevision": { "type": "integer", "minimum": 0 },
    "inputFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deadlineUnixMs": { "type": "integer", "minimum": 1 },
    "retryPolicy": { "type": "object" },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
