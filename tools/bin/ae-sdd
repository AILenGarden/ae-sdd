    # init-hooks（写入 .claude/settings.json）
    p_ih = sub.add_parser("init-hooks", help="写入三个 hook 到 .claude/settings.json",
                           parents=[common])
    p_ih.add_argument("project_dir", nargs="?", default=".",
                      help="项目根目录（默认 cwd，--global 时忽略）")
    p_ih.add_argument("--force", action="store_true", help="覆写已有 hook")
    p_ih.add_argument("--dry-run", action="store_true", help="只打印，不写文件")
    p_ih.add_argument(
        "--use-python", dest="use_python", action="store_true",
        help=(
            "hook command 用绝对路径 python + 脚本路径，不依赖 PATH"
            "（Windows Claude Code hook 推荐）"
        ),
    )
    p_ih.add_argument(
        "--global", dest="global_hooks", action="store_true",
        help="写入 ~/.claude/settings.json（用户级，适合多项目统一配置）",
    )
    p_ih.set_defaults(func=cmd_init_hooks)

    # assets（🆕 ES 化索引：把 §G 自然语言协议变成可执行查询）
    # 对标 project-assets-update-skill §G：assets.query/search/outline/section/stats
    p_assets = sub.add_parser("assets", help="项目资产 ES 化索引查询", parents=[common])
    assets_sub = p_assets.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")

    p_assets_query = assets_sub.add_parser("query", help="给 key 返回倒排索引命中（BM25 排序）", parents=[common])
    p_assets_query.add_argument("query", help="查询关键词（支持 camelCase / 中文）")
    p_assets_query.add_argument("--top", type=int, default=20, help="返回 top-N（默认 20）")
    p_assets_query.add_argument("--project", default="", help="projectKey（默认从 .ae-sdd/config.yaml 读）")
    p_assets_query.add_argument("--asset-file", default="", help="直接指定资产文件路径（覆盖 --project 定位）")
    p_assets_query.set_defaults(func=cmd_assets_query)

    p_assets_outline = assets_sub.add_parser("outline", help="资产大纲（章节列表 + 索引统计）", parents=[common])
    p_assets_outline.add_argument("--project", default="", help="projectKey（默认从 .ae-sdd/config.yaml 读）")
    p_assets_outline.add_argument("--asset-file", default="", help="直接指定资产文件路径")
    p_assets_outline.set_defaults(func=cmd_assets_outline)

    p_assets_section = assets_sub.add_parser("section", help="取整章原文（如 §4 / §B）", parents=[common])
    p_assets_section.add_argument("name", help="章节名（如 4 / §4 / §B / §6.4）")
    p_assets_section.add_argument("--project", default="", help="projectKey（默认从 .ae-sdd/config.yaml 读）")
    p_assets_section.add_argument("--asset-file", default="", help="直接指定资产文件路径")
    p_assets_section.set_defaults(func=cmd_assets_section)

    p_assets_stats = assets_sub.add_parser("stats", help="索引统计（token/doc/章节/缓存状态）", parents=[common])
    p_assets_stats.add_argument("--project", default="", help="projectKey（默认从 .ae-sdd/config.yaml 读）")
    p_assets_stats.add_argument("--asset-file", default="", help="直接指定资产文件路径")
    p_assets_stats.set_defaults(func=cmd_assets_stats)

    # assets read — 资产 SKILL 核心入口（阶段→KEY 映射 + 初始化检查 + 脚本调度）
    # LLM 经资产 SKILL 读资产的统一入口：说阶段 + 可选追加 KEY，返回简约定位 v
    p_assets_read = assets_sub.add_parser("read", help="按阶段读取资产（映射表+BM25，返回简约定位）", parents=[common])
    p_assets_read.add_argument("stage", help="阶段名（requirement-analysis/dr-generate/story-generate/"
                                             "story-review/task-generate/coding/code-review/testcase）")
    p_assets_read.add_argument("--keys", default="", help="追加自定义 KEY（逗号分隔，精准查某类名/字段）")
    p_assets_read.add_argument("--project", default="", help="projectKey（默认从 .ae-sdd/config.yaml 读）")
    p_assets_read.add_argument("--asset-file", default="", help="直接指定资产文件路径")
    p_assets_read.set_defaults(func=cmd_assets_read)

    # health
    p_health = sub.add_parser("health", help="健康度自检", parents=[common])
    p_health.set_defaults(func=cmd_health)

    # bump（v3.2.5 — 同步三处版本号，UC-01 的操作侧）
    p_bump = sub.add_parser("bump", help="同步三处版本号（SKILL.md/paths.py/README.md）",
                            parents=[common])
    p_bump.add_argument("version", help="新版本号，如 3.2.5（不带 v 前缀）")
    p_bump.set_defaults(func=cmd_bump)

    # init（v3.2.5 — 项目实例化，挂载 scripts/init.py，补 UC-03 历史遗留）
    p_init = sub.add_parser("init", help="项目实例化（Layer 4，创建 .ae-sdd/ 骨架）",
                            parents=[common])
    p_init.add_argument("init_args", nargs=argparse.REMAINDER,
                        help="透传给 scripts/init.py 的参数：<project-dir> <project-key> [选项]")
    p_init.set_defaults(func=cmd_init)

    # enter（🆕 v3.4.0 — 入口凭证，建议书4 关卡1）
    p_enter = sub.add_parser("enter", help="领取入口凭证 entry token（关卡1，/ae-sdd 触发后第一动作）",
                             parents=[common])
    p_enter.add_argument("project_key", nargs="?", default="",
                         help="projectKey（缺省从 .ae-sdd/config.yaml 读）")
    p_enter.add_argument("--story", default="", help="Story ID（项目级 enter 可省略）")
    p_enter.set_defaults(func=cmd_enter)

    args = parser.parse_args()
    if not hasattr(args, "func"):
        parser.print_help()
        return 1
    try:
        return args.func(args, parser)
    except KeyboardInterrupt:
        output.err("用户中断")
        return 130


if __name__ == "__main__":
    sys.exit(main())
