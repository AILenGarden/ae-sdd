    p_classify.add_argument("--file", help="待判定的文件路径")
    p_classify.set_defaults(func=cmd_classify)

    # gate-intercept（PreToolUse hook 入口）
    p_gi = sub.add_parser("gate-intercept", help="PreToolUse hook 拦截器", parents=[common])
    p_gi.add_argument("--tool", help="工具名（Write / Edit / Bash / ...）")
    p_gi.add_argument("--bash-command", dest="bash_command", default="",
                      help="Bash 命令内容（仅 Bash 工具时有意义）")
    p_gi.add_argument("--file-path", dest="file_path", default="",
                      help="Write/Edit 的目标文件路径（路径感知检查用）")
    p_gi.add_argument("--context", default="",
                      help="用户最近消息（快速通道检测用）")
    p_gi.add_argument("--project", default="",
                      help="项目根目录（默认 cwd）")
    p_gi.add_argument("--no-readonly", action="store_true",
                      help="禁用只读工具放行（测试用）")
    p_gi.set_defaults(func=cmd_gate_intercept)

    # prompt-inject（UserPromptSubmit hook 入口）
    p_pi = sub.add_parser("prompt-inject", help="UserPromptSubmit hook：注入状态到 context",
                           parents=[common])
    p_pi.add_argument("--project", default="", help="项目根目录（默认 cwd）")
