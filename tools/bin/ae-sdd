    args = parser.parse_args()
    if not hasattr(args, "func"):
        parser.print_help()
        return 1
    runtime_stats.start_command(_runtime_command_name(args), argv=sys.argv[1:])
    try:
        rc = args.func(args, parser)
        return runtime_stats.finish_command(int(rc or 0))
    except KeyboardInterrupt:
        runtime_stats.finish_command(130, "KeyboardInterrupt")
        output.err("用户中断")
        return 130
    except Exception as e:
        runtime_stats.finish_command(1, e.__class__.__name__)
        raise


if __name__ == "__main__":
    sys.exit(main())
