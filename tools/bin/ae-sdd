def cmd_review_loop_verify_exit(args, parser):
    """review-loop verify-exit — 退出条件校验（gates G-REVIEW-LOOP 兜底用）。"""
    from lib import review_loop as rl_mod
    from lib import state as state_mod
    resolved = _resolve_state_path_or_error(args)
    if resolved is None:
        return 1
    ade_sdd, story_id, sp = resolved
    st = state_mod.read_state(sp)
    passed, reason = rl_mod.verify_exit(st.get("reviewLoop") or {})
    if args.json:
        output.emit({"passed": passed, "reason": reason}, as_json=True)
    else:
        mark = "✅" if passed else "❌"
        output.info(f"{mark} review-loop verify-exit: {reason}")
    return 0 if passed else 1


def cmd_review_abort(args, parser):
    """review abort -- mark a session stalled/cancelled without pretending success."""
    from lib import state as state_mod
    resolved = _resolve_state_path_or_error(args)
    if resolved is None:
        return 1
    _ade_sdd, _story_id, sp = resolved
    st = state_mod.read_state(sp)
    session_state = st.get("reviewSession") or st.get("reviewLoop") or {}
    reason = args.reason or "user-abort"
    session_state["exit"] = {"reason": "stalled" if reason == "budget-exhausted" else "cancelled", "abortReason": reason}
    session_state["exitReason"] = session_state["exit"]["reason"]
    session_state["exitedAt"] = review_batch._iso()
    st["reviewLoop"] = session_state
    st["reviewSession"] = session_state
    state_mod.write_state(sp, st)
    payload = {"exitReason": session_state["exit"]["reason"], "abortReason": reason}
    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.info(f"review aborted: {payload['exitReason']} ({reason})")
    return 0


def cmd_review_retry_role(args, parser):
    payload = {"action": "retry-role", "role": args.role, "reason": args.reason or "platform-failure"}
    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.info(f"retry only reviewer role: {args.role} ({payload['reason']})")
    return 0


# ─── 🆕 v3.8.0 自动化开关 / 预收集 / 联审共识 ────────────────────────────────
def cmd_automation_status(args, parser):
    """automation status — 读自动化配置。"""
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/，请先 ae-sdd init")
        return 1
    cfg = config.load_automation_config(ade_sdd)
    if args.json:
        output.emit(cfg, as_json=True)
    else:
        mark = "🟢 已启用" if cfg["enabled"] else "⚪ 未启用（默认）"
        output.info(f"自动化模式：{mark}")
        output.info(f"  reviewerTier: {cfg['reviewerTier']}")
        output.info(f"  preflightInfoCollection: {cfg['preflightInfoCollection']}")
        output.info(f"  onConsensusStall: {cfg['onConsensusStall']}")
        output.info(f"  automatedReviewPoints: {cfg['automatedReviewPoints']}")
        if cfg["enabledAt"]:
            output.info(f"  enabledAt: {cfg['enabledAt']}")
    return 0


def _write_automation_config(ade_sdd: Path, cfg: dict) -> None:
    """把 automation 段写回 .ae-sdd/config.yaml（保留其余段落，仅替换 automation 段）。

    简易实现：读原文 → 删除已有 automation 段 → 末尾追加新段。
    config.yaml 是人工可读 YAML，此写法足够（init.py 生成的格式稳定）。
    """
    cfg_path = ade_sdd / "config.yaml"
    text = cfg_path.read_text(encoding="utf-8") if cfg_path.is_file() else ""
    # 删除已有 automation 段（从 "automation:" 行到下一个顶级 key 前或文件末）
    lines = text.splitlines()
    out, in_auto, i = [], False, 0
    while i < len(lines):
        ln = lines[i]
        if ln.startswith("automation:"):
            in_auto = True
            i += 1
            # 跳过后续缩进行
            while i < len(lines) and (lines[i].startswith(" ") or lines[i].startswith("\t")
                                      or not lines[i].strip()):
                # 但停在下一个顶级 key
                if lines[i] and not lines[i][0].isspace() and ":" in lines[i]:
                    break
                i += 1
            continue
        out.append(ln)
        i += 1
    # 追加新段
    pts = ", ".join(str(p) for p in cfg["automatedReviewPoints"])
    out.append("")
    out.append("# 🆕 v3.8.0 自动化开关（ae-sdd automation enable/disable 维护）")
    out.append("automation:")
    out.append(f"  enabled: {'true' if cfg['enabled'] else 'false'}")
    out.append(f"  reviewerTier: {cfg['reviewerTier']}")
    out.append(f"  preflightInfoCollection: {'true' if cfg['preflightInfoCollection'] else 'false'}")
    out.append(f"  onConsensusStall: {cfg['onConsensusStall']}")
    out.append(f"  automatedReviewPoints: [{pts}]")
    out.append(f'  enabledAt: "{cfg["enabledAt"]}"')
    cfg_path.write_text("\n".join(out) + "\n", encoding="utf-8")


def cmd_automation_enable(args, parser):
    """automation enable — 开启全自动化（写 config.yaml，记 enabledAt）。"""
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/，请先 ae-sdd init")
        return 1
    cfg = config.load_automation_config(ade_sdd)
    if cfg["enabled"]:
        output.info("自动化模式已启用，无需重复操作")
        return 0
    cfg["enabled"] = True
    cfg["enabledAt"] = _now_iso()
    _write_automation_config(ade_sdd, cfg)
    output.ok("🟢 自动化模式已启用")
    output.info(f"  审核点将走 Tier {cfg['reviewerTier']} 联审共识，跳过人工✅")
    output.info(f"  开工前信息预收集：{'开' if cfg['preflightInfoCollection'] else '关'}")
    output.info(f"  阻断出口：{cfg['onConsensusStall']}")
    return 0


def cmd_automation_disable(args, parser):
    """automation disable — 关闭自动化（保留 enabledAt 审计痕迹）。"""
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/，请先 ae-sdd init")
        return 1
    cfg = config.load_automation_config(ade_sdd)
    if not cfg["enabled"]:
        output.info("自动化模式未启用，无需操作")
        return 0
    cfg["enabled"] = False
    _write_automation_config(ade_sdd, cfg)
    output.ok("⚪ 自动化模式已关闭（回退人工审核）")
    return 0


def cmd_preflight_collect(args, parser):
    """preflight collect — 开工前信息预收集（扫输入材料+资产，列待补信息清单）。

    机器粗筛 6 类待补信息：
      1. 第三方平台凭证（极光/融云/Key/Secret/AppKey 等占位词）
      2. 复用项选择（{待确认}/{待复用} 占位）
      3. 环境配置（DB/Redis/MQ 地址占位）
      4. 命名约定
      5. 已有对接方信息
      6. 数据初始化要求
    """
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/，请先 ae-sdd init")
        return 1
    import re

    # 扫描范围：DR/PRD/Story/RA 文档 + 项目资产
    scan_dirs = [ade_sdd / "assets", ade_sdd.parent / "design"]
    # 也扫可能的产物目录
    for d in [ade_sdd.parent / "docs", ade_sdd.parent / "ae-sdd"]:
        if d.is_dir():
            scan_dirs.append(d)

    patterns = {
        "第三方平台凭证": re.compile(
            r"(极光|融云|AppKey|AppSecret|access[_-]?key|secret[_-]?key|api[_-]?key)", re.I),
        "复用项选择": re.compile(r"(\{待确认\}|\{待复用\}|\{TODO\}|待确认|待复用)"),
        "环境配置": re.compile(r"(数据库地址|redis地址|mq地址|\{db_host\}|\{redis_host\})", re.I),
        "命名约定": re.compile(r"(\{命名待定\}|命名待定|服务名待定)"),
        "对接方信息": re.compile(r"(对接方|联调方|\{对接方待补\})"),
        "数据初始化": re.compile(r"(初始化数据|种子数据|\{初始化待补\})"),
    }
    findings: dict[str, list[str]] = {k: [] for k in patterns}
    scanned = 0
    for d in scan_dirs:
        if not d.is_dir():
            continue
        for md in d.rglob("*.md"):
            try:
                content = md.read_text(encoding="utf-8")
            except Exception:
                continue
            scanned += 1
            for cat, pat in patterns.items():
                for m in pat.finditer(content):
                    snippet = content[max(0, m.start() - 20):m.end() + 20].replace("\n", " ")
                    findings[cat].append(f"{md.relative_to(ade_sdd.parent)}: …{snippet}…")

    # 输出清单
    total = sum(len(v) for v in findings.values())
    pf_path = ade_sdd / "preflight-info.yaml"
    if args.json:
        output.emit({"scanned": scanned, "totalFindings": total, "findings": findings},
                    as_json=True)
    else:
        output.info(f"🔍 开工前信息预收集（扫描 {scanned} 个文档）")
        if total == 0:
            output.ok("✅ 无待补信息，可直接开工")
        else:
            output.info(f"📋 待补信息清单（共 {total} 项，请一次性补齐）：")
            for cat, items in findings.items():
                if not items:
                    continue
                output.info(f"  【{cat}】({len(items)} 项)")
                for it in items[:5]:
                    output.info(f"    - {it}")
                if len(items) > 5:
                    output.info(f"    ... 另有 {len(items) - 5} 项")
        output.info(f"  清单已写入 {pf_path}")

    # 写 preflight-info.yaml（占位，待用户补齐）
    lines = ["# ae-sdd 开工前信息预收集清单（🆕 v3.8.0，由 ae-sdd preflight collect 生成）",
             f"# 生成时间: {_now_iso()}",
             f"# 扫描文档数: {scanned}",
             f"# 待补项总数: {total}", ""]
    for cat, items in findings.items():
        lines.append(f"{cat}:")
        if not items:
            lines.append("  - （未识别到待补项，用户可手工补充）")
        else:
            for it in items:
                lines.append(f"  - {it}")
        lines.append("")
    pf_path.write_text("\n".join(lines), encoding="utf-8")
    return 0


def cmd_state_register_review_consensus(args, parser):
    """state register-review-consensus — 写联审共识结果到 state.reviewConsensus[point]。"""
    from lib import state as state_mod
    resolved = _resolve_state_path_or_error(args)
    if resolved is None:
        return 1
    ade_sdd, story_id, sp = resolved
    st = state_mod.read_state(sp)
    reviewers = []
    if args.reviewers:
        # 格式 agentId|role|verdict|sessionId，逗号分隔多条
        for tok in args.reviewers.split(","):
            parts = tok.strip().split("|")
            if len(parts) >= 4:
                reviewers.append({"agentId": parts[0], "role": parts[1],
                                  "verdict": parts[2], "sessionId": parts[3]})
            elif len(parts) >= 1:
                reviewers.append({"agentId": parts[0]})
    # args.passed 是字符串 "true"/"false"（choices），转 bool
    passed_bool = (args.passed == "true")
    state_mod.register_review_consensus(
        st, point=args.point, tier=args.tier, passed=passed_bool,
        rounds=args.rounds, reviewers=reviewers, stall_reason=args.stall_reason)
    state_mod.write_state(sp, st)
    mark = "✅" if passed_bool else "❌"
    output.ok(f"{mark} 已写联审共识：审核点 {args.point} Tier {args.tier} "
              f"passed={args.passed} rounds={args.rounds}")
    return 0


def cmd_state_lock(args, parser):
    """state lock — 🆕 v3.8.1 S-3 获取文件意图锁（防多 agent 并发写同一产物）。

    用法：ae-sdd state lock --path <相对路径> --agent <agentId> [--ttl 1800]
    冲突时退出码 1 并输出持锁方信息（供 agent 协调后重试）。
    """
    from lib import state as state_mod
    resolved = _resolve_state_path_or_error(args)
    if resolved is None:
        return 1
    ade_sdd, story_id, sp = resolved
    st = state_mod.read_state(sp)
    ok, reason = state_mod.acquire_file_lock(st, args.path, args.agent, args.ttl)
    if not ok:
        output.err(f"❌ 获取文件锁失败：{reason}")
        return 1
    state_mod.write_state(sp, st)
    output.ok(f"✅ 已获文件锁：path={args.path} agent={args.agent} ttl={args.ttl}s")
    return 0


def cmd_state_unlock(args, parser):
    """state unlock — 🆕 v3.8.1 S-3 释放文件意图锁（仅持锁者能释放）。

    用法：ae-sdd state unlock --path <相对路径> --agent <agentId>
    """
    from lib import state as state_mod
    resolved = _resolve_state_path_or_error(args)
    if resolved is None:
        return 1
    ade_sdd, story_id, sp = resolved
    st = state_mod.read_state(sp)
    released = state_mod.release_file_lock(st, args.path, args.agent)
    if not released:
        output.warn(f"⚠️ 未释放（path={args.path} 非 agent {args.agent} 持锁，或锁不存在）")
        return 0
    state_mod.write_state(sp, st)
    output.ok(f"✅ 已释放文件锁：path={args.path} agent={args.agent}")
    return 0


def _now_iso() -> str:
    from datetime import datetime, timezone
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_bump(args, parser):
    """bump — 同步三处版本号（SKILL.md / paths.py / README.md:5）

    v3.2.5：UC-01 只校验不操作，本命令补"操作侧"——自动写入三处版本号
    并立即跑 UC-01 校验一致性。README.md:5 括号内的"最新变更"说明需维护者另行更新。

    用法：ae-sdd bump 3.2.5
    """
    repo_root = Path(__file__).resolve().parent.parent.parent
    new_version = args.version

    try:
        result = update_graph.bump_version(repo_root, new_version)
    except ValueError as e:
        output.err(f"bump 失败：{e}")
        return 1

    if args.json:
        output.emit(result, as_json=True)
        return 0

    if result.get("skipped"):
        output.info(f"ℹ️  版本号未变化（{result['new']}），跳过写入。")
        return 0

    output.ok(f"版本号 {result['old']} → {result['new']}，已同步 {len(result['written'])} 处：")
    for f in result["written"]:
        output.info(f"  • {f}")
    if result["verified"]:
        output.ok("UC-01 校验通过：三处版本号一致。")
    else:
        output.err("UC-01 校验失败，需人工核对。")
        return 1
    output.info("⚠️  README.md:5 括号内的「最新变更」说明需手动更新（bump 只同步版本号）。")
    return 0


def cmd_init(args, parser):
    """init — 项目实例化（Layer 4，挂载 scripts/init.py 到 CLI）

    v3.2.5：init.py 实现已就绪但未挂 CLI（UC-03 历史遗留 warn），本次补注册。
    通过 subprocess 调 scripts/init.py，透传全部参数（对齐 init.py 的 argparse 定义）。

    用法：ae-sdd init <project-dir> <project-key> [init.py 选项]
    """
    import subprocess

    repo_root = Path(__file__).resolve().parent.parent.parent
    init_script = repo_root / "scripts" / "init.py"

    if not init_script.is_file():
        output.err(f"init 脚本不存在：{init_script}")
        return 1

    # 透传 init.py 自身的 argparse（project_dir / project_key 位置参数 + 选项）
    # 用 args.argv 收集 init 之后的所有原始参数，交给 init.py 解析
    init_args = args.init_args if hasattr(args, "init_args") else []
    cmd = [sys.executable, str(init_script), *init_args]

    # 校验必填位置参数（init.py 要求 project_dir + project_key）
    if len(init_args) < 2:
        output.err("init 需要 2 个位置参数：<project-dir> <project-key>")
        output.info("  用法：ae-sdd init <project-dir> <project-key> [选项]")
        output.info("  示例：ae-sdd init D:/Item/my-project my-project")
        output.info("  完整选项见：python scripts/init.py --help")
        return 1

    try:
        result = runtime_exec.run_command(
            cmd,
            capture_output=False,
            text=False,
            span_name="script:init",
        )
        return result.returncode
    except OSError as e:
        output.err(f"调用 init.py 失败：{e}")
        return 1


def cmd_enter(args, parser):
    """🆕 v3.9.3 enter — 入口凭证（关卡1），走 R6 顶层名空间。

    BREAKING v3.9.3：废除 --story 裸传；必须传 --work-item (R6 顶层名) 或 --id 派生顶层名。
    落盘路径：{project_root}/.auto-engineering/{R6 顶层名}/session.json
    """
    from lib import session as session_mod
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    cfg = paths.read_config(ade_sdd)
    project_key = args.project_key or cfg.get("projectKey", "")
    if not project_key:
        output.err("未提供 projectKey，且 .ae-sdd/config.yaml 无 projectKey")
        return 1

    # 解析顶层节点 + features
    work_item_token = (getattr(args, "work_item", "") or getattr(args, "story", "") or "").strip()
    top_node, features = _resolve_top_node_from_token(ade_sdd, work_item_token, args)
    if not top_node:
        output.err("未提供 work item（请传 --work-item <R6 顶层名> 或 --story <STORY-ID>）")
        output.info("提示：先跑 `ae-sdd state new --id <ID> --entry-node <PRD|DR|STORY>` 创建 state")
        return 1

    s = session_mod.enter(project_key, top_node=top_node, features=features, ade_sdd=ade_sdd)
    if args.json:
        output.emit(s, as_json=True)
        return 0
    output.ok(f"✅ 入口凭证已领取（sessionId={s['sessionId']}）")
    output.info(f"   projectKey:   {s['projectKey']}")
    output.info(f"   workItemKey:  {s.get('workItemKey', '')}")
    output.info(f"   topNode:      {s.get('topNode', '')}")
    output.info(f"   写入: {session_mod.session_path(ade_sdd, top_node, features)}")
    output.info("   关卡2/3 将校验此凭证；未领凭证的流程产物落地/代码改动将被拦截。")
    return 0


def _resolve_top_node_from_token(ade_sdd: Path, token: str, args) -> tuple[str, dict]:
    """🆕 v3.9.3 内部辅助：从 token（work-item / story ID）反推 (top_node, features)。
    🆕 v3.10.2 补齐 BUG/PLAN 顶层分支：此前只认 PRD/DR/Story/Task 四种前缀，
    微任务（BUG-xxx）/小任务（PLAN-xxx）token 一律解析失败，导致
    `ae-sdd enter --work-item BUG-xxx` 报"未提供 work item"——即便 `state new`
    已用同类 token 建出了 Bug-/Plan- 顶层 state（build_state_machine_name 早支持）。
    同时先剥离可能的 UUID 前缀（完整目录名场景），保证前缀判断不受影响。

    优先级：
      1. token 是 R6 顶层名（如 Story-003 / DR-CS / Bug-BUG-LIFE-001 / Plan-xxx，
         可带 UUID 前缀）→ 直接用
      2. token 是 Story/DR/PRD ID（STORY-006-BE）→ 反查所属嵌套 state，找不到则对应顶层
      3. token 是 BUG/OPT/CONFIG/PLAN 微任务/小任务 raw ID → 对应 BUG/PLAN 顶层
      4. args.top_node / args.entry_node 显式传 → 用之
      5. 都无 → 读 active mirror
    """
    if token:
        token = paths.strip_uuid_prefix(token)
    if not token:
        # 尝试从 active mirror
        active = None
        if active is not None:
            sp, _ = active
            try:
                data = json.loads(sp.read_text(encoding="utf-8"))
                top_node = data.get("entryNode", "STORY")
                # 🆕 v3.10.1：优先用 stateMachineName（纯业务名），缺失则 strip_uuid_prefix
                # 后再 replace，避免 sm_id 带 UUID 前缀时 replace 错切
                sm_id = data.get("stateMachineName") or paths.strip_uuid_prefix(
                    data.get("stateMachineId", sp.parent.name))
                if top_node == "PRD":
                    return (top_node, {"prd_feature": sm_id.replace("PRD-", "", 1)})
                if top_node == "DR":
                    return (top_node, {"dr_feature": sm_id.replace("DR-", "", 1)})
                if top_node == "STORY":
                    story_ids = data.get("storyIds") or list((data.get("storyStates") or {}).keys()) or [sm_id]
                    return (top_node, {"story_ids": story_ids})
            except Exception:
                pass
        return ("", {})

    # token 是 R6 顶层名？
    if token.startswith("PRD-"):
        return ("PRD", {"prd_feature": token.replace("PRD-", "", 1)})
    if token.startswith("DR-"):
        return ("DR", {"dr_feature": token.replace("DR-", "", 1)})
    if token.startswith("Story-"):
        return ("STORY", {"story_ids": [token]})
    if token.startswith("Task-"):
        return ("TASK", {"task_id": token.replace("Task-", "", 1)})
    if token.startswith("Bug-"):
        return ("BUG", {"task_id": token.replace("Bug-", "", 1)})
    if token.startswith("Plan-"):
        return ("PLAN", {"plan_id": token.replace("Plan-", "", 1)})

    # token 是 Story/DR/PRD ID
    upper = token.upper()
    if upper.startswith(("BUG-", "OPT-", "CONFIG-")):
        # 微任务无文档：raw ID 本身即 task_id，顶层统一走 BUG（复用扁平 state，
        # 与 cmd_state_new 的 requested_entry_node in ("BUG","OPT","CONFIG") 分支一致）
        return ("BUG", {"task_id": upper})
    if upper.startswith("PLAN-"):
        return ("PLAN", {"plan_id": upper})
    if upper.startswith("STORY-"):
        # 反查所属 state
        hit = paths.find_nested_state_by_story_id(ade_sdd, upper)
        if hit:
            sp, data = hit  # noqa: F841 - sp/data 保留供调试；features 用 upper
            return ("STORY", {"story_ids": [upper]})
        return ("STORY", {"story_ids": [upper]})
    if upper.startswith("DR-"):
        hit = paths.find_nested_state_by_dr_id(ade_sdd, upper)
        if hit:
            return ("DR", {"dr_feature": upper.replace("DR-", "", 1)})
        return ("DR", {"dr_feature": upper.replace("DR-", "", 1)})
    if upper.startswith("PRD-"):
        hit = paths.find_nested_state_by_prd_id(ade_sdd, upper)
        if hit:
            return ("PRD", {"prd_feature": upper.replace("PRD-", "", 1)})
        return ("PRD", {"prd_feature": upper.replace("PRD-", "", 1)})

    return ("", {})


# === 🆕 v3.5.1 plugin CLI（plugin_loader 用户入口） ===

def cmd_plugin_list(args, parser):
    """plugin list — 列出三层注册表所有已注册插件 + 冲突检测

    🆕 v3.5.1：CLI 挂载，闭环 plugin_loader.py 的用户入口。
    """
    ade_sdd = paths.locate_project_ae_sdd()
    master = paths.locate_master_source()
    result = plugin_loader.list_plugins(ade_sdd, master)
    if args.json:
        output.emit(result, as_json=True)
        return 0

    # 格式化输出：按层分组
    for rl in result["layers"]:
        label = rl["layerLabel"]
        exists = rl["exists"]
        if not exists:
            output.info(f"  ⊘ {label}: 注册表不存在（跳过）")
            continue
        n = len(rl["plugins"])
        if n == 0:
            output.info(f"  ∅ {label} ({rl['registryPath']}): 0 个插件")
            continue
        output.info(f"  📁 {label} ({rl['registryPath']}): {n} 个插件")
        for p in rl["plugins"]:
            kind = "覆盖" if p.get("replaces") else "新增"
            target = p.get("replaces") or p.get("provides")
            output.info(f"     ✅ {p['name']} v{p['version']} → {kind} {target}")

    if result["totalConflicts"] > 0:
        output.info("")
        output.warn(f"  ⚠️  {result['totalConflicts']} 个多层冲突（按 L1 > L2 > L3 优先级选胜者）：")
        for c in result["conflicts"]:
            losers = ", ".join(f"{l['name']}({l['layer']})" for l in c["losers"])
            output.info(f"     - target '{c['target']}': {c['winner']}({c['winnerLayer']}) 胜出 vs [{losers}]")

    output.info("")
    output.ok(f"共 {result['totalPlugins']} 个插件，{result['totalConflicts']} 个冲突")
    return 0


def cmd_plugin_validate(args, parser):
    """plugin validate — 校验三层注册表 + 每个 plugin sanity check

    🆕 v3.5.1：CLI 挂载，跑 plugin_loader.validate()。
    """
    ade_sdd = paths.locate_project_ae_sdd()
    master = paths.locate_master_source()
    result = plugin_loader.validate(ade_sdd, master)
    if args.json:
        output.emit(result, as_json=True)
        return 0 if result["valid"] else 1

    # 错误（必输出）
    for e in result["errors"]:
        output.err(f"  ❌ {e}")
    # 警告（不阻断）
    for w in result["warnings"]:
        output.warn(f"  ⚠ {w}")

    output.info("")
    if result["valid"]:
        output.ok(f"✅ 三层注册表校验通过：{result['totalPlugins']} 个插件，{result['totalConflicts']} 个冲突（warn）")
        return 0
    else:
        output.err(f"❌ 三层注册表校验未通过：{len(result['errors'])} 个错误，{len(result['warnings'])} 个警告")
        output.info("   修复 errors 后重跑 `ae-sdd plugin validate`")
        return 1


def cmd_plugin_trace(args, parser):
    """plugin trace <target> — 查某 SKILL 的加载路径 + 命中层 + 冲突告警

    🆕 v3.5.1：CLI 挂载，跑 plugin_loader.resolve_skill()。
    target 可以是：replaces 内置路径（如 source/skills/phase2-coding/coding-skill.md）
                 或 provides key（如 finance-coding-skill）。
    """
    target = args.target
    if not target:
        output.err("必须提供 <target>（replaces 内置路径或 provides key）")
        return 1

    ade_sdd = paths.locate_project_ae_sdd()
    master = paths.locate_master_source()
    result = plugin_loader.resolve_skill(target, ade_sdd, master)

    if args.json:
        output.emit(result.to_dict(), as_json=True)
        return 0

    output.info(f"🔍 trace: {target}")
    if result.plugin:
        p = result.plugin
        output.ok(f"  命中 {result.layer_label}: {p.name} v{p.version}")
        output.info(f"  resolved: {result.resolved_path}")
    else:
        output.info(f"  fallback 到 {result.layer_label}（行为与 v3.4.x 一致）")

    if result.conflicts:
        output.info("")
        for c in result.conflicts:
            losers = ", ".join(f"{p.name}({p.layer_label})" for p in c.losers)
            output.warn(f"  ⚠ 多层冲突：{c.winner.name}({c.winner.layer_label}) 胜出 vs [{losers}]")

    for w in result.warnings:
        output.info(f"  ℹ️  {w}")
    return 0


def cmd_plugin_init(args, parser):
    """plugin init --layer {project|global} — 从模板生成新注册表

    🆕 v3.5.1：CLI 挂载，从 source/templates/project-assets/plugin-registry-template.yaml
    拷贝到目标位置（项目层 = <project>/.ae-sdd/plugins/registry.yaml，
                  全局层 = ~/.ae-sdd/plugins/registry.yaml）。
    """
    layer = args.layer
    repo_root = Path(__file__).resolve().parent.parent.parent
    template = repo_root / "source" / "templates" / "project-assets" / "plugin-registry-template.yaml"

    if not template.is_file():
        output.err(f"模板不存在: {template}")
        return 1

    if layer == "project":
        ade_sdd = paths.locate_project_ae_sdd()
        if ade_sdd is None:
            output.err("未找到 .ae-sdd/ 目录（请先跑 `ae-sdd init <project-dir> <project-key>`）")
            return 1
        target = ade_sdd / "plugins" / "registry.yaml"
        scope = "L1 项目层"
    elif layer == "global":
        target = Path.home() / ".ae-sdd" / "plugins" / "registry.yaml"
        scope = "L2 用户全局层"
    else:
        output.err(f"未知 layer: {layer}（仅支持 project / global）")
        return 1

    if target.exists() and not args.force:
        output.warn(f"已存在: {target}")
        output.info("   加 --force 覆盖")
        return 1

    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(template.read_text(encoding="utf-8"), encoding="utf-8")
    output.ok(f"✅ 已生成 ({scope}): {target}")
    output.info("")
    output.info("下一步：")
    output.info("  1. 编辑这个文件，在 plugins 列表下添加你的插件")
    output.info("  2. 在 path 指向的位置写你的 SKILL 文档")
    output.info("  3. 跑 `ae-sdd plugin validate` 校验")
    output.info("  4. 跑 `ae-sdd plugin trace <replaces 路径>` 验证加载路径")
    return 0


def cmd_state_confirm(args, parser):
    """state confirm — 审核点 token（🆕 v3.4.0，建议书3 B2-1~5）

    用户确认某人工审核点后落 token 到 session.json 的 userConfirmedPhases。
    防止 AI 自填：此命令由用户触发（AI 不得自行调用伪造确认）。
    """
    from lib import session as session_mod
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init + ae-sdd enter）")
        return 1
    # 🆕 v3.9.3 用 (top_node, features) 取代 raw story_id
    work_item_token = (getattr(args, "work_item", "") or getattr(args, "story", "") or "").strip()
    top_node, features = _resolve_top_node_from_token(ade_sdd, work_item_token, args)
    if not top_node:
        output.err("未提供 work item（请传 --work-item <R6 顶层名> 或 --story <STORY-ID>）")
        return 1
    # 校验 entry token 存在
    if not session_mod.has_valid_entry_token(ade_sdd, top_node=top_node, features=features):
        output.err("未找到有效 entry token，请先跑 ae-sdd enter")
        return 1
    phase = args.phase
    confirmed_by = args.by or "user"
    s = session_mod.confirm_phase(ade_sdd, phase, confirmed_by=confirmed_by,
                                  top_node=top_node, features=features)
    if args.json:
        output.emit(s, as_json=True)
        return 0
    output.ok(f"✅ 审核点 token 已记录：phase={phase}（by {confirmed_by}）")
    output.info(f"   已确认阶段: {[c['phase'] for c in s.get('userConfirmedPhases', [])]}")
    return 0


def _memory_scope_from_args(args):
    """🆕 v3.10.3: 从 --entity-type/--entity-id 构造 scope（过渡期兼容旧 --phase/--story/--task）。"""
    entity_type = getattr(args, "entity_type", "") or ""
    entity_id = getattr(args, "entity_id", "") or ""
    # 过渡期：旧 --phase/--story/--task 参数兼容
    phase = getattr(args, "phase", "") or ""
    story = getattr(args, "story", "") or ""
    task = getattr(args, "task", "") or ""
    return memory_store.locate_scope(
        project=getattr(args, "project", "") or None,
        entity_type=entity_type,
        entity_id=entity_id,
        phase=phase or None,
        story=story or None,
        task=task or None,
    )


def cmd_memory_create(args, parser):
    """🆕 v3.10.3: 读源上下文 -> 编译 compact -> 写 memory。"""
    try:
        scope = _memory_scope_from_args(args)
        # 从 --sources 读取源上下文文件内容
        source_contexts: dict[str, str] = {}
        for src_arg in (args.sources or []):
            if "=" in src_arg:
                name, path = src_arg.split("=", 1)
                from pathlib import Path as _P
                p = _P(path)
                if p.is_file():
                    source_contexts[name] = p.read_text(encoding="utf-8")
            elif src_arg:
                source_contexts[src_arg] = ""
        # 从 --context-json 读取结构化上下文（可选）
        context_data = {}
        if args.context_json:
            import json as _json
            context_data = _json.loads(args.context_json)
        result = memory_store.create_memory(
            scope,
            source_contexts=source_contexts,
            series_chain=context_data.get("series_chain", []),
            current_series=context_data.get("current_series", ""),
            next_step=context_data.get("next_step", ""),
            deliverables=context_data.get("deliverables", []),
            dr_anchors=context_data.get("dr_anchors", []),
            story_acs=context_data.get("story_acs", []),
            constraints=context_data.get("constraints", []),
            api_contracts=context_data.get("api_contracts", []),
            data_models=context_data.get("data_models", []),
            asset_refs=context_data.get("asset_refs", []),
            pending_items=context_data.get("pending_items", []),
            failure_history=context_data.get("failure_history", []),
            correction_counts=context_data.get("correction_counts", {}),
            review_loop_status=context_data.get("review_loop_status", ""),
        )
    except Exception as e:
        output.err(str(e))
        return 1
    output.emit(result, as_json=args.json)
    return 0


