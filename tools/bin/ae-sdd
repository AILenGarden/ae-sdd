    p_mem_promote.add_argument("--from-layer", default="L1", help="source layer")
    p_mem_promote.add_argument("--to-layer", default="L2", help="target layer")
    p_mem_promote.set_defaults(func=cmd_memory_promote)

    p_mem_sum = mem_sub.add_parser("summarize", help="summarize memory store", parents=[common])
    _memory_common(p_mem_sum)
    p_mem_sum.set_defaults(func=cmd_memory_summarize)

    # db toolset (P0): local-profile, read-first database access
    p_db = sub.add_parser("db", help="database toolset", parents=[common])
    db_sub = p_db.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_db_profiles = db_sub.add_parser("profiles", help="list or init local DB profiles", parents=[common])
    p_db_profiles.add_argument("--project", default="", help="project root (default cwd)")
    p_db_profiles.add_argument("--init", action="store_true", help="create local profile template")
    p_db_profiles.set_defaults(func=cmd_db_profiles)

    p_db_query = db_sub.add_parser("query", help="run SQL through a local profile", parents=[common])
    p_db_query.add_argument("--project", default="", help="project root (default cwd)")
    p_db_query.add_argument("--profile", required=True, help="profile name")
    p_db_query.add_argument("--sql", default="", help="SQL text")
    p_db_query.add_argument("--sql-file", default="", help="SQL file")
    p_db_query.add_argument("--write", action="store_true", help="allow write SQL")
    p_db_query.add_argument("--limit", type=int, default=100, help="max returned rows")
    p_db_query.set_defaults(func=cmd_db_query)

    p_db_explain = db_sub.add_parser("explain", help="run EXPLAIN through a local profile", parents=[common])
    p_db_explain.add_argument("--project", default="", help="project root (default cwd)")
    p_db_explain.add_argument("--profile", required=True, help="profile name")
    p_db_explain.add_argument("--sql", default="", help="SQL text")
    p_db_explain.add_argument("--sql-file", default="", help="SQL file")
    p_db_explain.add_argument("--limit", type=int, default=100, help="max returned rows")
    p_db_explain.set_defaults(func=cmd_db_explain)

    p_db_audit = db_sub.add_parser("audit", help="audit DB profile policy", parents=[common])
    p_db_audit.add_argument("--project", default="", help="project root (default cwd)")
    p_db_audit.set_defaults(func=cmd_db_audit)

    # git toolset (P0): read-only repository evidence
    p_git = sub.add_parser("git", help="read-only git insight toolset", parents=[common])
    git_sub = p_git.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_git_status = git_sub.add_parser("status", help="structured git status", parents=[common])
    p_git_status.add_argument("--project", default="", help="project root (default cwd)")
    p_git_status.set_defaults(func=cmd_git_status)

    p_git_diff = git_sub.add_parser("diff", help="structured git diff", parents=[common])
    p_git_diff.add_argument("--project", default="", help="project root (default cwd)")
    p_git_diff.add_argument("--base", default="", help="base ref")
    p_git_diff.add_argument("--head", default="", help="head ref")
    p_git_diff.add_argument("--stat", action="store_true", help="show stat only")
    p_git_diff.set_defaults(func=cmd_git_diff)

    p_git_log = git_sub.add_parser("log", help="structured git log", parents=[common])
    p_git_log.add_argument("--project", default="", help="project root (default cwd)")
