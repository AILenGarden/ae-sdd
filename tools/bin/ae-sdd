#!/usr/bin/env python3
"""
ae-sdd — ae-sdd CLI 入口

🆕 v3.0 P0 三件套（2026-06-18）：
  - state    : 项目状态管理（read / write / next-step）
  - gates    : 门禁检查（pre-flight；v3.8.0 共 30 门禁：G-00~14 + G-09B + G-CODEPLAN-SRC +
               G-DOC-STORAGE + G-DOC-CONSISTENCY + G-PATH + G-RA-1~6 + G-RA-FLOW-VIOLATION +
               G-CODE-1 + G-REVIEW-LOOP + G-AUTO-CONSENSUS）
  - classify : 4 维判定（来源/规模/AI 适配/多 Agent）

🆕 v3.3.0+ PRD 级状态机与自检（2026-06-25）：
  - enter / state confirm / gate doc-storage : entry token 领取 + 审核点确认 + 文档路径校验（v3.4.0）
  - state prd-check-complete / state prd-complete : PRD 4 层 AND 闸校验 + compact 收尾（v3.3.0）
  - runtime compact : PRD 收尾 compact（v3.3.0）
  - iteration-check : 设计-实现一致性深度体检（v3.5.4，IC-1~4 机器粗筛）
  - context-pressure : 节点级上下文压力软提示（v3.5.5，6 审核点边界）
  - ra-depth-scan : RA 机械派生深度扫描（v3.5.9，G-RA-5 D1-D5）
  - ra-implementation-scan : RA 实现视角完整性扫描（v3.5.18，G-RA-6 I1-I7）
  - flow-violation-scan : RA 流程违规扫描（v3.5.6，G-RA-FLOW-VIOLATION）
  - review-loop : review-loop CLI + verify-exit（v3.5.12，G-REVIEW-LOOP 兜底）

🆕 v3.2 G-RA（2026-06-24）：
  - gate ra-required : 需求分析准入门卫（进 dr/story/task-generate 前必过 G-RA-1~6 + FLOW）
🆕 v3.2.1 G-CODE（2026-06-24）：
  - gate coding-required : Coding 真实性门卫（Coding 完成/CodeReview 前必过 G-CODE-1）
🆕 v3.2 更新图谱（2026-06-24）：
  - update-check : 更新依赖图谱检查（改了 A 是否同步了 BCDEFG，兜底防漏更新）
🆕 v3.2.5 脚本化补齐（2026-06-25）：
  - bump : 同步三处版本号（SKILL.md/paths.py/README.md:5，UC-01 操作侧）
  - init : 项目实例化（挂载 scripts/init.py，补 UC-03 历史遗留 warn）
🆕 v3.5.1 plugin CLI 挂载（2026-06-26）：
  - plugin list                  : 列三层注册表所有已注册插件 + 冲突检测
  - plugin validate              : 校验三层注册表 + 每个 plugin sanity check
  - plugin trace <target>        : 查某 SKILL 的加载路径（replaces 路径 / provides key）
  - plugin init --layer {project|global} : 从模板生成新注册表

辅助：
  - version  : 输出版本
  - health   : 健康度自检

用法:
    ae-sdd version
    ae-sdd state read
    ae-sdd state next-step
    ae-sdd gates check [--only G-00]
    ae-sdd gate ra-required [--project <key>]   # 跑 G-RA-1~6 + FLOW（SKILL.md §🛡️ G-RA 契约）
    ae-sdd gate coding-required [--project <dir>] # 跑 G-CODE-1（Coding 反模式扫描）
    ae-sdd update-check [--only UC-01]          # 更新闭环检查（v3.2）
    ae-sdd bump 3.5.1                            # 同步三处版本号（v3.2.5）
    ae-sdd init <project-dir> <project-key>      # 项目实例化（v3.2.5）
    ae-sdd plugin list                           # 列出已注册插件（v3.5.1）
    ae-sdd plugin validate                       # 校验三层注册表（v3.5.1）
    ae-sdd plugin trace coding-skill.md          # 查某 SKILL 加载路径（v3.5.1）
    ae-sdd plugin init --layer project           # 生成项目层注册表（v3.5.1）
    ae-sdd classify --text "..."
    ae-sdd classify --file <path>
    ae-sdd health
    ae-sdd automation status                       # 自动化开关配置（v3.8.0）
    ae-sdd automation enable                       # 开启全自动化（v3.8.0）
    ae-sdd automation disable                      # 关闭自动化（v3.8.0）
    ae-sdd preflight collect [--story <ID>]        # 开工前信息预收集（v3.8.0）
    ae-sdd state register-review-consensus --point 1 --passed true  # 写联审共识（v3.8.0）
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

# 强制 stdout / stderr 用 UTF-8（Windows 默认 GBK 导致中文输出 "?"）
for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8")
    except (AttributeError, OSError):
        pass

# 让 import lib 找得到
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from lib import assets_index, classify, config, db_tool, document_storage, gates, gate_intercept, git_insight, memory_gate, memory_store, output, paths, plugin_loader, prompt_inject, runtime_verify, session, state, stop_check, update_graph  # noqa: E402


def _read_stdin_json() -> dict:
    """Read hook JSON from stdin as UTF-8 bytes.

    Claude Code sends hook input as UTF-8 JSON. On Windows, json.load(sys.stdin)
    may decode through the active console code page and corrupt markers such as
    "◆ STATE". Reading bytes avoids that runtime mismatch.
    """
    if sys.stdin.isatty():
        return {}
    try:
        raw = sys.stdin.buffer.read()
    except Exception:
        return {}
    if not raw:
        return {}
    try:
        data = json.loads(raw.decode("utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def cmd_version(args, parser):
    output.emit({
        "name": "ae-sdd",
        "version": paths.MASTER_VERSION,
        "python": sys.version.split()[0],
    }, as_json=args.json)
    return 0


def cmd_scripts_dir(args, parser):
    """🆕 v4.1：输出母版 scripts/ 目录绝对路径（跨项目解析脚本位置，取代硬编码）。"""
    master = paths.locate_master_source()
    if master is None:
        output.emit({"error": "未定位到母版 master_source"}, as_json=args.json)
        return 1
    sdir = paths.scripts_dir(master)
    output.emit({"scripts_dir": str(sdir)}, as_json=args.json)
    return 0


def _work_item_arg(args) -> str:
    """Return explicit work item id, falling back to --story for old commands."""
    return (getattr(args, "work_item", "") or getattr(args, "story", "") or "").strip()


def _main_state_path_for_args(ade_sdd: Path, args) -> tuple[Path, str]:
    """Resolve state path for main state commands.

    No work item keeps the legacy project-level state. Passing --work-item or
    --story reads/writes the isolated .auto-engineering/{id}/state.json file.
    """
    work_item = _work_item_arg(args)
    if work_item:
        return paths.work_item_state_path(ade_sdd, work_item), work_item
    return paths.state_path(ade_sdd), ""


def _write_active_state_mirror(ade_sdd: Path, state_data: dict, work_item: str, source_path: Path) -> None:
    """Write .ae-sdd/state.json as an active-work-item mirror for old gates/hooks."""
    if not work_item:
        return
    mirror = dict(state_data)
    mirror["activeWorkItem"] = work_item
    mirror["activeStatePath"] = str(source_path)
    state.write_state(paths.state_path(ade_sdd), mirror)


def _infer_scale_for_work_item(work_item: str, entry_node: str | None) -> tuple[str, str] | None:
    """Infer micro-chain routing for explicit BUG/OPT/CONFIG work items."""
    marker = (entry_node or "").strip().upper()
    item = (work_item or "").strip().upper()
    if marker in {"BUG", "OPT", "CONFIG"}:
        return "微", marker
    if item.startswith("BUG-"):
        return "微", "BUG"
    if item.startswith("OPT-"):
        return "微", "OPT"
    if item.startswith("CONFIG-"):
        return "微", "CONFIG"
    return None


def cmd_state_read(args, parser):
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    sp, _work_item = _main_state_path_for_args(ade_sdd, args)
    s = state.read_state(sp)
    output.emit(s, as_json=args.json)
    return 0


def cmd_state_write(args, parser):
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    sp, work_item = _main_state_path_for_args(ade_sdd, args)
    s = state.read_state(sp)
    cfg = paths.read_config(ade_sdd)
    if cfg.get("projectKey") and not s.get("projectKey"):
        s["projectKey"] = cfg.get("projectKey")
    if work_item:
        s["currentWorkItem"] = work_item
        # Backward compatibility: older gates still key off currentStory.
        if not s.get("currentStory") and not args.story:
            s["currentStory"] = work_item
    effective_state = dict(s)
    if args.story and not effective_state.get("currentStory"):
        effective_state["currentStory"] = args.story
    if work_item and not effective_state.get("currentWorkItem"):
        effective_state["currentWorkItem"] = work_item
    if args.task and not effective_state.get("currentTask"):
        effective_state["currentTask"] = args.task
    memory_result = memory_gate.check_state_transition(
        ade_sdd=ade_sdd,
        state_data=effective_state,
        target_phase=args.phase,
        allow_empty=getattr(args, "allow_empty_memory", False),
    )
    if memory_result.get("blocked"):
        msg = memory_gate.format_transition_block(memory_result)
        if args.json:
            output.emit({"ok": False, "blocked": True, "memory": memory_result, "message": msg}, as_json=True)
        else:
            output.err(msg)
        return 1
    try:
        # 🆕 v3.5.15：首次 state write 携带 --scale 时写入（幂等：已存在则 warn 不覆盖）
        # WorkItem 入口为 BUG/OPT/CONFIG 时默认走微链，避免独立缺陷/优化误落大流程。
        requested_scale = args.scale
        requested_entry_node = args.entry_node
        if not requested_scale and not s.get("scale"):
            inferred = _infer_scale_for_work_item(work_item, requested_entry_node)
            if inferred:
                requested_scale, requested_entry_node = inferred
        if requested_scale:
            existing_scale = s.get("scale")
            if existing_scale and existing_scale != requested_scale:
                output.warn(f"state 已有 scale={existing_scale}，与本次 --scale={requested_scale} 冲突，"
                            f"保留现有 scale（如需切换请先 set_scale 重置）")
            else:
                state.set_scale(s, requested_scale, entry_node=requested_entry_node)
        changed = state.set_phase(s, args.phase, by="ae-sdd state write")
    except ValueError as e:
        output.err(str(e))
        return 1
    if args.story:
        s["currentStory"] = args.story
    if work_item:
        s["currentWorkItem"] = work_item
    if args.task:
        s["currentTask"] = args.task
    state.write_state(sp, s)
    _write_active_state_mirror(ade_sdd, s, work_item, sp)
    if changed:
        output.ok(f"state 更新：phase={args.phase}")
    else:
        output.warn(f"state 未变更：phase 已为 {args.phase}（history 不累加）")
    return 0


def cmd_state_next_step(args, parser):
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    sp, _work_item = _main_state_path_for_args(ade_sdd, args)
    s = state.read_state(sp)
    suggestion = state.next_step_suggestion(s)
    if args.json:
        output.emit(suggestion, as_json=True)
    else:
        output.info(f"当前 phase: {suggestion['current']}")
        output.info(f"下一步:     {suggestion['next']}")
        output.info(f"动作:       {suggestion['action']}")
        output.info(f"SKILL:      {suggestion['skill']}")
    return 0


# === 🆕 v3.3.0 PRD 级状态机 CLI ===

def _prd_state_path(project_root: Path, prd_id: str) -> Path:
    """Resolve `.auto-engineering/{PRD-ID}/state.json` path.

    PRD-ID format: PRD-<业务域>-<序号>（如 PRD-CS-001），参见
    `ae-sdd-skill.md §1.2` + `document-storage-skill.md §3.5`。
    """
    return project_root / ".auto-engineering" / prd_id / "state.json"


def _read_prd_state(project_root: Path, prd_id: str) -> dict:
    """Read PRD-level state.json; return {} if not exists (兼容 v3.3.0 之前未建 PRD 级 state)."""
    p = _prd_state_path(project_root, prd_id)
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        output.warn(f"PRD state.json 解析失败: {e}")
        return {}


def cmd_state_prd_init(args, parser):
    """🆕 v3.5.12 — 初始化 PRD 级 state（写入 8 字段 + prdStatus=in_progress）。

    治 P0-9/10：v3.5.12 前无此命令，PRD schema 8 字段全是死字段，
    check_prd_4_layers 永远 fail。本命令补真写入入口。
    """
    from lib import state as state_mod
    project_root = Path.cwd()
    prd_state_path = project_root / ".auto-engineering" / args.prd / "state.json"
    st = state_mod.read_state(prd_state_path)
    state_mod.prd_init(st, args.prd, args.title or "",
                       story_ids=[], size_budget={})
    state_mod.write_state(prd_state_path, st)

    if args.json:
        output.emit({"prdId": args.prd, "status": "in_progress",
                     "written": ["prdId", "storyIds", "crossStoryDeps",
                                 "crossStoryResidualRisks", "sizeBudget",
                                 "prdReview", "gateRegistry", "compactHistory", "prdStatus"]},
                    as_json=True)
    else:
        output.info(f"✅ PRD {args.prd} 初始化完成（prdStatus=in_progress）")
        output.info(f"   写入 8 字段 + prdStatus（治 P0-9/10 死字段）")
    return 0


def cmd_state_prd_check_complete(args, parser):
    """🆕 v3.3.0 — 校验 4 层 AND（G-PRD-1~4），输出未达成项，**不改状态**."""
    project_root = Path.cwd()
    prd_id = args.prd
    ps = _read_prd_state(project_root, prd_id)

    if not ps:
        output.err(f"PRD 级 state.json 不存在：{_prd_state_path(project_root, prd_id)}")
        output.info("提示：先跑 ae-sdd state prd-init（或等 Story 完成 hook 自动写入）")
        return 1

    # 复用 state.check_prd_4_layers（🆕 v3.5.4 抽出，供 HS-7 物理拦截与 CLI 共用）
    result = state.check_prd_4_layers(ps)
    result["prdStatus"] = ps.get("prdStatus", "unknown")
    all_pass = result["all_pass"]

    if args.json:
        output.emit(result, as_json=True)
    else:
        for k in ("G-PRD-1", "G-PRD-2", "G-PRD-3", "G-PRD-4"):
            r = result[k]
            icon = "✅" if r["pass"] else "🔴"
            output.info(f"{icon} {k}: {r['label']}")
            for m in r["missing"]:
                output.info(f"   - {m}")
        output.info("")
        if all_pass:
            output.ok(f"PRD {prd_id} 4 层 AND 全过；可执行 `ae-sdd state prd-complete --prd {prd_id} --runtime <runtime>`")
            return 0
        else:
            output.err(f"PRD {prd_id} 4 层 AND 未全过；阻塞 compact")
            return 1


def cmd_state_prd_complete(args, parser):
    """🆕 v3.3.0 — 校验通过后执行 compact，更新 prdStatus."""
    project_root = Path.cwd()
    prd_id = args.prd
    runtime = args.runtime
    ps = _read_prd_state(project_root, prd_id)

    if not ps:
        output.err(f"PRD 级 state.json 不存在：{_prd_state_path(project_root, prd_id)}")
        return 1

    if ps.get("prdStatus") == "compacted":
        output.warn(f"PRD {prd_id} 已 compacted，跳过")
        return 0

    # 先校验 4 层 AND
    # （简化：内部调用 prd-check-complete 逻辑；此处省略重复代码，提示用户先跑）
    output.info(f"PRD {prd_id} 当前 prdStatus = {ps.get('prdStatus', 'unknown')}")
    output.info("提示：建议先跑 `ae-sdd state prd-check-complete --prd {prd_id}` 校验")
    output.info(f"将触发 compact：runtime={runtime}")

    # 更新 prdStatus → awaiting_compact → 等 compact hook 触发 → compacted
    ps["prdStatus"] = "awaiting_compact"
    ps["lastUpdated"] = _now_iso()
    p = _prd_state_path(project_root, prd_id)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(ps, ensure_ascii=False, indent=2), encoding="utf-8")
    output.ok(f"PRD {prd_id} prdStatus → awaiting_compact；等待 compact hook 触发")
    output.info(f"下一步：跑 `ae-sdd runtime compact --runtime {runtime} --prd {prd_id}`")
    return 0


def cmd_state_prd_archive(args, parser):
    """🆕 v3.3.0 — 归档 compactHistory 到 state.archive.json."""
    project_root = Path.cwd()
    prd_id = args.prd
    keep_last = args.keep_last
    ps = _read_prd_state(project_root, prd_id)

    if not ps:
        output.err(f"PRD 级 state.json 不存在：{_prd_state_path(project_root, prd_id)}")
        return 1

    history = ps.get("compactHistory", [])
    if len(history) <= keep_last:
        output.info(f"compactHistory 只有 {len(history)} 条，无需归档（keep_last={keep_last}）")
        return 0

    archive_path = project_root / ".auto-engineering" / prd_id / "state.archive.json"
    archive = []
    if archive_path.exists():
        try:
            archive = json.loads(archive_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            archive = []
    archive.extend(history[:-keep_last])
    ps["compactHistory"] = history[-keep_last:]

    archive_path.write_text(json.dumps(archive, ensure_ascii=False, indent=2), encoding="utf-8")
    p = _prd_state_path(project_root, prd_id)
    p.write_text(json.dumps(ps, ensure_ascii=False, indent=2), encoding="utf-8")
    output.ok(f"归档 {len(history) - keep_last} 条到 {archive_path}；state.json 保留最近 {keep_last} 条")
    return 0


def _now_iso() -> str:
    """ISO 8601 UTC timestamp."""
    import datetime as _dt
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_runtime_compact(args, parser):
    """🆕 v3.3.0 — runtime-specific compact 适配层.

    实际 compact 由对应 runtime 执行：
    - mavis: `mavis session rotate --handoff-file <summary.md>`
    - claude-code: UserPromptSubmit hook 注入 state.md 路径
    - codex: `codex plugin add ae-sdd-prd-state` + `codex exec --json --output-last-message`
    """
    runtime = args.runtime
    prd_id = args.prd

    output.info(f"runtime compact: runtime={runtime}, prd={prd_id}")

    if runtime == "mavis":
        summary_path = f".auto-engineering/{prd_id}/summary.md"
        output.info(f"将执行：mavis session rotate --handoff-file {summary_path}")
        output.info("提示：summary.md 必须先由 `ae-sdd state prd-complete` 生成；如需自动触发，加 shell hook")
    elif runtime == "claude-code":
        output.info("将执行：UserPromptSubmit hook 注入 state.md 路径 + prdStatus")
        output.info("提示：参考 HARNESS.md §🪝 三 Hook 配置 + HARNESS.md §UserPromptSubmit v3.3.0 payload")
    elif runtime == "codex":
        output.info("将执行：")
        output.info("  1. codex plugin add ae-sdd-prd-state")
        output.info("  2. codex exec --json --output-last-message .auto-engineering/{prd_id}/summary.md")
        output.info("提示：详见 docs/plans/2026-06-25-codex-poc-result.md")
    else:
        output.err(f"未知 runtime：{runtime}（仅支持 mavis / claude-code / codex）")
        return 1

    output.info("")
    output.info("⚠️  本子命令当前为**协议级骨架**，不直接执行 shell 命令；")
    output.info("    实际触发由各 runtime 的 hook / session protocol 完成。")
    output.info("    实施完会标记 prdStatus → compacted 并写 summary.md")

    # 🆕 v3.5.12：补真实 prdStatus 写入（闭环 5 态，治 P1-4 状态机残缺）
    # 协议骨架不变（实际 compact 由 runtime hook 执行），但状态写入要真实，
    # 否则 prdStatus 永远卡 awaiting_compact，stop_check HS-8 误报。
    from lib import state as state_mod
    project_root = Path.cwd()
    prd_state_path = project_root / ".auto-engineering" / prd_id / "state.json"
    if prd_state_path.is_file():
        ps = state_mod.read_state(prd_state_path)
        state_mod.set_prd_status(ps, "compacted")
        state_mod.write_state(prd_state_path, ps)
        output.ok(f"prdStatus → compacted（v3.5.12 闭环写入）")
    else:
        output.warn(f"PRD state.json 不存在（{prd_state_path}），跳过 prdStatus 写入")
    return 0


def _default_runtime_verify_path() -> Path:
    root = Path(__file__).resolve().parent.parent.parent
    if (root / "SKILL.md").is_file():
        return root
    dist = root / "dist" / "ae-sdd"
    if (dist / "SKILL.md").is_file():
        return dist
    return root


def cmd_runtime_verify(args, parser):
    target = Path(args.path).expanduser() if args.path else _default_runtime_verify_path()
    result = runtime_verify.verify_runtime_package(target)
    payload = result.to_dict()

    if args.json:
        output.emit(payload, as_json=True)
    else:
        if result.ok:
            manifest = result.manifest or {}
            output.ok(f"compiled runtime verified: {result.package_path}")
            output.info(f"version: {manifest.get('version', '(unknown)')}")
            output.info(f"runtime_fingerprint: {manifest.get('runtime_fingerprint', '(missing)')}")
            if result.warnings:
                output.warn(f"warnings: {result.warnings}")
        else:
            output.err(f"compiled runtime verify failed: {result.package_path}")
            for item in result.issues:
                output.err(f"  - {item}")
            if result.warnings:
                output.warn(f"warnings: {result.warnings}")
    return 0 if result.ok else 1


def cmd_gates_check(args, parser):
    master = paths.locate_master_source()
    ade_sdd = paths.locate_project_ae_sdd()
    project_key = None
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey")
    if not project_key:
        project_key = "unknown"

    results = gates.check_all(master, ade_sdd, project_key, only=args.only)
    summary = gates.summarize(results)

    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"跑了 {summary['total']} 门禁：✅ {summary['passed']} / ❌ {summary['failed']} / 🟡 {summary['stubs']} stub")
        for r in summary["results"]:
            mark = "✅" if r["pass"] else "❌"
            output.info(f"  {mark} {r['gate_id']} {r['name']}: {r['message']}")
            if r.get("action"):
                output.info(f"      → {r['action']}")

    # 任何 blocker 失败 → exit 1
    return 0 if summary["all_pass"] else 1


def cmd_gate_ra_required(args, parser):
    """gate ra-required — 需求分析准入门卫（SKILL.md §🛡️ G-RA 契约）

    跑 G-RA-1~6 + FLOW：RA 文档存在 / 8 维度完整 / 衍生章节完整 /
    真实性扫描 / 机械派生深度 / 实现视角完整性 / 流程违规审计。
    进 dr-generate / story-generate / task-generate 前必过（微任务/BUG 豁免）。
    """
    master = paths.locate_master_source()
    # 优先用 --project 指定的目录，否则从 cwd 向上找 .ae-sdd/
    if getattr(args, "project", "") and args.project:
        ade_sdd = paths.locate_project_ae_sdd(Path(args.project))
    else:
        ade_sdd = paths.locate_project_ae_sdd()
    project_key = None
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey")
    if not project_key:
        project_key = "unknown"

    ra_gate_ids = [
        "G-RA-1",
        "G-RA-2",
        "G-RA-3",
        "G-RA-4",
        "G-RA-FLOW-VIOLATION",
        "G-RA-5",
        "G-RA-6",
    ]
    results = []
    for gid in ra_gate_ids:
        # 多个 G-RA 门禁需要 master_source 调扫描器；统一走 check_all 特判。
        r = gates.check_all(master, ade_sdd, project_key, only=gid)
        results.extend(r)

    summary = gates.summarize(results)
    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"🛡️ G-RA 需求分析准入门卫（{summary['total']} 门禁：✅ {summary['passed']} / ❌ {summary['failed']} / 🟡 {summary['stubs']} stub）")
        for r in summary["results"]:
            mark = "✅" if r["pass"] else "❌"
            output.info(f"  {mark} {r['gate_id']} {r['name']}: {r['message']}")
            if r.get("action"):
                output.info(f"      → {r['action']}")
        if not summary["all_pass"]:
            output.info("⚠️ G-RA 未通过：下游 dr-generate / story-generate / task-generate 被阻断。")
            output.info("   修复后重跑 `ae-sdd gate ra-required`，或触发 requirement-analysis-skill 生成 RA。")

    return 0 if summary["all_pass"] else 1


def cmd_gate_coding_required(args, parser):
    """gate coding-required — Coding 真实性准入门卫（CodingModel §6 反模式库）

    跑 G-CODE-1：调用 coding_authenticity_scan.py 扫 AP-1~AP-6 中可静态命中的
    Coding 反模式。进入 CodeReview / 完成判定前必过。
    """
    master = paths.locate_master_source()
    if getattr(args, "project", "") and args.project:
        ade_sdd = paths.locate_project_ae_sdd(Path(args.project))
        project_root = Path(args.project).resolve()
    else:
        ade_sdd = paths.locate_project_ae_sdd()
        project_root = Path.cwd()

    project_key = None
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey")
    if not project_key:
        project_key = "unknown"

    # check_all 会在无 .ae-sdd 时用 cwd；--project 指向非 ae-sdd 根时临时切 cwd。
    old_cwd = Path.cwd()
    try:
        if not ade_sdd and project_root:
            import os
            os.chdir(project_root)
        results = gates.check_all(master, ade_sdd, project_key, only="G-CODE-1")
    finally:
        if old_cwd != Path.cwd():
            import os
            os.chdir(old_cwd)

    summary = gates.summarize(results)
    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"🛡️ G-CODE Coding 真实性门卫（{summary['total']} 门禁：✅ {summary['passed']} / ❌ {summary['failed']} / 🟡 {summary['stubs']} stub）")
        for r in summary["results"]:
            mark = "✅" if r["pass"] else "❌"
            output.info(f"  {mark} {r['gate_id']} {r['name']}: {r['message']}")
            if r.get("action"):
                output.info(f"      → {r['action']}")
        if not summary["all_pass"]:
            output.info("⚠️ G-CODE 未通过：Coding 完成 / CodeReview 前被阻断。")
            output.info("   修复后重跑 `ae-sdd gate coding-required`。")

    return 0 if summary["all_pass"] else 1


def cmd_gate_doc_storage(args, parser):
    """gate doc-storage — 文档落地存放门卫（SKILL.md §🛡️ G-DOC-STORAGE 契约，🆕 v3.4.0）

    单点校验：给定 --path（实际写入路径）是否合规（落在合规根目录 + 非游离位置）。
    与 `gates check --only G-DOC-STORAGE`（扫描全 project_dir）互补：本命令用于"落地前"单点校验。
    """
    target_path = args.path
    if not target_path:
        output.err("必须提供 --path <实际写入路径>")
        return 1

    from pathlib import Path as _P
    p = _P(target_path)
    rel_or_abs = str(p).replace("\\", "/")
    rel_lower = rel_or_abs.lower()

    # 复用 gates.py 的合规根目录 + 游离位置定义
    compliant_roots = gates._DOC_COMPLIANT_ROOTS
    stray_markers = gates._DOC_STRAY_MARKERS

    issues: list[str] = []
    # 游离位置检测
    if any(m in rel_lower for m in stray_markers):
        issues.append(f"路径含游离位置标记（{stray_markers}）")
    # 合规根目录检测：路径中任一段匹配合规根
    in_compliant = any(root in rel_lower.split("/") for root in compliant_roots)
    if not in_compliant:
        # 允许项目根直接落产物（向后兼容），但需 --project 校验；无 --project 时标 warn
        if not args.project:
            issues.append(f"路径不在合规根目录（{compliant_roots}）下，且未提供 --project 无法判定项目根")

    result = {
        "path": target_path,
        "intent": args.intent,
        "compliant": not issues,
        "issues": issues,
    }
    if args.json:
        output.emit(result, as_json=True)
    else:
        if issues:
            output.err(f"❌ G-DOC-STORAGE 校验未通过：{'; '.join(issues)}")
            output.info(f"   路径：{target_path}")
            output.info("   修复：调 document-storage resolve_path 推导路径；禁止硬编码 d:\\tmp\\ 等游离位置")
        else:
            output.ok(f"✅ G-DOC-STORAGE 校验通过：{target_path}")
    return 0 if not issues else 1


def _resolve_ade_sdd_and_project_key(args):
    """统一解析 ade_sdd + project_key（多数命令共用）。

    优先级：--project > cwd 向上找 .ae-sdd/ > unknown。
    """
    project_arg = getattr(args, "project", "") or ""
    ade_sdd = paths.locate_project_ae_sdd(Path(project_arg)) if project_arg else paths.locate_project_ae_sdd()
    project_key = None
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey")
    if not project_key:
        project_key = "unknown"
    return ade_sdd, project_key


def cmd_doc_save(args, parser):
    """doc save — 一步到位存文档（封装 document_storage.save_doc，🆕 v3.7.2）

    流程：读草稿 → save_doc（resolve+写+版本+ChangeLog+STORING+gitignore）→ 删草稿。
    对齐 document-storage-skill.md §4.3 + §9 写入 SOP。
    """
    ade_sdd, project_key = _resolve_ade_sdd_and_project_key(args)
    if not ade_sdd:
        output.err("找不到 .ae-sdd/ 项目根（可用 --project 指定）")
        return 1

    content_file = Path(args.content_file)
    if not content_file.is_file():
        output.err(f"草稿文件不存在：{args.content_file}")
        return 1
    content = content_file.read_text(encoding="utf-8")

    # version 字符串 → dict（复用 document_storage._normalize_version 的容错逻辑）
    version = None
    if args.version:
        major, minor = document_storage._normalize_version(args.version, True)
        version = {"major": major, "minor": minor}

    result = document_storage.save_doc(
        ade_sdd, project_key, args.intent, content,
        story_id=args.story_id, doc_id=args.doc_id,
        version=version, changelog_note=args.changelog_note,
        work_item_id=args.work_item,
    )

    if not result.success:
        # E000（未实现 intent）给降级提示
        if "E000" in (result.error or ""):
            output.err(f"❌ {result.error}")
            output.info("   该 intent 暂未实现路径模板。降级：LLM 手写到目标路径后用 `ae-sdd doc finalize --path <已写文件>` 补登记。")
        else:
            output.err(f"❌ {result.error}")
        return 1

    # 删草稿（除非 --keep-draft；且草稿不能等于最终路径，避免误删）
    final_path = Path(result.full_path).resolve()
    if not args.keep_draft and content_file.resolve() != final_path:
        content_file.unlink(missing_ok=True)

    output.ok(f"✅ 已存：{result.full_path}")
    if result.new_version:
        output.info(f"   版本：{result.new_version}")
    if args.json:
        output.emit({"success": result.success, "fullPath": result.full_path,
                     "newVersion": result.new_version, "changelogEntry": result.changelog_entry},
                    as_json=True)
    return 0


def cmd_doc_resolve(args, parser):
    """doc resolve — 只推路径不写（封装 document_storage.resolve_path，🆕 v3.7.2）

    用途：LLM 查"会写到哪"、或落地前单点校验路径合规。不写文件、无副作用。
    """
    ade_sdd, project_key = _resolve_ade_sdd_and_project_key(args)
    if not ade_sdd:
        output.err("找不到 .ae-sdd/ 项目根（可用 --project 指定）")
        return 1

    try:
        resolved = document_storage.resolve_path(
            ade_sdd, project_key, args.intent,
            story_id=args.story_id, doc_id=args.doc_id,
            work_item_id=args.work_item,
        )
    except document_storage.DocStorageError as e:
        output.err(f"❌ {e}")
        return 1

    payload = {
        "fullPath": resolved.full_path,
        "dirPath": resolved.dir_path,
        "fileName": resolved.file_name,
        "versionSuffix": resolved.version_suffix,
        "changelogPath": resolved.changelog_path,
        "scope": resolved.scope,
    }
    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.ok(f"📍 路径：{resolved.full_path}")
        if resolved.version_suffix:
            output.info(f"   版本后缀：{resolved.version_suffix}")
        output.info(f"   ChangeLog：{resolved.changelog_path}")
    return 0


def cmd_doc_finalize(args, parser):
    """doc finalize — 对已手写文件补版本号/ChangeLog/STORING（封装 document_storage.finalize_doc，🆕 v3.7.2）

    适用：未实现 intent 的文档 LLM 手写后补登记，或漏跑 save_doc 后处理。
    不覆盖文件内容，只补 ChangeLog + STORING + .gitignore。
    """
    ade_sdd, project_key = _resolve_ade_sdd_and_project_key(args)
    if not ade_sdd:
        output.err("找不到 .ae-sdd/ 项目根（可用 --project 指定）")
        return 1

    if not Path(args.path).is_file():
        output.err(f"目标文件不存在：{args.path}")
        return 1

    try:
        result = document_storage.finalize_doc(
            ade_sdd, project_key, args.intent, args.path,
            story_id=args.story_id, doc_id=args.doc_id,
            changelog_note=args.changelog_note,
            work_item_id=args.work_item,
        )
    except document_storage.DocStorageError as e:
        output.err(f"❌ {e}")
        return 1

    output.ok(f"✅ 已登记：{result.full_path}")
    if result.changelog_entry:
        output.info(f"   ChangeLog：已追加")
    if args.json:
        output.emit({"success": result.success, "fullPath": result.full_path,
                     "newVersion": result.new_version, "changelogEntry": result.changelog_entry},
                    as_json=True)
    return 0


def cmd_update_check(args, parser):
    """update-check — 更新依赖图谱（v3.2 — 改了 A 要同步 BCDEFG）

    两种模式：
    1. 查询模式（--affected <files>）：改了这些文件，连带项是什么 + 该跑哪些检查
       用法：ae-sdd update-check --affected tools/lib/gates.py,source/SKILL.md
    2. 检查模式（默认/--only）：跑 UC-01~UC-05 验证无漏更新
    """
    repo_root = Path(__file__).resolve().parent.parent.parent

    # ── 查询模式：改了文件，问连带项 ──
    if args.affected:
        files = [f.strip() for f in args.affected.split(",") if f.strip()]
        qr = update_graph.query_affected(files, repo_root)
        payload = {
            "changed_files": qr.changed_files,
            "matched_rules": qr.matched_rules,
            "affected_items": qr.affected_items,
            "checks_to_run": qr.checks_to_run,
        }
        if args.json:
            output.emit(payload, as_json=True)
        else:
            output.info(f"🔗 查询：改了 {len(qr.changed_files)} 个文件 → 命中 {len(qr.matched_rules)} 条图谱规则")
            output.info("")
            output.info("📋 连带项（必须同步检查，去重后）：")
            for a in qr.affected_items:
                auto = " [自动可检]" if a["auto_checkable"] else " [人工确认]"
                output.info(f"  • [{a['from_rule']}] {a['path']}{auto}")
                output.info(f"      → {a['action']}")
            output.info("")
            output.info(f"🔍 该跑检查：{qr.checks_to_run}")
            output.info(f"   跑 `ae-sdd update-check --only {qr.checks_to_run[0]}` 逐项验证（或直接 `ae-sdd update-check` 全量）")
        return 0

    # ── 检查模式：跑 UC-01~UC-12（含 AA 全维对齐 UC-08~12，v3.5.11）──
    # AA（alignment_audit）注册到 update_graph.CHECK_FUNCS，统一调度
    from lib import alignment_audit  # noqa: F401 — 触发 register_to_update_graph()
    results = update_graph.check_all(repo_root, only=args.only)
    summary = update_graph.summarize(results)

    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"🔗 更新依赖图谱检查（{summary['total']} 项：✅ {summary['passed']} / ❌ {summary['failed']} / 🟡 {summary['warnings']} warn）")
        for c in summary["checks"]:
            mark = "✅" if c["pass"] else ("🟡" if c["severity"] == "warn" else "❌")
            output.info(f"  {mark} {c['check_id']} {c['name']}: {c['message']}")
            if c.get("fix") and not c["pass"]:
                output.info(f"      → {c['fix']}")
        if summary["failed"] > 0:
            output.info("⚠️ 存在漏更新或 AA 对齐缺口：按上述 fix 修复后重跑 `ae-sdd update-check`。")
        else:
            output.info("✅ 更新闭环完整，无漏更新，AA 全维对齐通过。")

    return 0 if summary["failed"] == 0 else 1


def cmd_iteration_check(args, parser):
    """iteration-check — 设计-实现一致性迭代检查（🆕 v3.5.4）

    补 UC-01~07 自动检查的 4 类盲区：HS 物理实现齐全度 / 幽灵命令整段描述 /
    F-1 交叉验证覆盖面 / 已实现未接入。不阻断 dev-sync（report-only），
    与 update-check 互补不替代。

    对应 SOP：ae-sdd-update-skill.md §设计-实现一致性迭代检查
    """
    repo_root = paths.locate_master_source() or Path.cwd()
    if repo_root and repo_root.name == "source":
        repo_root = repo_root.parent  # locate_master_source 返回 source/，取 parent 为仓库根
    if args.project:
        repo_root = Path(args.project)

    from lib import iteration_check as ic
    report = ic.run_all(repo_root)

    if args.json:
        output.emit(report.to_dict(), as_json=True)
    else:
        output.info(f"🆕 v3.5.4 设计-实现一致性迭代检查（补 UC 盲区，report-only 不阻断）")
        output.info(f"跑了 {len(report.checks_run)} 项检查：{', '.join(report.checks_run)}")
        output.info(f"发现 {len(report.findings)} 项（{report.n_warn} warn / {report.n_info} info）")
        output.info("")
        # 按 check_id 分组输出
        from collections import defaultdict
        by_check: dict = defaultdict(list)
        for f in report.findings:
            by_check[f.check_id].append(f)
        check_names = {
            "IC-1": "过时技术栈/幽灵命令扫描",
            "IC-2": "F-1 交叉验证覆盖面",
            "IC-3": "已实现未接入扫描",
            "IC-4": "HS 物理实现粗筛",
        }
        for cid in ("IC-1", "IC-2", "IC-3", "IC-4"):
            findings = by_check.get(cid, [])
            output.info(f"── {cid} {check_names.get(cid, '')}（{len(findings)} 项）──")
            if not findings:
                output.info("  ✅ 无发现")
            for f in findings:
                icon = "🟡" if f.severity == "warn" else "ℹ️"
                output.info(f"  {icon} [{f.severity}] {f.item}")
                output.info(f"      定位: {f.location}")
                output.info(f"      详情: {f.detail}")
            output.info("")

        if report.n_warn > 0:
            output.warn(
                f"发现 {report.n_warn} 项 warn：建议按 ae-sdd-update-skill.md "
                f"§设计-实现一致性迭代检查 SOP 步骤2-4 人工确认并修复"
            )
        else:
            output.ok("无 warn，机器粗筛通过（语义级核对仍需人工 SOP 步骤2）")

    # report-only，始终返回 0（不阻断 dev-sync）
    return 0


def cmd_ra_gate(args, parser):
    """ra-gate — RA 任务入口硬触发（🆕 2026-06-27，建议书 §3.5）

    判定用户输入触发"出文档类任务"时，RA skill 是否强制触发。
    输出：trigger_skill / min_flow / block_direct_output / reasoning。
    与 SKILL.md §4 维判定智能路由表 + RA skill §反模式 8/9 配套。

    凭证前置（v3.4.0 加固）：调用本 CLI 前应已 `ae-sdd enter <projectKey> --story <STORY>`
    领凭证。本 CLI 不强制阻断（向后兼容），但未领凭证时输出 warn。
    """
    input_type = args.input_type

    # 6 类输入类型判定（对齐 SKILL.md §4 维判定智能路由）
    type_map = {
        "pdf-analysis": {
            "trigger_skill": "requirement-analysis-skill",
            "min_flow": "7-step",
            "block_direct_output": True,
            "reasoning": "PDF 分析类任务属于'修订建议书/proposal/分析报告'输入类型，必须走 RA skill 完整 7 步",
        },
        "doc-analysis": {
            "trigger_skill": "requirement-analysis-skill",
            "min_flow": "7-step",
            "block_direct_output": True,
            "reasoning": "文档分析类任务属于'分析报告'输入类型，必须走 RA skill 完整 7 步",
        },
        "proposal": {
            "trigger_skill": "requirement-analysis-skill",
            "min_flow": "7-step",
            "block_direct_output": True,
            "reasoning": "proposal 类任务属于'修订建议书'输入类型，必须走 RA skill 完整 7 步",
        },
        "research": {
            "trigger_skill": "requirement-analysis-skill",
            "min_flow": "7-step",
            "block_direct_output": True,
            "reasoning": "调研类任务属于'调研文档'输入类型，必须走 RA skill 完整 7 步",
        },
        "bug-fix": {
            "trigger_skill": "coding-skill (BUG path)",
            "min_flow": "ra-simplified (5-dim scale)",
            "block_direct_output": False,
            "reasoning": "BUG 类任务走 coding-skill，RA 简化版（仅 5 维规模裁定），intent=BUG 双重豁免",
        },
        "config": {
            "trigger_skill": "coding-skill (CONFIG path)",
            "min_flow": "ra-simplified (5-dim scale)",
            "block_direct_output": False,
            "reasoning": "配置类任务走 coding-skill 特殊-非代码路径，intent=CONFIG 双重豁免",
        },
    }
    result = type_map.get(input_type)
    if result is None:
        output.error(f"未知 input-type: {input_type}（允许: {list(type_map.keys())}）")
        return 2

    # 凭证前置检查（v3.4.0 加固 — 仅 warn 不阻断，向后兼容）
    ade_sdd = paths.locate_project_ae_sdd() if not args.project else paths.locate_project_ae_sdd(Path(args.project))
    entry_warn = None
    if ade_sdd:
        try:
            from lib import session as session_mod
            if not session_mod.has_valid_entry_token(ade_sdd, getattr(args, "story", "") or ""):
                entry_warn = "未领 entry token（建议先跑 `ae-sdd enter <projectKey> --story <STORY-ID>`）"
        except Exception:
            pass  # 母版仓库无 .ae-sdd/，跳过

    payload = dict(result)
    payload["input_type"] = input_type
    if entry_warn:
        payload["entry_warn"] = entry_warn

    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.info(f"🆕 v3.5.6 RA 任务入口判定（建议书 §3.5）")
        output.info(f"输入类型：{input_type}")
        output.info(f"触发 SKILL：{result['trigger_skill']}")
        output.info(f"最小流程：{result['min_flow']}")
        output.info(f"阻断直接出文档：{'是' if result['block_direct_output'] else '否'}")
        output.info(f"理由：{result['reasoning']}")
        if entry_warn:
            output.warn(f"⚠️ {entry_warn}")
    return 0


def cmd_flow_violation_scan(args, parser):
    """flow-violation-scan — RA 流程违规审计（🆕 2026-06-27，建议书 §3.4）

    调 scripts/flow_violation_scan.py 跑 8 条规则扫描 RA 文档合规性。
    与 gates check --only G-RA-FLOW-VIOLATION 内部调同一脚本，本 CLI 提供独立入口。
    """
    import subprocess
    master = paths.locate_master_source()
    # 兼容开发仓库（master=source/，脚本在 source/../scripts/）+ 分发包（master=dist/，脚本在 dist/scripts/）
    candidates = []
    if master:
        candidates = [master.parent / "scripts" / "flow_violation_scan.py",
                      master / "scripts" / "flow_violation_scan.py"]
    candidates.append(Path("scripts/flow_violation_scan.py"))
    scanner = next((c for c in candidates if c.is_file()), None)
    if scanner is None:
        output.error(f"未找到 flow_violation_scan.py（候选：{candidates}）")
        return 2

    root = args.root or str(Path.cwd())
    cmd = [sys.executable, str(scanner), "--root", root, "--format", "json"]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=120, check=False)
    except subprocess.TimeoutExpired:
        output.error("flow_violation_scan.py 跑超过 120 秒")
        return 3

    report = {}
    if args.json:
        sys.stdout.write(result.stdout)
        try:
            report = json.loads(result.stdout) if result.stdout else {}
        except json.JSONDecodeError:
            pass
    else:
        try:
            report = json.loads(result.stdout) if result.stdout else {}
        except json.JSONDecodeError:
            output.error(f"扫描器 JSON 输出无法解析：{result.stdout[:200]}")
            return 4
        stats = report.get("reportStats", {})
        output.info(f"🆕 v3.5.6 RA 流程违规审计（8 条规则）")
        output.info(f"扫描根：{report.get('root', root)}")
        output.info(f"RA 文件数：{stats.get('raFiles', 0)}")
        output.info(f"状态：{report.get('status', 'UNKNOWN')}")
        output.info(f"阻断违规：{stats.get('blockerViolations', 0)} / 警告违规：{stats.get('warnViolations', 0)}")
        output.info(f"规则通过：{stats.get('rulesPassed', 0)} / 8 / 规则失败：{stats.get('rulesFailed', 0)} / 8")
        findings = report.get("findings", [])
        if findings:
            output.info("")
            output.info("违规清单：")
            for f in findings:
                icon = "🔴" if f.get("severity") == "BLOCKER" else "🟡"
                output.info(f"  {icon} [{f.get('rule')}] {f.get('path')}:{f.get('line')}")
                output.info(f"      {f.get('message')}")

    return 1 if report.get("status") == "FAIL" and args.strict else 0


