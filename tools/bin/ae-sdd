def cmd_classify(args, parser):
    text = args.text
    filename = None
    if args.file:
        p = Path(args.file)
        if not p.is_file():
            output.err(f"文件不存在: {p}")
            return 1
        text = p.read_text(encoding="utf-8")
        filename = p.name
    if not text:
        output.err("必须提供 --text 或 --file")
        return 1
    # 🆕 v3.5.10 Gap-014：--project 传入项目根路径，让规模判定优先读已有产物
    project_context = None
    if getattr(args, "project", None):
        project_context = Path(args.project).resolve()
        if not project_context.is_dir():
            output.warn(f"--project 路径不存在或非目录：{project_context}，忽略项目上下文")
            project_context = None
    # 🆕 2026-07-03 缺口2:记录规模判定结果(source/scale/ai_fit),是路由决策的关键留痕。
    with runtime_stats.span("classify", {"textLen": len(text or "")}) as _cls_span:
        c = classify.classify(text, filename=filename, project_context=project_context)
        _cls_span.attrs["source"] = c.source
        _cls_span.attrs["scale"] = c.scale
        _cls_span.attrs["aiFit"] = c.ai_fit
    if args.json:
        output.emit({
            "source": c.source,
            "scale": c.scale,
            "ai_fit": c.ai_fit,
            "multi_agent": c.multi_agent,
            "confidence": c.confidence,
            "rationale": c.rationale,
            "next_action": c.next_action,
            "needs_review": c.needs_review,
            "review_reasons": c.review_reasons,
        }, as_json=True)
    else:
        output.info(f"4 维判定结果：")
        output.info(f"  来源（source）:     {c.source}    (置信度 {c.confidence['source']})")
        output.info(f"  规模（scale）:      {c.scale}     (置信度 {c.confidence['scale']})")
        output.info(f"  AI 适配（ai_fit）:  {c.ai_fit}     (置信度 {c.confidence['ai_fit']})")
        output.info(f"  多 Agent:           {'启用' if c.multi_agent else '不启用'}")
        output.info(f"")
        output.info(f"判定理由：")
        for k, v in c.rationale.items():
            output.info(f"  {k}: {v}")
        if c.needs_review:
            output.info(f"")
            output.warn(f"⚠ 低置信度告警：以下维度需人工复核")
            for r in c.review_reasons:
                output.warn(f"  - {r}")
        output.info(f"")
        output.ok(f"建议下一步: {c.next_action}")
    return 0


def cmd_gate_intercept(args, parser):
    """
    PreToolUse hook 入口（v1.4）。

    v1.3 变更：
      - MultiEdit 工具的 file_path 从 tool_input.file_path 读取
      - 快速通道从 .ae-sdd/.quick_channel 文件读取（跨 hook 共享状态）
      - MultiEdit 与 Write/Edit 共享路径感知逻辑

    stdin 格式:
      {"hook_event_name": "PreToolUse", "tool_name": "Write",
       "tool_input": {"file_path": "...", "content": "..."}}

    stdout 格式（允许）: {}
    stdout 格式（拒绝）:
      {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny"},
       "systemMessage": "拒绝原因"}
    exit: 始终 0
    """
    import json as _json

    input_data: dict = {}
    tool_name = args.tool or ""
    bash_command = args.bash_command or None
    file_path = args.file_path or None

    input_data = _read_stdin_json()
    session_key = work_item_context.session_key_from_payload(input_data)
    if input_data:
        tool_name = tool_name or input_data.get("tool_name", "")
        tool_input = input_data.get("tool_input", {})
        # Bash 命令
        if not bash_command and tool_name == "Bash":
            bash_command = tool_input.get("command") or None
        # Write / Edit / MultiEdit 的文件路径
        if not file_path and tool_name in ("Write", "Edit", "MultiEdit"):
            file_path = tool_input.get("file_path") or None

    if not tool_name:
        print(_json.dumps({}))
        return 0

    # 快速通道检测：优先从 .ae-sdd/.quick_channel 文件读（跨 hook 共享）
    # 其次从 --context 参数（手动测试用）
    # 设计原则：文件存在本身即激活信号（UserPromptSubmit 只在检测到标记时才创建文件）
    project_dir_raw = (
        args.project
        or str(input_data.get("cwd") or "")
        or str(input_data.get("project_dir") or "")
        or str(input_data.get("projectDir") or "")
    ).strip()
    project_dir = Path(project_dir_raw) if project_dir_raw else None
    context = args.context or ""
    quick_channel_from_file = False
    if not context:
        # 尝试从持久化文件读快速通道状态
        ade_sdd = paths.locate_project_ae_sdd(project_dir)
        if ade_sdd:
            qc_file = ade_sdd / ".quick_channel"
            if qc_file.is_file():
                # 文件存在 = 快速通道激活（不依赖文件内容包含标记词）
                quick_channel_from_file = True
                try:
                    context = qc_file.read_text(encoding="utf-8").strip()
                except (OSError, IOError, UnicodeError):
                    context = "quick_channel_active"  # 读取失败也认为激活

    if quick_channel_from_file or gate_intercept.is_quick_channel_active(context):
        print(_json.dumps({}))
        return 0

    try:
        # 🆕 2026-07-03 缺口2:gate-intercept 是最高频 hook(日均数百次),此前零 span。
        # span 记录 tool_name/allowed/reason,让"哪些工具调用被拦截、为何"可回溯。
        with runtime_stats.span("gate-intercept",
                                {"toolName": tool_name,
                                 "hasFilePath": bool(file_path),
                                 "quickChannel": quick_channel_from_file}) as _gi_span:
            allowed, reason = gate_intercept.check_intercept(
                tool_name,
                bash_command=bash_command,
                file_path=file_path,
                allow_readonly=not args.no_readonly,
                project_dir=project_dir,
                session_key=session_key,
            )
            _gi_span.attrs["allowed"] = allowed
            _gi_span.attrs["reason"] = reason[:120] if reason else ""
    except Exception:
        # 任何内部异常（state.json 损坏等）→ 放行（不阻断工具调用）
        print(_json.dumps({}))
        return 0

    if allowed:
        print(_json.dumps({}))
        return 0
    else:
        deny = gate_intercept._deny_response(tool_name, reason)
        # Hook stdout is a protocol stream. Keep it ASCII so a parent process
        # decoding with the Windows locale cannot lose the JSON envelope.
        print(_json.dumps(deny, ensure_ascii=True))
        return 0


def cmd_init_hooks(args, parser):
    """
    在 .claude/settings.json 写入三个 hook 配置：
      PreToolUse      → gate-intercept（物理拦截违规工具调用）
      UserPromptSubmit → prompt-inject（自动注入状态到 context）
      Stop            → stop-check（检查响应状态头）

    --use-python : hook command 用绝对路径 python + 脚本路径，不依赖 PATH（Windows 推荐）
    --global     : 写入 ~/.claude/settings.json（用户级），默认写项目级
    """
    import json as _json

    # --global：写用户级配置；否则写项目级
    if getattr(args, "global_hooks", False):
        claude_dir = Path.home() / ".claude"
        settings_path = claude_dir / "settings.json"
    else:
        project_dir = Path(args.project_dir).resolve()
        claude_dir = project_dir / ".claude"
        settings_path = claude_dir / "settings.json"

    # --use-python：生成绝对路径调用，不依赖 PATH（Windows Claude Code hook 推荐）
    if getattr(args, "use_python", False):
        # 优先用安装路径（~/.claude/skills/ae-sdd/tools/bin/ae-sdd）
        # 如果没安装，fallback 到当前 __file__ 路径（仓库开发环境）
        installed_cli = Path.home() / ".claude" / "skills" / "ae-sdd" / "tools" / "bin" / "ae-sdd"
        cli_path = installed_cli if installed_cli.is_file() else Path(__file__).resolve()
        python_exe = sys.executable
        _cmd = lambda sub: f'"{python_exe}" "{cli_path}" {sub}'
    else:
        _cmd = lambda sub: f"ae-sdd {sub}"

    # 三个 hook 定义（v1.3：matcher 加入 MultiEdit）
    pre_tool_entry = {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [{
            "type": "command",
            "command": _cmd("gate-intercept")
        }]
    }
    prompt_inject_entry = {
        "hooks": [{
            "type": "command",
            "command": _cmd("prompt-inject")
        }]
    }
    stop_check_entry = {
        "hooks": [{
            "type": "command",
            "command": _cmd("stop-check")
        }]
    }

    # 读现有配置
    existing: dict = {}
    if settings_path.is_file():
        try:
            existing = _json.loads(settings_path.read_text(encoding="utf-8"))
        except Exception:
            output.warn("settings.json 解析失败，将覆写")

    hooks_cfg: dict = existing.setdefault("hooks", {})

    def _upsert(section: str, entry: dict, matcher_key: Optional[str] = None) -> bool:
        """
        幂等写入 hook，返回 True = 新写入，False = 已存在跳过。

        去重策略（v1.4 修复）：
        - matcher_key 模式：按 matcher 字段精确匹配
        - 否则：按命令中是否含 ae-sdd 子命令关键词精确匹配
          （原来用 startswith cmd[0:2]，--use-python 模式下会误匹配同路径其他 hook）
        --force 时只删除匹配到的 hook，不清空整个 section（避免误删用户自定义 hook）
        """
        lst: list = hooks_cfg.setdefault(section, [])
        # 提取要插入 hook 命令中的子命令标识（如 "prompt-inject"、"stop-check"）
        new_cmd = entry["hooks"][0]["command"]
        if matcher_key:
            def _is_target(h: dict) -> bool:
                return h.get("matcher") == matcher_key
        else:
            # 取命令的最后一个 token 作为子命令标识（如 "prompt-inject"）
            new_subcmd = new_cmd.split()[-1]
            def _is_target(h: dict) -> bool:
                cmd = h.get("hooks", [{}])[0].get("command", "")
                return new_subcmd in cmd.split()

        matching = [h for h in lst if _is_target(h)]
        if matching and not args.force:
            return False
        if matching:
            # 只删除匹配的 hook，保留用户自定义 hook
            lst[:] = [h for h in lst if not _is_target(h)]
        lst.append(entry)
        return True

    # 清理旧版 ae-sdd gate-intercept hook（matcher 可能是旧值，如 "Write|Edit|Bash"）
    pre_hooks_list = hooks_cfg.setdefault("PreToolUse", [])
    pre_hooks_list[:] = [
        h for h in pre_hooks_list
        if not any(
            "gate-intercept" in hook_def.get("command", "")
            for hook_def in h.get("hooks", [])
        )
    ]

    added = []
    if _upsert("PreToolUse", pre_tool_entry, "Write|Edit|MultiEdit|Bash"):
        added.append("PreToolUse → gate-intercept")
    else:
        output.warn("PreToolUse hook 已存在（跳过），加 --force 覆写")

    if _upsert("UserPromptSubmit", prompt_inject_entry):
        added.append("UserPromptSubmit → prompt-inject")
    else:
        output.warn("UserPromptSubmit hook 已存在（跳过），加 --force 覆写")

    if _upsert("Stop", stop_check_entry):
        added.append("Stop → stop-check")
    else:
        output.warn("Stop hook 已存在（跳过），加 --force 覆写")

    if args.dry_run:
        output.info(f"[dry-run] 将写入 {settings_path}:")
        print(_json.dumps(existing, ensure_ascii=False, indent=2))
        return 0

    if not added:
        output.warn("全部 hook 已存在，无变更。加 --force 覆写。")
        return 0

    claude_dir.mkdir(parents=True, exist_ok=True)
    settings_path.write_text(
        _json.dumps(existing, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8"
    )
    output.ok(f"hook 已写入: {settings_path}")
    return 0


def cmd_prompt_inject(args, parser):
    """
    UserPromptSubmit hook 入口（v1.4）。

    stdin 格式:
      {"hook_event_name": "UserPromptSubmit", "user_prompt": "..."}
      或新版 Claude Code:
      {"hook_event_name": "UserPromptSubmit", "prompt": "...", "cwd": "..."}

    stdout 格式:
      {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": "◆ HARNESS STATE ..."}}
      注入到 AI context
      {}  无注入（非 ae-sdd 项目）

    exit: 始终 0
    """
    import json as _json

    input_data: dict = _read_stdin_json()

    user_prompt = (
        input_data.get("user_prompt")
        or input_data.get("prompt")
        or input_data.get("message")
        or input_data.get("text")
        or ""
    )
    if not isinstance(user_prompt, str):
        user_prompt = str(user_prompt)
    session_key = work_item_context.session_key_from_payload(input_data)
    project_dir_raw = (
        args.project
        or str(input_data.get("cwd") or "")
        or str(input_data.get("project_dir") or "")
        or str(input_data.get("projectDir") or "")
    ).strip()
    project_dir = Path(project_dir_raw) if project_dir_raw else None
    # 🆕 2026-07-03 缺口2:prompt-inject 是高频 UserPromptSubmit hook,此前零 span。
    # span 记录是否注入了 ae-sdd 上下文(promptLen/injected),量化 hook 实际作用率。
    try:
        with runtime_stats.span("prompt-inject",
                                {"promptLen": len(user_prompt),
                                 "hasProject": project_dir is not None}) as _pi_span:
            result = prompt_inject.inject(project_dir=project_dir, user_prompt=user_prompt, session_key=session_key)
            _pi_span.attrs["injected"] = bool(result)
    except Exception:
        # 任何异常（state.json 损坏等）→ 放行（不注入），不阻断对话
        result = {}
    print(_json.dumps(result, ensure_ascii=False))
    return 0


def cmd_stop_check(args, parser):
    """
    Stop hook 入口（v1.3）。

    stdin 格式:
      {"hook_event_name": "Stop", "reason": "...", "last_assistant_message": "...", "transcript_path": "/tmp/..."}

    stdout 格式（允许停止）:  {}
    stdout 格式（阻止停止）:
      {"decision": "block", "reason": "..."}

    exit: 始终 0
    """
    import json as _json
    from lib import paths as paths_mod

    input_data: dict = _read_stdin_json()
    session_key = work_item_context.session_key_from_payload(input_data)
    project_dir_raw = (
        args.project
        or str(input_data.get("cwd") or "")
        or str(input_data.get("project_dir") or "")
        or str(input_data.get("projectDir") or "")
        or str(Path.cwd())
    ).strip()
    project_dir = Path(project_dir_raw) if project_dir_raw else None
    ade_sdd = paths_mod.locate_project_ae_sdd(project_dir)

    # Stop is inert outside an explicitly active ae-sdd turn.
    if ade_sdd is None or not work_item_context.is_session_engaged(ade_sdd, session_key):
        print(_json.dumps({}))
        return 0

    # Claude Code v2.1+ Stop 输入直接携带 last_assistant_message。
    # 旧版没有该字段时，再回退到 transcript_path 文件解析。
    transcript_content = str(input_data.get("last_assistant_message") or "")
    transcript_read_failed = False
    transcript_path = input_data.get("transcript_path", "")
    if not transcript_content and transcript_path:
        try:
            transcript_content = Path(transcript_path).read_text(
                encoding="utf-8", errors="replace"
            )
        except (OSError, IOError):
            # transcript 文件读取失败 → 放行（无法检查就不阻断）
            transcript_read_failed = True

    # transcript 读取失败 → 放行
    if transcript_read_failed:
        work_item_context.disengage_session(ade_sdd, session_key)
        print(_json.dumps({}))
        return 0

    try:
        # 🆕 2026-07-03 缺口2:stop-check 是 Stop hook,此前零 span。
        # span 记录是否允许停止(shouldStop),量化"阻止 AI 提前收工"的触发率。
        with runtime_stats.span("stop-check",
                                {"transcriptReadFailed": transcript_read_failed,
                                 "hasAeSdd": ade_sdd is not None}) as _sc_span:
            should_stop, inject_msg = stop_check.check_output(
                transcript_content, ade_sdd=ade_sdd
            )
            _sc_span.attrs["shouldStop"] = should_stop
    except Exception:
        # stop_check 内部异常 → 放行（不阻断对话）
        work_item_context.disengage_session(ade_sdd, session_key)
        print(_json.dumps({}))
        return 0

    if should_stop:
        work_item_context.disengage_session(ade_sdd, session_key)
        print(_json.dumps({}))
    else:
        result = {
            "decision": "block",
            "reason": inject_msg,
        }
        print(_json.dumps(result, ensure_ascii=False))
    return 0  # 始终 exit 0


def _resolve_asset_file(args) -> tuple[Path | None, str, Path | None]:
    """解析资产文件路径 + 缓存路径。

    返回 (asset_path, project_key, cache_path)。
    project_key 优先级：--project 参数 > .ae-sdd/config.yaml > "unknown"。
    asset_path 优先级：--asset-file 直接指定 > .ae-sdd/assets/{key}.assets.md。
    """
    ade_sdd = paths.locate_project_ae_sdd()
    project_key = ""
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey") or ""
    # --project 覆盖（对齐 SKILL.md `ae-sdd assets ... --project <key>` 契约）
    if getattr(args, "project", "") and args.project:
        project_key = args.project
    if not project_key:
        project_key = "unknown"

    # --asset-file 直接指定资产文件
    asset_file = getattr(args, "asset_file", None)
    if asset_file:
        asset_path = Path(asset_file)
    elif ade_sdd:
        asset_path = paths.find_asset_file(ade_sdd, project_key)
    else:
        asset_path = None

    cache_path = None
    if ade_sdd and asset_path:
        cache_path = paths.assets_dir(ade_sdd) / f"{project_key}.index.json"
    return asset_path, project_key, cache_path


def _resolve_all_asset_files(args) -> tuple[list, str, Path | None]:
    """🆕 v4.0：解析全部资产文件（总览 + 工程级子文件）+ 缓存路径。

    返回 (asset_paths, project_key, cache_path)。
    - asset_paths: [Path, ...]，总览在前、子文件在后（空列表 = 无资产）
    - --asset-file 指定时仅返回该单文件（用户显式指定优先）
    - 否则用 paths.find_module_asset_files 自动发现总览+子文件
    """
    ade_sdd = paths.locate_project_ae_sdd()
    project_key = ""
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey") or ""
    if getattr(args, "project", "") and args.project:
        project_key = args.project
    if not project_key:
        project_key = "unknown"

    # --asset-file 直接指定（单文件模式，向后兼容）
    asset_file = getattr(args, "asset_file", None)
    if asset_file:
        return [Path(asset_file)], project_key, None

    # 自动发现总览 + 工程级子文件
    if ade_sdd:
        all_paths = paths.find_module_asset_files(ade_sdd, project_key)
        cache_path = paths.assets_dir(ade_sdd) / f"{project_key}.index.json"
        return all_paths, project_key, cache_path
    return [], project_key, None


def _build_index(args):
    """解析资产文件并构建索引（带缓存）。

    🆕 v4.0：优先用多文件模式（总览+工程级子文件合并索引），
    退化为单文件当只有总览时。资产不存在时返回 (None, key, cache)。
    """
    # 优先尝试多文件模式
    all_paths, project_key, cache_path = _resolve_all_asset_files(args)
    if all_paths:
        existing = [p for p in all_paths if p.is_file()]
        if existing:
            idx = assets_index.AssetsIndex.build_from_files(existing, cache_path=cache_path)
            return idx, project_key, cache_path
    # 退化：单文件（--asset-file 或无子文件的旧路径）
    asset_path, project_key, cache_path = _resolve_asset_file(args)
    if asset_path is None or not asset_path.is_file():
        return None, project_key, cache_path
    idx = assets_index.AssetsIndex.build_from_file(asset_path, cache_path=cache_path)
    return idx, project_key, cache_path


def _resolve_assets_workspace(args) -> tuple[Path | None, str]:
    """Resolve .ae-sdd and projectKey for assets maintenance commands."""
    project_dir_arg = getattr(args, "project_dir", "") or ""
    ade_sdd = None
    if project_dir_arg:
        candidate = Path(project_dir_arg).expanduser().resolve()
        if candidate.name == ".ae-sdd" and paths.config_path(candidate).is_file():
            ade_sdd = candidate
        else:
            ade_sdd = paths.locate_project_ae_sdd(candidate)
    else:
        ade_sdd = paths.locate_project_ae_sdd()

    project_key = ""
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey") or cfg.get("workspaceKey") or ""
    if getattr(args, "project", ""):
        project_key = args.project
    return ade_sdd, project_key


def cmd_assets_generate(args, parser):
    """assets generate — create or repair the project asset baseline."""
    ade_sdd, project_key = _resolve_assets_workspace(args)
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/config.yaml，请先运行 ae-sdd init <project-dir> <projectKey>")
        return 1
    if not project_key:
        output.err("未提供 projectKey，且 .ae-sdd/config.yaml 无 projectKey/workspaceKey")
        return 1

    source_asset = None
    if getattr(args, "asset_file", ""):
        source_asset = Path(args.asset_file).expanduser()
        if not source_asset.is_file():
            output.err(f"--asset-file 不存在: {source_asset}")
            return 1

    result = project_assets.generate_project_assets(
        ade_sdd,
        project_key,
        project_root=paths.project_root(ade_sdd),
        force=bool(getattr(args, "force", False)),
        source_asset=source_asset,
    )

    if args.json:
        output.emit(result.to_dict(), as_json=True)
    else:
        if result.changed:
            output.ok(f"项目资产已生成: {result.asset_file}")
        else:
            output.ok(f"项目资产已存在且完整: {result.asset_file}")
        if result.backup_file:
            output.info(f"备份: {result.backup_file}")
        if result.missing_after:
            output.err(f"仍缺索引层: {', '.join(result.missing_after)}")

    return 0 if result.pass_ else 1


def cmd_assets_check(args, parser):
    """assets check — verify project asset existence and G-00 sections."""
    ade_sdd, project_key = _resolve_assets_workspace(args)
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/config.yaml，请先运行 ae-sdd init <project-dir> <projectKey>")
        return 1
    if not project_key:
        output.err("未提供 projectKey，且 .ae-sdd/config.yaml 无 projectKey/workspaceKey")
        return 1

    result = project_assets.check_asset(ade_sdd, project_key)
    if args.json:
        output.emit(result, as_json=True)
    elif result["pass"]:
        output.ok(f"项目资产完整: {result['assetFile']}")
    else:
        output.err(
            f"项目资产未就绪: {result['assetFile']} "
            f"(missing={result['missingSections']}, exists={result['exists']})"
        )
    return 0 if result["pass"] else 1


def cmd_assets_query(args, parser):
    """assets query — 给 key，返回倒排索引命中的 top-N 结果（BM25 排序）

    把 project-assets-update-skill §G 的 assets.search() 自然语言协议
    变成可执行命令：输入关键词 → 分词 → 倒排索引 → BM25 评分 → top-N。
    """
    idx, project_key, _ = _build_index(args)
    if idx is None:
        output.err(f"项目资产不存在（projectKey={project_key}）。"
                   f"先用 `ae-sdd assets generate` 或 project-assets-update-skill §3 生成。")
        return 1

    query = args.query
    top_n = args.top
    hits = idx.search(query, top_n=top_n)
    data = {
        "projectKey": project_key,
        "query": query,
        "top_n": top_n,
        "n_hits": len(hits),
        "hits": assets_index.hits_to_jsonable(hits),
    }
    if args.json:
        output.emit(data, as_json=True)
    else:
        output.info(f"查询「{query}」→ {len(hits)} 命中（top {top_n}，BM25 降序）")
        for i, h in enumerate(hits, 1):
            output.info(f"  {i}. [{h.section} L{h.line}] score={h.score} "
                        f"matched={','.join(h.matched_tokens)}")
            output.info(f"     {h.snippet[:120]}")
    return 0


def cmd_assets_outline(args, parser):
    """assets outline — 资产大纲（§A 总览：章节列表 + 索引统计）"""
    idx, project_key, _ = _build_index(args)
    if idx is None:
        output.err(f"项目资产不存在（projectKey={project_key}）。")
        return 1
    stats = idx.stats()
    data = {"projectKey": project_key, "stats": stats}
    if args.json:
        output.emit(data, as_json=True)
    else:
        output.info(f"项目资产大纲（projectKey={project_key}）")
        output.info(f"  文档单元数: {stats['n_docs']}")
        output.info(f"  索引 token 数: {stats['n_tokens']}")
        output.info(f"  章节数: {stats['n_sections']}")
        output.info(f"  章节列表:")
        for sec in stats["sections"]:
            output.info(f"    {sec}")
    return 0


def cmd_assets_section(args, parser):
    """assets section — 取整章原文（替代 assets.sections 协议）"""
    idx, project_key, _ = _build_index(args)
    if idx is None:
        output.err(f"项目资产不存在（projectKey={project_key}）。")
        return 1
    sec_text = idx.section(args.name)
    if sec_text is None:
        output.err(f"未找到章节：{args.name}")
        return 1
    if args.json:
        output.emit({"projectKey": project_key, "section": args.name, "content": sec_text}, as_json=True)
    else:
        print(sec_text)
    return 0


def cmd_assets_stats(args, parser):
    """assets stats — 索引统计（token 数 / doc 数 / 覆盖章节 / 缓存状态）"""
    idx, project_key, cache_path = _build_index(args)
    if idx is None:
        output.err(f"项目资产不存在（projectKey={project_key}）。")
        return 1
    stats = idx.stats()
    cache_status = "hit" if (cache_path and cache_path.is_file()) else "miss"
    data = {**stats, "projectKey": project_key, "cache": str(cache_path) if cache_path else None,
            "cache_status": cache_status}
    if args.json:
        output.emit(data, as_json=True)
    else:
        output.info(f"索引统计（projectKey={project_key}，cache={cache_status}）")
        output.info(f"  文档单元数: {stats['n_docs']}")
        output.info(f"  索引 token 数: {stats['n_tokens']}")
        output.info(f"  平均文档长度: {stats['avg_doc_len']}")
        output.info(f"  章节数: {stats['n_sections']}")
        if cache_path:
            output.info(f"  缓存: {cache_path} ({cache_status})")
    return 0


def cmd_assets_read(args, parser):
    """assets read — 资产 SKILL 的核心入口（对标 §G 场景化 API 真实实现）

    流程（用户设计）：
      1. 检查索引是否就绪（没就绪则 build，含 mtime 缓存）
      2. 通过 STAGE_KEY_MAP 把阶段意图 → 一组固定 KEY
      3. 跑脚本取每个 KEY 的简约 v（section/line/snippet/score）
      4. 同时跑 LLM 追加的 --keys（精准查）
      5. 取 STAGE_SECTION_MAP 要求的整章原文
      6. 返回 ReadResult

    这是 LLM 经资产 SKILL 读资产的统一入口：LLM 只说阶段 + 可选追加 KEY，
    脚本返回简约定位信息（行号），LLM 拿到后按需精读。
    """
    stage = args.stage
    valid_stages = list(assets_index.STAGE_KEY_MAP.keys())
    if stage not in valid_stages:
        output.err(f"未知阶段：{stage}（允许：{valid_stages}）")
        return 1

    idx, project_key, cache_path = _build_index(args)
    if idx is None:
        output.err(f"项目资产不存在（projectKey={project_key}）。"
                   f"先用 `ae-sdd assets generate` 或 project-assets-update-skill §3 生成。")
        return 1

    # 缓存状态：判断本次是否新建索引
    cache_status = "hit" if (cache_path and cache_path.is_file()
                             and cache_path.stat().st_mtime >= 0) else "miss"
    index_ready = cache_status == "hit"

    extra_keys = args.keys.split(",") if args.keys else []
    extra_keys = [k.strip() for k in extra_keys if k.strip()]

    result = assets_index.read_assets(
        idx, stage=stage, extra_keys=extra_keys, project_key=project_key,
    )
    data = assets_index.read_result_to_jsonable(result)
    data["index_ready"] = index_ready  # 标注本次是否复用缓存

    if args.json:
        output.emit(data, as_json=True)
    else:
        output.info(f"资产读取（stage={stage}, projectKey={project_key}, "
                    f"index={'缓存命中' if index_ready else '本次新建'}）")
        if result.baseline_hits:
            output.info(f"  基线命中（固定 KEY × {len(result.baseline_hits)}）:")
            for key, hits in result.baseline_hits.items():
                output.info(f"    [{key}] → {len(hits)} 命中:")
                for h in hits[:3]:
                    output.info(f"      {h['section']} L{h['line']} score={h['score']}: {h['snippet'][:80]}")
        if result.extra_hits:
            output.info(f"  精准命中（自定义 KEY × {len(result.extra_hits)}）:")
            for key, hits in result.extra_hits.items():
                output.info(f"    [{key}] → {len(hits)} 命中:")
                for h in hits[:3]:
                    output.info(f"      {h['section']} L{h['line']} score={h['score']}: {h['snippet'][:80]}")
        if result.sections:
            output.info(f"  整章原文（{len(result.sections)} 章）:")
            for name, text in result.sections.items():
                output.info(f"    {name}（{len(text)} 字符）")
        if not result.baseline_hits and not result.extra_hits:
            output.info("  无命中（资产可能为空或 KEY 未匹配）")
    return 0


def _perf_project_arg(args) -> Optional[Path]:
    project = getattr(args, "project", "") or ""
    return Path(project).expanduser() if project else None


def _fmt_ms(value) -> str:
    try:
        ms = float(value or 0.0)
    except (TypeError, ValueError):
        ms = 0.0
    if ms >= 1000:
        return f"{ms / 1000:.2f}s"
    return f"{ms:.1f}ms"


def cmd_perf_report(args, parser):
    """Report recent ae-sdd runtime statistics."""
    project = _perf_project_arg(args)
    events = runtime_stats.read_events(limit=max(int(args.last), 0), project=project)
    summary = runtime_stats.summarize_events(events, slow_limit=max(int(args.limit), 1))
    payload = {
        "statsDir": str(runtime_stats.stats_dir(project)),
        "last": args.last,
        "summary": summary,
    }
    if args.json:
        output.emit(payload, as_json=True)
        return 0

    output.info(f"runtime stats: {len(events)} events from {payload['statsDir']}")
    duration = summary["duration"]
    output.info(
        "duration: "
        f"avg={_fmt_ms(duration['avgMs'])} "
        f"p50={_fmt_ms(duration['p50Ms'])} "
        f"p95={_fmt_ms(duration['p95Ms'])} "
        f"max={_fmt_ms(duration['maxMs'])}"
    )
    # 🆕 2026-07-03 缺口3:补 cpu/ioWait 摘要,区分 CPU 瓶颈与 I/O 等待。
    cpu = summary.get("cpuMs") or {}
    io_wait = summary.get("ioWaitMs") or {}
    output.info(
        "cpu: "
        f"avg={_fmt_ms(cpu.get('avgMs'))} "
        f"p95={_fmt_ms(cpu.get('p95Ms'))} "
        f"max={_fmt_ms(cpu.get('maxMs'))}  "
        "| ioWait: "
        f"avg={_fmt_ms(io_wait.get('avgMs'))} "
        f"p95={_fmt_ms(io_wait.get('p95Ms'))} "
        f"max={_fmt_ms(io_wait.get('maxMs'))}"
    )
    # 🆕 2026-07-03 缺口1:bootstrap import 固定成本(仅含已打戳事件)。
    bootstrap = summary.get("bootstrapMs") or {}
    if int(bootstrap.get("count") or 0) > 0:
        output.info(
            f"bootstrap(import): count={bootstrap['count']} "
            f"avg={_fmt_ms(bootstrap.get('avgMs'))} "
            f"p95={_fmt_ms(bootstrap.get('p95Ms'))} "
            f"max={_fmt_ms(bootstrap.get('maxMs'))}"
        )
    if summary["commands"]:
        output.info("commands by total time:")
        for item in summary["commands"][:args.limit]:
            output.info(
                f"  {item['command']}: count={item['count']} "
                f"avg={_fmt_ms(item['avgMs'])} max={_fmt_ms(item['maxMs'])} "
                f"total={_fmt_ms(item['totalMs'])}"
            )
    if summary["slowestSpans"]:
        output.info("slowest spans:")
        for item in summary["slowestSpans"][:args.limit]:
            attrs = item.get("attrs") or {}
            label = attrs.get("gateId") or attrs.get("cmd") or item.get("name")
            output.info(
                f"  {item.get('name')} {label}: {_fmt_ms(item.get('durationMs'))} "
                f"({item.get('command')})"
            )
    # 🆕 2026-07-03(B3): 按 scale 分桶展示
    by_scale = summary.get("byScale") or []
    if by_scale:
        output.info("by scale (avg duration):")
        for item in by_scale[:args.limit]:
            output.info(
                f"  {item['scale']}: count={item['count']} "
                f"avg={_fmt_ms(item['avgMs'])} max={_fmt_ms(item['maxMs'])} "
                f"total={_fmt_ms(item['totalMs'])}"
            )
    scale_ratios = summary.get("scaleRatios") or {}
    if scale_ratios:
        ratio_str = ", ".join(f"{k}={v:.2f}" for k, v in scale_ratios.items())
        output.info(f"scale ratios (avg vs 大): {ratio_str}")
    return 0


def _perf_advice(summary: dict) -> list[str]:
    advice: list[str] = []
    if summary.get("count", 0) == 0:
        return ["暂无统计数据：先运行 ae-sdd gates check / update-check / health 等命令后再查看。"]

    slow_spans = summary.get("slowestSpans") or []
    if slow_spans:
        top = slow_spans[0]
        name = top.get("name", "span")
        duration = float(top.get("durationMs") or 0.0)
        attrs = top.get("attrs") or {}
        label = attrs.get("gateId") or attrs.get("cmd") or name
        # 🆕 2026-07-03 缺口5:gate span 包裹其内嵌 scanner span,二者同耗时会重复出现。
        # doctor 文案标注"含子扫描器",避免误报为两个独立慢点。
        scanner_spans = [s for s in slow_spans if str(s.get("name", "")).startswith("scanner:")]
        nested_hint = ""
        if str(name) == "gate" and scanner_spans:
            nested = scanner_spans[0]
            nested_name = str(nested.get("name", ""))
            nested_attrs = nested.get("attrs") or {}
            scan_root = nested_attrs.get("scanRoot") or nested_attrs.get("cwd") or ""
            root_hint = f" scanRoot={scan_root}" if scan_root else ""
            nested_hint = f"（含子扫描器 {nested_name}{root_hint}）"
        advice.append(f"当前最慢 span 是 {name} {label}{nested_hint}，耗时 {_fmt_ms(duration)}。")
        if scanner_spans:
            advice.append("扫描器 span 位于慢路径中；优先检查扫描范围、文件枚举和可缓存输入。")

    command_items = summary.get("commands") or []
    gates_item = next((item for item in command_items if item.get("command") == "gates check"), None)
    if gates_item and float(gates_item.get("avgMs") or 0.0) > 1000:
        advice.append("gates check 平均耗时超过 1 秒；优先看 slowest spans 中的 gate/scanner。")

    # 🆕 2026-07-03(B3): 比例失调诊断 —— 微任务开销不应接近或超过大任务。
    # 微任务走 8-phase 子链、大任务走 14-phase，正常应显著更轻。
    scale_ratios = summary.get("scaleRatios") or {}
    micro_ratio = scale_ratios.get("微/大")
    if micro_ratio is not None and micro_ratio >= 0.8:
        advice.append(
            f"微任务平均开销 / 大任务平均开销 = {micro_ratio:.2f}，比例偏高（≥0.8）。"
            "微任务应显著轻于大任务；若比值接近 1，检查是否微任务误判走大链，"
            "或编码段（CodingPlan/确认/CodeReview）未随规模瘦身。"
        )

    # 🆕 2026-07-03 缺口4:bootstrap 诊断改用真实 bootstrapMs(此前用业务 avgMs 误判)。
    # 旧逻辑"avgMs>150ms 含 import 成本"基于失真数据——import 不在 durationMs 内,
    # 高频 hook 把 avg 拉到 <1ms,导致该诊断在 hook 重度项目里永远不触发。
    bootstrap = summary.get("bootstrapMs") or {}
    boot_count = int(bootstrap.get("count") or 0)
    boot_p95 = float(bootstrap.get("p95Ms") or 0.0)
    if boot_count > 0 and boot_p95 > 150:
        boot_avg = float(bootstrap.get("avgMs") or 0.0)
        advice.append(
            f"CLI 顶层 import 固定成本 p95={_fmt_ms(boot_p95)}（avg={_fmt_ms(boot_avg)}，"
            f"基于 {boot_count} 个已打戳事件）。>150ms 建议实施 P1 lazy import fast path，"
            "将 version/scripts-dir/health 等轻量命令的业务模块改为按需加载。详见 "
            "source/docs/plans/2026-07-02-runtime-stats-performance-plan.md P1。"
        )

    # 🆕 2026-07-03 缺口3:ioWait 诊断——区分"CPU 慢"与"等子进程 I/O 慢"。
    # ioWait = duration − cpu;占比高说明瓶颈在 subprocess 调用,应优先改进程内调用(plan P1)。
    io_wait = summary.get("ioWaitMs") or {}
    io_avg = float(io_wait.get("avgMs") or 0.0)
    duration_avg = float((summary.get("duration") or {}).get("avgMs") or 0.0)
    if duration_avg > 0 and io_avg > 500 and (io_avg / duration_avg) > 0.7:
        advice.append(
            f"I/O 等待占比偏高（ioWait avg={_fmt_ms(io_avg)}，占总耗时 "
            f"{io_avg / duration_avg * 100:.0f}%）。瓶颈在等待子进程(subprocess)，"
            "优先把 G-CODE-1/G-09/G-RA-4~6 的扫描器改为进程内调用，避免重复 Python 启动。"
        )

    if not advice:
        advice.append("未发现明显慢点；继续积累更多事件后再看 p95 与 slowest spans。")
    return advice


def cmd_perf_doctor(args, parser):
    """Diagnose obvious runtime bottlenecks from recent statistics."""
    project = _perf_project_arg(args)
    events = runtime_stats.read_events(limit=max(int(args.last), 0), project=project)
    summary = runtime_stats.summarize_events(events, slow_limit=max(int(args.limit), 1))
    advice = _perf_advice(summary)
    payload = {
        "statsDir": str(runtime_stats.stats_dir(project)),
        "last": args.last,
        "summary": summary,
        "advice": advice,
    }
    if args.json:
        output.emit(payload, as_json=True)
        return 0

    output.info(f"runtime doctor: {len(events)} events from {payload['statsDir']}")
    for item in advice:
        output.info(f"  - {item}")
    return 0


def cmd_perf_clear(args, parser):
    """Clear runtime statistics for the selected project."""
    project = _perf_project_arg(args)
    count = runtime_stats.clear_events(project=project)
    runtime_stats.suppress_current_event()
    payload = {"statsDir": str(runtime_stats.stats_dir(project)), "deletedFiles": count}
    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.info(f"cleared runtime stats: {count} files from {payload['statsDir']}")
    return 0


# ─── 🆕 2026-07-03 distributor 子命令组（注册表模式） ─────────────────────────
def cmd_distributor_list(args, parser):
    """列出已注册的分发器。"""
    from lib import distributor_registry as dr
    entries = dr.load_registry()
    if args.json:
        output.emit({"distributors": [e.to_dict() for e in entries]}, as_json=True)
        return 0
    if not entries:
        output.info("（注册表为空）")
        return 0
    output.info(f"注册表：{len(entries)} 个分发器（{dr.registry_path()}）")
    for e in entries:
        status = "✅启用" if e.enabled else "⛔禁用"
        detect_desc = e.detect
        if e.detect == "cli_exists" and e.detect_cli:
            detect_desc = f"cli_exists({e.detect_cli})"
        output.info(
            f"  {e.name:10s} {e.protocol:14s} {status}  detect={detect_desc:20s} "
            f"→ {e.target_path}"
        )
    return 0


def cmd_distributor_register(args, parser):
    """注册新分发器。"""
    from lib import distributor_registry as dr
    ok, msg, entries = dr.register_one(
        name=args.name,
        protocol=args.protocol,
        target_path=args.target_path,
        detect=args.detect,
        detect_cli=args.detect_cli,
        enabled=not args.disable,
        notes=args.notes or "",
        force=args.force,
    )
    if args.json:
        output.emit({"ok": ok, "message": msg,
                     "distributors": [e.to_dict() for e in entries]}, as_json=True)
        return 0 if ok else 1
    if ok:
        output.info(msg)
    else:
        output.err(msg)
    return 0 if ok else 1


def cmd_distributor_unregister(args, parser):
    """注销分发器（从注册表删除）。"""
    from lib import distributor_registry as dr
    ok, msg, entries = dr.unregister_one(args.name)
    if args.json:
        output.emit({"ok": ok, "message": msg,
                     "distributors": [e.to_dict() for e in entries]}, as_json=True)
        return 0 if ok else 1
    if ok:
        output.info(msg)
    else:
        output.err(msg)
    return 0 if ok else 1


def cmd_distributor_enable(args, parser):
    """启用分发器。"""
    from lib import distributor_registry as dr
    ok, msg, entries = dr.set_enabled(args.name, True)
    if args.json:
        output.emit({"ok": ok, "message": msg}, as_json=True)
        return 0
    if ok:
        output.info(msg)
    else:
        output.err(msg)
    return 0 if ok else 1


def cmd_distributor_disable(args, parser):
    """禁用分发器（软注销）。"""
    from lib import distributor_registry as dr
    ok, msg, entries = dr.set_enabled(args.name, False)
    if args.json:
        output.emit({"ok": ok, "message": msg}, as_json=True)
        return 0
    if ok:
        output.info(msg)
    else:
        output.err(msg)
    return 0 if ok else 1


def cmd_distributor_scan(args, parser):
    """扫描已安装的 Agent，建议可注册的分发器。"""
    from lib import distributor_registry as dr
    found = dr.scan_for_agents() if args.all_agents else dr.scan_unregistered()
    if args.register:
        registered = 0
        for item in found:
            ok, _, _ = dr.register_one(
                name=item["name"], protocol=item["protocol"],
                target_path=item["target_path"], detect=item["detect"],
                detect_cli=item.get("detect_cli"),
                notes=item.get("notes", ""), force=True,
            )
            if ok:
                registered += 1
        msg = f"扫描到 {len(found)} 个，自动注册 {registered} 个"
        if args.json:
            output.emit({"found": found, "registered": registered, "message": msg}, as_json=True)
        else:
            output.info(msg)
        return 0
    if args.json:
        output.emit({"found": found}, as_json=True)
        return 0
    if not found:
        output.info("未扫描到可注册的 Agent（用 --all-agents 查看全部已知）")
        return 0
    output.info(f"扫描到 {len(found)} 个 Agent：")
    for item in found:
        output.info(
            f"  {item['name']:10s} {item['protocol']:14s} → {item['target_path']}"
        )
    output.info("用 ae-sdd distributor register <name> --protocol ... 注册，或加 --register 自动注册")
    return 0


def cmd_health(args, parser):
    """健康度自检（v1 最小实现）"""
    master = paths.locate_master_source()
    ade_sdd = paths.locate_project_ae_sdd()

    items = []

    # 1. 母版 source/ 存在
    items.append({
        "name": "母版 source/ 存在",
        "pass": master is not None,
        "message": str(master) if master else "未找到（设环境变量 AE_SDD_MASTER）",
    })

    # 2. .ae-sdd/ 存在
    items.append({
        "name": "项目 .ae-sdd/ 存在",
        "pass": ade_sdd is not None,
        "message": str(ade_sdd) if ade_sdd else "未在当前目录或上级找到 .ae-sdd/config.yaml",
    })

    # 3. state.json 可定位（镜像或源任一即可，🆕 v3.9.7 fallback：镜像可缺）
    state_ok = False
    state_msg = "（无 .ae-sdd/）"
    if ade_sdd:
        sp = None
        if False:
            try:
                json.loads(sp.read_text(encoding="utf-8"))
                state_ok = True
                state_msg = f"可读 ({sp.stat().st_size} 字节)"
            except Exception as e:
                state_msg = f"JSON 解析失败: {e}"
        else:
            # 🆕 v3.9.7 fallback：镜像缺失 → 接受 work-item state.json 源作为可定位证据
            from lib import paths as _paths
            auto_root = _paths.project_root(ade_sdd) / ".auto-engineering"
            if auto_root.is_dir():
                candidates = []
                for child in auto_root.iterdir():
                    if child.is_dir() and (child / "state.json").is_file():
                        candidates.append(child / "state.json")
                if candidates:
                    state_ok = True
                    state_msg = (
                        f"work-item state source found "
                        f"({len(candidates)} 个：{', '.join(c.name for c in candidates[:3])}"
                        f"{'...' if len(candidates) > 3 else ''})"
                    )
                else:
                    state_msg = f".auto-engineering/ has no work-item state.json"
            else:
                state_msg = ".auto-engineering/ does not exist"
    items.append({
        "name": "work-item state.json 可定位",
        "pass": state_ok,
        "message": state_msg,
    })

    # 4. master SKILL.md 可读
    skill_ok = False
    skill_msg = "（无母版）"
    if master:
        sm = master / "SKILL.md"
        if sm.is_file():
            skill_ok = True
            skill_msg = f"可读 ({sm.stat().st_size} 字节, version {paths.MASTER_VERSION})"
        else:
            skill_msg = f"不存在: {sm}"
    items.append({
        "name": "master SKILL.md 可读",
        "pass": skill_ok,
        "message": skill_msg,
    })

    # 5. tools/lib/ 模块可 import
    items.append({
        "name": "tools/lib/ 模块可 import",
        "pass": True,
        "message": f"classify / gates / output / paths / state ({sys.version.split()[0]})",
    })

    # 6. G-00 门禁
    project_key = "unknown"
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey", "unknown")
    g00 = gates.check_g00(master, ade_sdd, project_key)
    items.append({
        "name": "G-00 项目资产门禁",
        "pass": g00.pass_,
        "message": g00.message,
    })

    # 7. G-RA 扫描器可用性（v3.2 — ra_authenticity_scan.py 是否可定位）
    ra_scanner = gates._locate_ra_scanner(master) if master else None
    items.append({
        "name": "G-RA 真实性扫描器",
        "pass": ra_scanner is not None,
        "message": f"ra_authenticity_scan.py 可定位：{ra_scanner}" if ra_scanner
                   else "未定位到 ra_authenticity_scan.py（纯安装环境将 stub 跳过 G-RA-4）",
    })

    # 8. G-CODE 扫描器可用性（v3.2.1 — coding_authenticity_scan.py 是否可定位）
    coding_scanner = gates._locate_coding_scanner(master) if master else None
    items.append({
        "name": "G-CODE Coding 真实性扫描器",
        "pass": coding_scanner is not None,
        "message": f"coding_authenticity_scan.py 可定位：{coding_scanner}" if coding_scanner
                   else "未定位到 coding_authenticity_scan.py（纯安装环境将 stub 跳过 G-CODE-1）",
    })

    # 9. 🆕 v3.4.0：master-freshness（母版 vs 已安装 SKILL vs 业务仓 config.yaml）
    # 探测三个版本是否一致，输出漂移报告 + 修复建议
    installed_version = paths.MASTER_VERSION  # 当前 CLI 自身 version = 已装 SKILL version
    master_version = _read_master_skill_version(master)
    project_master_version = _read_project_config_master_version(ade_sdd)

    freshness_msgs = []
    freshness_ok = True
    if master_version and installed_version != master_version:
        freshness_msgs.append(f"CLI {installed_version} ≠ source/SKILL.md {master_version}")
        freshness_ok = False
    if project_master_version and installed_version != project_master_version:
        freshness_msgs.append(f"CLI {installed_version} ≠ .ae-sdd/config.yaml master.version {project_master_version}")
        freshness_ok = False
    # 探测 post-commit hook 是否安装（v3.4.0 闭环必备）
    post_commit_hook = _check_post_commit_hook(master)
    if not post_commit_hook["installed"]:
        freshness_msgs.append(f"post-commit hook 未装: {post_commit_hook['detail']}")
        # 不阻断，仅 warn
    freshness_msg = "；".join(freshness_msgs) if freshness_msgs else f"全部一致 (master={master_version or installed_version}, project={project_master_version or 'N/A'}, hook={'✅' if post_commit_hook['installed'] else '❌'})"
    items.append({
        "name": "master-freshness（v3.4.0 分发闭环）",
        "pass": freshness_ok and post_commit_hook["installed"],
        "message": freshness_msg,
    })

    # 10. 🆕 v3.8.1 S-4：规则-工具同步状态（检测同版本内规则-代码漂移）
    # item 9 只比版本号字符串，本项比 update-graph.json 各 UG 规则 trigger/affected 文件的
    # sha256，能发现"同版本内 SKILL.md 声明了 gate 但 gates.py 未实装"这类漂移。
    # manifest 缺失 → warn 不 fail（旧环境兼容）；漂移 → warn 不 fail（与 item 9 同级）。
    sync_msg = "（无母版）"
    sync_ok = True
    if master:
        repo_root_for_manifest = master.parent  # master = source/ → 父目录是仓库根
        try:
            drift = update_graph.check_sync_drift(repo_root_for_manifest)
            if not drift["manifest_exists"]:
                sync_ok = True  # manifest 缺失视作 pass（旧环境，未跑 build_dist）
                sync_msg = "manifest 不存在（建议跑 build_dist.py 生成；旧环境跳过）"
            elif drift["drift_count"] == 0:
                sync_ok = True
                sync_msg = (f"全部一致（{drift['total_rules']} 条 UG 规则，"
                            f"manifest 生成于 {drift['generatedAt']}）")
            else:
                sync_ok = False  # 漂移 → warn（但不计入 failed 阻断退出码，见下方 summary 处理）
                drifted_ids = [r["id"] for r in drift["drifted_rules"][:5]]
                sync_msg = (f"{drift['drift_count']}/{drift['total_rules']} 条规则漂移："
                            f"{drifted_ids}…（跑 build_dist.py 重新生成 manifest）")
        except Exception as e:
            sync_ok = True
            sync_msg = f"检测异常（兜底放行）：{e}"
    items.append({
        "name": "规则-工具同步状态（v3.8.1 S-4）",
        "pass": sync_ok,
        "message": sync_msg,
        "warn_only": not sync_ok,  # 漂移仅 warn，不计入 failed 退出码
    })

    summary = {
        "total": len(items),
        "passed": sum(1 for i in items if i["pass"]),
        "failed": sum(1 for i in items if not i["pass"] and not i.get("warn_only")),
        "warned": sum(1 for i in items if not i["pass"] and i.get("warn_only")),
        "items": items,
    }
    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"健康度自检 ({summary['passed']}/{summary['total']} 通过"
                    + (f"，{summary['warned']} warn" if summary.get("warned") else "")
                    + ")：")
        for i in items:
            if i["pass"]:
                mark = "✅"
            elif i.get("warn_only"):
                mark = "⚠️"
            else:
                mark = "❌"
            output.info(f"  {mark} {i['name']}: {i['message']}")
    # 漂移(warn_only)不计入失败退出码，与 item 9 版本不一致同为 warn 级
    return 0 if summary["failed"] == 0 else 1


# ─── master-freshness 辅助函数（🆕 v3.4.0） ──────────────────────────────────
import re as _re_fresh

def _read_master_skill_version(master: Optional[Path]) -> Optional[str]:
    """读母版 source/SKILL.md frontmatter 的 version 字段"""
    if not master:
        return None
    sm = master / "SKILL.md"
    if not sm.is_file():
        return None
    try:
        text = sm.read_text(encoding="utf-8")
        m = _re_fresh.search(r"^---\s*\n.*?^version:\s*([\d.]+)", text, _re_fresh.MULTILINE | _re_fresh.DOTALL)
        if m:
            return m.group(1)
    except OSError:
        pass
    return None


def _read_project_config_master_version(ade_sdd: Optional[Path]) -> Optional[str]:
    """读业务仓 .ae-sdd/config.yaml 的 master.version 字段"""
    if not ade_sdd:
        return None
    cfg = ade_sdd / "config.yaml"
    if not cfg.is_file():
        return None
    try:
        text = cfg.read_text(encoding="utf-8")
        m = _re_fresh.search(
            r"master:\s*\n(?:\s+\S+:\s*\S+\s*\n)*\s+version:\s*\"?([\d.]+)\"?",
            text,
        )
        if m:
            return m.group(1)
    except OSError:
        pass
    return None


def _check_post_commit_hook(master: Optional[Path]) -> dict:
    """检查 ae-sdd 母版仓库 .githooks/post-commit 是否安装 + 可执行 + git hooksPath 指向它"""
    if not master:
        return {"installed": False, "detail": "无母版路径"}
    repo_root = master.parent  # master = source/ 的话，父目录是仓库根
    githooks_post_commit = repo_root / ".githooks" / "post-commit"
    git_hooks_post_commit = repo_root / ".git" / "hooks" / "post-commit"
    if not githooks_post_commit.is_file():
        return {"installed": False, "detail": ".githooks/post-commit 不存在"}
    # 检查 git core.hooksPath
    try:
        r = runtime_exec.run_command(
            ["git", "config", "--get", "core.hooksPath"],
            cwd=str(repo_root), capture_output=True, text=True, timeout=5,
            span_name="subprocess:git_config_hooks_path",
        )
        hooks_path = r.stdout.strip() if r.returncode == 0 else ""
        if hooks_path != ".githooks":
            return {"installed": False, "detail": f"git core.hooksPath={hooks_path or '(默认 .git/hooks)'}，未指向 .githooks"}
    except Exception:
        return {"installed": False, "detail": "无法读取 git config（git 命令失败）"}
    # 检查可执行（用 os.access 跨平台，Windows 上 st_mode 可能不反映）
    import os as _os_fresh
    if not _os_fresh.access(str(githooks_post_commit), _os_fresh.X_OK):
        return {"installed": False, "detail": ".githooks/post-commit 不可执行（chmod +x）"}
    return {"installed": True, "detail": ".githooks/post-commit 已装 + hooksPath 正确"}


def _runtime_command_name(args) -> str:
    parts = [getattr(args, "command", "") or ""]
    subcmd = getattr(args, "subcmd", "") or ""
    if subcmd:
        parts.append(subcmd)
    return " ".join(part for part in parts if part) or "unknown"


# ─── CLI 主入口 ──────────────────────────────────────────────────────────────
def main() -> int:
    # 共享 --json 参数（让所有子 subparser 都能识别）
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="所有输出走 JSON 格式")

    parser = argparse.ArgumentParser(
        prog="ae-sdd",
        description="ae-sdd CLI v3.0 — 端到端自动化工程工具集",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[common],
    )
    sub = parser.add_subparsers(dest="command", required=True, metavar="<command>")

    # version
    p = sub.add_parser("version", help="输出版本", parents=[common])
    p.set_defaults(func=cmd_version)

    # 🆕 v4.1 scripts-dir：输出母版 scripts/ 目录（取代硬编码脚本路径）
    p_sdir = sub.add_parser("scripts-dir", help="[v4.1] 输出母版 scripts/ 目录路径", parents=[common])
    p_sdir.set_defaults(func=cmd_scripts_dir)

    # Typed operation protocol (LLM-facing control plane)
    p_ops = sub.add_parser("ops", help="类型化 AE-SDD operation 协议", parents=[common])
    ops_sub = p_ops.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_ops_describe = ops_sub.add_parser("describe", help="列出 operation schema", parents=[common])
    p_ops_describe.add_argument("--operation", default="", help="只描述指定 operation")
    p_ops_describe.add_argument("--project", default="", help="项目根（默认 cwd）")
    p_ops_describe.set_defaults(func=cmd_ops_describe)
    p_ops_next = ops_sub.add_parser("next", help="读取合法下一步", parents=[common])
    p_ops_next.add_argument("--project", default="", help="项目根（默认 cwd）")
    p_ops_next.add_argument("--work-item", required=True, help="显式 Work Item")
    p_ops_next.add_argument("--story", default="", help="关联 Story")
    p_ops_next.set_defaults(func=cmd_ops_next)
    p_ops_execute = ops_sub.add_parser("execute", help="执行 request-file 中的类型化 operation", parents=[common])
    p_ops_execute.add_argument("--request-file", required=True, help="UTF-8 JSON request 文件")
    p_ops_execute.add_argument("--project", default="", help="request 未带 project 时使用")
    p_ops_execute.set_defaults(func=cmd_ops_execute)

    # Lease convenience adapter. All commands translate to typed operations.
    p_lease = sub.add_parser("lease", help="Work Item writer lease", parents=[common])
    lease_sub = p_lease.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")

    def add_lease_scope(parser_):
        parser_.add_argument("--project", default="", help="项目根（默认 cwd）")
        parser_.add_argument("--work-item", required=True, help="显式 Work Item")
        parser_.add_argument("--story", default="", help="关联 Story")

    def add_lease_owner(parser_):
        parser_.add_argument("--agent-id", required=True)
        parser_.add_argument("--session-id", required=True)
        parser_.add_argument("--host", default=socket.gethostname())
        parser_.add_argument("--pid", type=int, default=os.getpid())

    p_lease_acquire = lease_sub.add_parser("acquire", help="获取 writer lease", parents=[common])
    add_lease_scope(p_lease_acquire)
    add_lease_owner(p_lease_acquire)
    p_lease_acquire.add_argument("--ttl-seconds", type=int, default=300)
    p_lease_acquire.add_argument("--idempotency-key", required=True)
    p_lease_acquire.set_defaults(func=cmd_lease)

    p_lease_status = lease_sub.add_parser("status", help="读取 writer lease", parents=[common])
    add_lease_scope(p_lease_status)
    p_lease_status.set_defaults(func=cmd_lease)

    p_lease_renew = lease_sub.add_parser("renew", help="续租 writer lease", parents=[common])
    add_lease_scope(p_lease_renew)
    add_lease_owner(p_lease_renew)
    p_lease_renew.add_argument("--lease-id", required=True)
    p_lease_renew.add_argument("--fencing-token", type=int, required=True)
    p_lease_renew.add_argument("--expected-revision", type=int, required=True)
    p_lease_renew.add_argument("--ttl-seconds", type=int, default=300)
    p_lease_renew.add_argument("--idempotency-key", required=True)
    p_lease_renew.set_defaults(func=cmd_lease)

    p_lease_release = lease_sub.add_parser("release", help="释放 writer lease", parents=[common])
    add_lease_scope(p_lease_release)
    add_lease_owner(p_lease_release)
    p_lease_release.add_argument("--lease-id", required=True)
    p_lease_release.add_argument("--fencing-token", type=int, required=True)
    p_lease_release.add_argument("--expected-revision", type=int, required=True)
    p_lease_release.add_argument("--idempotency-key", required=True)
    p_lease_release.set_defaults(func=cmd_lease)

    p_lease_break = lease_sub.add_parser("break", help="带原因强制解除 writer lease", parents=[common])
    add_lease_scope(p_lease_break)
    add_lease_owner(p_lease_break)
    p_lease_break.add_argument("--reason", required=True)
    p_lease_break.add_argument("--idempotency-key", required=True)
    p_lease_break.set_defaults(func=cmd_lease)

    # state
    p_state = sub.add_parser("state", help="项目状态管理", parents=[common])
    state_sub = p_state.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_state_new = state_sub.add_parser("new", help="🆕 v3.9.3 新建独立需求状态机（.auto-engineering/{R6 顶层名}/state.json）", parents=[common])
    p_state_new.add_argument("--id", required=True, help="需求/任务 ID（如 BUG-LIFE-001 / STORY-001 / PRD-CS-001 / DR-005）")
    # 🆕 v3.9.3 废除 --name 形参（v3.8.2 required=True → 改 optional，保留以兼容旧 CLI 调用）
    p_state_new.add_argument("--name", required=False, default="", help="[已废除 v3.9.3] 需求/任务名称；v3.9.3 起目录名走 R6 顶层名，传值被忽略")
    p_state_new.add_argument("--story", default="", help="关联 Story ID（可选；未传时 currentStory 回退为 --id）")
    p_state_new.add_argument(
        "--story-name", default="",
        help="正式 Story 文件名（可带或不带 .md；仅支持单 Story 精确绑定）",
    )
    p_state_new.add_argument("--task", default="", help="关联 Task ID（可选）")
    p_state_new.add_argument("--scale", choices=["大", "中", "小", "微"], default=None,
                             help="任务规模（v3.10.0：BUG->微、PLAN->小、STORY->中、DR/PRD->大）")
    p_state_new.add_argument("--entry-node", default=None,
                             help="入口节点语义（BUG/CONFIG/PRD/RA/DR/STORY/TASK/PLAN）")
    p_state_new.add_argument("--force", action="store_true", help="允许覆盖已存在的同名 state.json")
    p_state_new.add_argument("--no-activate", dest="activate", action="store_false",
                             help="创建后不设为 active work item")
    # 🆕 v3.9.0 嵌套 state 支持
    p_state_new.add_argument("--story-ids", default="",
                             help="🆕 v3.9.0 多 Story 嵌套 state（逗号分隔，如 STORY-003-BE,STORY-004-BE）；"
                                  "配合 --entry-node=STORY/PRD/DR 使用")
    p_state_new.add_argument("--nested", action="store_true",
                             help="🆕 v3.9.0 显式创建嵌套 state（stateModel=nested）；"
                                  "传 --story-ids 或 --entry-node=PRD/DR/STORY 时自动启用")
    p_state_new.set_defaults(func=cmd_state_new, activate=True)
    p_state_read = state_sub.add_parser("read", help="读 state.json", parents=[common])
    p_state_read.add_argument("--work-item", default="", help="独立需求状态机 ID 或目录名（PRD/BUG/OPT/Story 均可）")
    p_state_read.add_argument("--story", default="", help="兼容参数：等价于 --work-item，且作为 currentStory")
    p_state_read.add_argument("--project-state", action="store_true",
                              help="已禁用：项目级 .ae-sdd/state.json 不是有效 state")
    p_state_read.set_defaults(func=cmd_state_read)
    p_state_bind_story = state_sub.add_parser(
        "bind-story-doc",
        help="将正式 StoryName 精确绑定到现有 Work Item state",
        parents=[common],
    )
    p_state_bind_story.add_argument(
        "--work-item", required=True, help="现有 Work Item（如 Story-006）"
    )
    p_state_bind_story.add_argument(
        "--story", required=True, help="逻辑 Story ID（如 STORY-006-BE）"
    )
    p_state_bind_story.add_argument(
        "--story-name", required=True,
        help="正式 Story 文件名（可带或不带 .md，只接受 basename）",
    )
    p_state_bind_story.set_defaults(func=cmd_state_bind_story_doc)
    p_state_next = state_sub.add_parser("next-step", help="下一步建议", parents=[common])
    p_state_next.add_argument("--work-item", default="", help="独立需求状态机 ID 或目录名（PRD/BUG/OPT/Story 均可）")
    p_state_next.add_argument("--story", default="", help="兼容参数：等价于 --work-item")
    p_state_next.add_argument("--project-state", action="store_true",
                              help="已禁用：项目级 .ae-sdd/state.json 不是有效 state")
    p_state_next.set_defaults(func=cmd_state_next_step)
    p_state_write = state_sub.add_parser("write", help="更新 state", parents=[common])
    p_state_write.add_argument("--phase", required=True, help="新 phase")
    p_state_write.add_argument("--work-item", default="", help="独立需求状态机 ID 或目录名；不传则跟随 active 状态机")
    p_state_write.add_argument("--story", help="当前 Story ID")
    p_state_write.add_argument("--task", help="当前 Task ID")
    p_state_write.add_argument("--scale", choices=["大", "中", "小", "微"], default=None,
                               help="🆕 v3.5.15 任务规模（首次 state write 携带，决定走哪条子链）")
    p_state_write.add_argument("--entry-node", default=None,
                               help="🆕 v3.5.15 入口节点语义（BUG/CONFIG/PRD/RA/DR/STORY/TASK/PLAN）")
    p_state_write.add_argument("--allow-empty-memory", action="store_true",
                               help="maintenance override: allow phase transition without mandatory memory")
    p_state_write.add_argument("--project-state", action="store_true",
                               help="已禁用：项目级 .ae-sdd/state.json 不是有效 state")
    # 🆕 v3.9.0 嵌套 state 支持
    p_state_write.add_argument("--add-story", default="",
                               help="🆕 v3.9.0 向嵌套 state 的 storyStates 新增一条 Story 子状态（R2 归入）")
    p_state_write.add_argument("--sub-story", default="",
                               help="🆕 v3.9.0 操作指定 Story 子状态的 phase（嵌套 state 专用，等价于 --story 但写子状态）")
    p_state_write.set_defaults(func=cmd_state_write)

    # 🆕 v3.9.0 state relocate — R5 改已管理 Story 重定位 + 重置子状态
    p_state_relocate = state_sub.add_parser("relocate",
                                             help="🆕 v3.9.0 重定位到 Story 所属 state + 重置该 Story 子状态（R5）",
                                             parents=[common])
    p_state_relocate.add_argument("--story", required=True,
                                  help="要重定位的 Story ID（如 STORY-003-BE）")
    p_state_relocate.add_argument("--no-reset", action="store_true",
                                  help="只重定位不重置子状态（默认重置到 story-generated）")
    p_state_relocate.set_defaults(func=cmd_state_relocate)

    # state confirm（🆕 v3.4.0 — 审核点 token，建议书3 B2-1~5）
    p_state_confirm = state_sub.add_parser("confirm", help="[v3.4.0] 审核点确认 token（用户触发，防 AI 自填）",
                                            parents=[common])
    p_state_confirm.add_argument("--phase", required=True, help="已确认的审核点 phase（如 task-reviewed/coding/code-reviewed）")
    p_state_confirm.add_argument("--story", default="", help="Story ID")
    p_state_confirm.add_argument("--work-item", default="", help="独立需求状态机 ID 或目录名；不传则跟随 active 状态机")
    p_state_confirm.add_argument("--by", default="user", help="确认人（默认 user）")
    p_state_confirm.set_defaults(func=cmd_state_confirm)

    # state prd-*（🆕 v3.3.0 PRD 级状态机 CLI）
    p_state_prd_init = state_sub.add_parser("prd-init",
                                             help="[v3.5.12] 初始化 PRD 级 state（写入 8 字段 + prdStatus=in_progress）",
                                             parents=[common])
    p_state_prd_init.add_argument("--prd", required=True, help="PRD ID（如 PRD-CS-001）")
    p_state_prd_init.add_argument("--title", default="", help="PRD 标题")
    p_state_prd_init.set_defaults(func=cmd_state_prd_init)

    p_state_prd_check = state_sub.add_parser("prd-check-complete",
                                              help="[v3.3.0] 校验 4 层 AND（G-PRD-1~4），不改状态",
                                              parents=[common])
    p_state_prd_check.add_argument("--prd", required=True, help="PRD ID（如 PRD-CS-001）")
    p_state_prd_check.set_defaults(func=cmd_state_prd_check_complete)

    p_state_prd_comp = state_sub.add_parser("prd-complete",
                                             help="[v3.3.0] 校验通过后触发 PRD compact",
                                             parents=[common])
    p_state_prd_comp.add_argument("--prd", required=True, help="PRD ID")
    p_state_prd_comp.add_argument("--runtime", required=True,
                                  choices=["mavis", "claude-code", "codex"],
                                  help="目标 runtime")
    p_state_prd_comp.set_defaults(func=cmd_state_prd_complete)

    p_state_prd_arch = state_sub.add_parser("prd-archive",
                                             help="[v3.3.0] 归档 compactHistory 到 state.archive.json",
                                             parents=[common])
    p_state_prd_arch.add_argument("--prd", required=True, help="PRD ID")
    p_state_prd_arch.add_argument("--keep-last", type=int, default=5,
                                   help="保留最近 N 条（默认 5）")
    p_state_prd_arch.set_defaults(func=cmd_state_prd_archive)

    # state register-review-consensus（🆕 v3.8.0 写联审共识）
    p_state_rrc = state_sub.add_parser("register-review-consensus",
                                        help="[v3.8.0] 写联审共识结果到 reviewConsensus[point]",
                                        parents=[common])
    p_state_rrc.add_argument("--story", default="", help="Story ID（空=项目级）")
    p_state_rrc.add_argument("--work-item", default="", help="独立需求状态机 ID 或目录名；不传则跟随 active 状态机")
    p_state_rrc.add_argument("--project-state", action="store_true",
                             help="已禁用：项目级 .ae-sdd/state.json 不是有效 state")
    p_state_rrc.add_argument("--point", type=float, required=True,
                             help="审核点编号（1/1.5/2/2.5/4/5）")
    p_state_rrc.add_argument("--tier", type=int, default=3, help="reviewer Tier（自动化模式固定 3）")
    p_state_rrc.add_argument("--passed", choices=["true", "false"], required=True,
                             help="联审共识是否通过")
    p_state_rrc.add_argument("--rounds", type=int, default=1, help="矫正轮次")
    p_state_rrc.add_argument("--reviewers", default="",
                             help="reviewer 摘要列表（agentId|role|verdict|sessionId，逗号分隔）")
    p_state_rrc.add_argument("--stall-reason", default="", help="未通过原因")
    p_state_rrc.set_defaults(func=cmd_state_register_review_consensus)

    # state lock / unlock（🆕 v3.8.1 S-3 文件意图锁）
    p_state_lock = state_sub.add_parser("lock",
                                        help="[v3.8.1] 获取文件意图锁（防多 agent 并发写）",
                                        parents=[common])
    p_state_lock.add_argument("--story", default="", help="Story ID（空=项目级）")
    p_state_lock.add_argument("--work-item", default="", help="独立需求状态机 ID 或目录名；不传则跟随 active 状态机")
    p_state_lock.add_argument("--project-state", action="store_true",
                              help="已禁用：项目级 .ae-sdd/state.json 不是有效 state")
    p_state_lock.add_argument("--path", required=True,
                              help="产物文件相对路径（相对 project_dir，正斜杠）")
    p_state_lock.add_argument("--agent", required=True, help="申请锁的 agent 标识")
    p_state_lock.add_argument("--ttl", type=int, default=1800,
                              help="锁有效期秒数（默认 1800=30 分钟）")
    p_state_lock.set_defaults(func=cmd_state_lock)

    p_state_unlock = state_sub.add_parser("unlock",
                                          help="[v3.8.1] 释放文件意图锁（仅持锁者能释放）",
                                          parents=[common])
    p_state_unlock.add_argument("--story", default="", help="Story ID（空=项目级）")
    p_state_unlock.add_argument("--work-item", default="", help="独立需求状态机 ID 或目录名；不传则跟随 active 状态机")
    p_state_unlock.add_argument("--project-state", action="store_true",
                                help="已禁用：项目级 .ae-sdd/state.json 不是有效 state")
    p_state_unlock.add_argument("--path", required=True, help="产物文件相对路径")
    p_state_unlock.add_argument("--agent", required=True, help="释放锁的 agent 标识")
    p_state_unlock.set_defaults(func=cmd_state_unlock)

    # runtime（🆕 v3.3.0 runtime-specific compact 适配层）
    p_runtime = sub.add_parser("runtime", help="[v3.3.0] runtime-specific 适配（compact 等）",
                                parents=[common])
    runtime_sub = p_runtime.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_runtime_compact = runtime_sub.add_parser("compact",
                                                help="[v3.3.0] PRD 级 compact 适配层",
                                                parents=[common])
    p_runtime_compact.add_argument("--runtime", required=True,
                                   choices=["mavis", "claude-code", "codex"],
                                   help="目标 runtime")
    p_runtime_compact.add_argument("--prd", required=True, help="PRD ID")
    p_runtime_compact.set_defaults(func=cmd_runtime_compact)
    p_runtime_verify = runtime_sub.add_parser("verify",
                                              help="校验 compiled runtime package（manifest/load_order/fingerprint）",
                                              parents=[common])
    p_runtime_verify.add_argument("--path", default="",
                                  help="要校验的包目录；默认当前安装包，母版仓中默认 dist/ae-sdd")
    p_runtime_verify.set_defaults(func=cmd_runtime_verify)

    # automation（🆕 v3.8.0 自动化开关配置）
    p_auto = sub.add_parser("automation",
                            help="[v3.8.0] 自动化开关配置（status/enable/disable）",
                            parents=[common])
    auto_sub = p_auto.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_auto_status = auto_sub.add_parser("status", help="读自动化配置", parents=[common])
    p_auto_status.set_defaults(func=cmd_automation_status)
    p_auto_enable = auto_sub.add_parser("enable", help="开启全自动化", parents=[common])
    p_auto_enable.set_defaults(func=cmd_automation_enable)
    p_auto_disable = auto_sub.add_parser("disable", help="关闭自动化", parents=[common])
    p_auto_disable.set_defaults(func=cmd_automation_disable)

    # preflight（🆕 v3.8.0 开工前信息预收集）
    p_pf = sub.add_parser("preflight",
                          help="[v3.8.0] 开工前信息预收集（自动化模式专属）",
                          parents=[common])
    pf_sub = p_pf.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_pf_collect = pf_sub.add_parser("collect", help="扫描材料生成待补信息清单",
                                     parents=[common])
    p_pf_collect.add_argument("--story", default="", help="Story ID（扫描范围参考）")
    p_pf_collect.set_defaults(func=cmd_preflight_collect)

    # gates
    p_gates = sub.add_parser("gates", help="门禁检查（35 门禁：G-00~14 + G-09B + G-CODEPLAN-SRC + G-DOC-STORAGE + G-DOC-CONSISTENCY + G-PATH + G-RA-1~6 + G-RA-FLOW-VIOLATION + G-CODE-1 + G-REVIEW-LOOP + G-AUTO-CONSENSUS + G-REVIEW-DEPTH + G-*-CTX）", parents=[common])
    gates_sub = p_gates.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_gates_check = gates_sub.add_parser("check", help="跑门禁", parents=[common])
    p_gates_check.add_argument("--only", help="只查指定门禁（如 G-00 / G-RA-1）")
    p_gates_check.add_argument("--work-item", default="", help="显式选择 Work Item state")
    p_gates_check.set_defaults(func=cmd_gates_check)

    # gate ra-required（v3.2 — SKILL.md §🛡️ G-RA 准入门卫契约）
    p_gate = sub.add_parser("gate", help="单门卫检查（如 ra-required）", parents=[common])
    gate_sub = p_gate.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")
    p_gate_ra = gate_sub.add_parser("ra-required", help="需求分析准入门卫（G-RA-1~6 + FLOW）",
                                     parents=[common])
    p_gate_ra.add_argument("--project", default="", help="项目根目录（默认 cwd）")
    p_gate_ra.set_defaults(func=cmd_gate_ra_required)
    p_gate_code = gate_sub.add_parser("coding-required", help="Coding 真实性门卫（G-CODE-1）",
                                      parents=[common])
    p_gate_code.add_argument("--project", default="", help="项目根目录（默认 cwd）")
    p_gate_code.set_defaults(func=cmd_gate_coding_required)
    # gate doc-storage（🆕 v3.4.0 — SKILL.md §🛡️ G-DOC-STORAGE 文档落地存放门卫）
    p_gate_doc = gate_sub.add_parser("doc-storage", help="文档落地存放门卫（G-DOC-STORAGE，单点路径校验）",
                                     parents=[common])
    p_gate_doc.add_argument("--path", required=True, help="实际写入路径（落地前校验）")
