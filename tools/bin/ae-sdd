    p_git_blame = git_sub.add_parser("blame", help="structured git blame", parents=[common])
    p_git_blame.add_argument("--project", default="", help="project root (default cwd)")
    p_git_blame.add_argument("--file", required=True, help="file path")
    p_git_blame.add_argument("--start", type=int, default=None, help="start line")
    p_git_blame.add_argument("--end", type=int, default=None, help="end line")
    p_git_blame.set_defaults(func=cmd_git_blame)

    p_git_impact = git_sub.add_parser("impact", help="changed-file impact summary", parents=[common])
    p_git_impact.add_argument("--project", default="", help="project root (default cwd)")
    p_git_impact.add_argument("--file", action="append", default=[], help="changed file")
    p_git_impact.add_argument("--base", default="", help="base ref")
    p_git_impact.add_argument("--head", default="", help="head ref")
    p_git_impact.set_defaults(func=cmd_git_impact)

    # classify
    p_classify = sub.add_parser("classify", help="4 维判定", parents=[common])
