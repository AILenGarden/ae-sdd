def cmd_memory_common(args, parser):
    """🆕 v3.10.3: 读/更新 common memory。"""
    try:
        scope = _memory_scope_from_args(args)
        if args.common_action == "read":
            result = memory_store.read_common(scope)
        elif args.common_action == "update":
            content = args.content
            if args.content_file:
                from pathlib import Path as _P
                content = _P(args.content_file).read_text(encoding="utf-8")
            result = memory_store.update_common(scope, content=content)
        elif args.common_action == "clean":
            result = memory_store.clean_common(scope)
        else:
            output.err(f"unknown common action: {args.common_action}")
            return 1
    except Exception as e:
        output.err(str(e))
        return 1
    output.emit(result, as_json=args.json)
    return 0


