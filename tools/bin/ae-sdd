def _read_stdin_json() -> dict:
    """Read hook JSON from stdin as UTF-8 bytes.

    Claude Code sends hook input as UTF-8 JSON. On Windows, json.load(sys.stdin)
    may decode through the active console code page and corrupt markers such as
    "◆ STATE". Reading bytes avoids that runtime mismatch.
    """
    if sys.stdin.isatty():
        return {}
    try:
        raw = sys.stdin.buffer.read()
    except Exception:
        return {}
    if not raw:
        return {}
    try:
        data = json.loads(raw.decode("utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def cmd_version(args, parser):
    output.emit({
        "name": "ae-sdd",
        "version": paths.MASTER_VERSION,
        "python": sys.version.split()[0],
    }, as_json=args.json)
    return 0


def cmd_scripts_dir(args, parser):
    """🆕 v4.1：输出母版 scripts/ 目录绝对路径（跨项目解析脚本位置，取代硬编码）。"""
    master = paths.locate_master_source()
    if master is None:
        output.emit({"error": "未定位到母版 master_source"}, as_json=args.json)
        return 1
    sdir = paths.scripts_dir(master)
    output.emit({"scripts_dir": str(sdir)}, as_json=args.json)
    return 0


def _operation_error_payload(exc, operation_name="", work_item=""):
    return {
        "ok": False,
        "changed": False,
        "operation": operation_name,
        "workItem": work_item,
        "revisionBefore": None,
        "revisionAfter": None,
        "artifacts": [],
        "gateResults": [],
        "nextActions": [],
        "error": exc.to_dict(),
    }


def _emit_operation_error(args, exc, operation_name="", work_item=""):
    payload = _operation_error_payload(exc, operation_name, work_item)
    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.err(f"{exc.code}: {exc.message}")
        if exc.remediation:
            output.info(f"  -> {exc.remediation}")
    return 1


def _operation_project(value=""):
    return Path(value or Path.cwd()).resolve()


def cmd_ops_describe(args, parser):
    try:
        registry = operations.OperationRegistry(_operation_project(args.project))
        payload = registry.describe(args.operation)
    except operations.OperationError as exc:
        return _emit_operation_error(args, exc, "ops.describe")
    output.emit(payload, as_json=args.json)
    return 0


def cmd_ops_next(args, parser):
    try:
        registry = operations.OperationRegistry(_operation_project(args.project))
        payload = registry.next_actions(args.work_item, args.story)
    except operations.OperationError as exc:
        return _emit_operation_error(args, exc, "state.next_actions", args.work_item)
    output.emit(payload, as_json=args.json)
    return 0


def cmd_ops_execute(args, parser):
    request_path = Path(args.request_file)
    try:
        request = json.loads(request_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        error = operations.OperationError(
            "OPERATION_REQUEST_INVALID_JSON",
            "request-file cannot be read as a JSON object",
            details={"path": str(request_path.resolve()), "error": str(exc)},
        )
        return _emit_operation_error(args, error, "ops.execute")
    if not isinstance(request, dict):
        error = operations.OperationError(
            "OPERATION_REQUEST_INVALID_JSON", "request-file JSON root must be an object"
        )
        return _emit_operation_error(args, error, "ops.execute")
    if args.project and not request.get("project"):
        request["project"] = str(_operation_project(args.project))
    operation_name = str(request.get("operation") or "")
    work_item = str(request.get("workItem") or "")
    try:
        registry = operations.OperationRegistry(
            _operation_project(str(request.get("project") or args.project))
        )
        payload = registry.execute(request)
    except operations.OperationError as exc:
        return _emit_operation_error(args, exc, operation_name, work_item)
    output.emit(payload, as_json=args.json)
    return 0


def _lease_owner_from_args(args):
    return {
        "agentId": args.agent_id,
        "sessionId": args.session_id,
        "host": args.host or socket.gethostname(),
        "pid": int(args.pid),
    }


def cmd_lease(args, parser):
    operation_name = f"lease.{args.subcmd}"
    request = {
        "schemaVersion": operations.SCHEMA_VERSION,
        "operation": operation_name,
        "project": str(_operation_project(args.project)),
        "workItem": args.work_item,
        "story": getattr(args, "story", "") or "",
        "parameters": {},
    }
    if args.subcmd == "acquire":
        request["idempotencyKey"] = args.idempotency_key
        request["parameters"] = {
            "owner": _lease_owner_from_args(args),
            "ttlSeconds": args.ttl_seconds,
        }
    elif args.subcmd == "renew":
        request.update({
            "lease": {"leaseId": args.lease_id, "fencingToken": args.fencing_token},
            "expectedRevision": args.expected_revision,
            "idempotencyKey": args.idempotency_key,
        })
        request["parameters"] = {
            "owner": _lease_owner_from_args(args),
            "ttlSeconds": args.ttl_seconds,
        }
    elif args.subcmd == "release":
        request.update({
            "lease": {"leaseId": args.lease_id, "fencingToken": args.fencing_token},
            "expectedRevision": args.expected_revision,
            "idempotencyKey": args.idempotency_key,
        })
        request["parameters"] = {"owner": _lease_owner_from_args(args)}
    elif args.subcmd == "break":
        request["idempotencyKey"] = args.idempotency_key
        request["parameters"] = {
            "actor": _lease_owner_from_args(args),
            "reason": args.reason,
        }
    try:
        payload = operations.OperationRegistry(_operation_project(args.project)).execute(request)
    except operations.OperationError as exc:
        return _emit_operation_error(args, exc, operation_name, args.work_item)
    output.emit(payload, as_json=args.json)
    return 0


def _work_item_arg(args) -> str:
    """Return explicit work item id, falling back to --story for old commands."""
    return (getattr(args, "work_item", "") or getattr(args, "story", "") or "").strip()


def _state_path_work_item_key(sp: Path, fallback: str = "") -> str:
    """Return the work-item directory key for an isolated state path."""
    return work_item_context.state_path_work_item_key(sp, fallback)


def _emit_work_item_ambiguity(exc: work_item_context.AmbiguousWorkItemError, args) -> None:
    message = str(exc)
    if getattr(args, "json", False):
        output.emit({
            "ok": False,
            "error": "work-item-ambiguous",
            "message": message,
            "candidates": [c.key for c in exc.candidates],
        }, as_json=True)
    else:
        output.err(message)


def _emit_state_resolution_error(exc: Exception, args) -> None:
    message = str(exc)
    error_code = getattr(exc, "code", "work-item-required")
    if getattr(args, "json", False):
        output.emit({"ok": False, "error": error_code, "message": message}, as_json=True)
    else:
        output.err(message)


def _active_state_from_mirror(ade_sdd: Path) -> tuple[Path, str] | None:
    """Disabled compatibility stub; project-global mirrors are not state sources.

    🆕 v3.9.7 fallback-trap-fix：镜像文件不存在时主动 fallback：
      优先级 1）镜像里的 activeStatePath / activeWorkItem
      优先级 2）扫描 .auto-engineering/*/state.json，按 mtime 选最近活跃
    与 `_main_state_path_for_args` 主 fallback 不同：
      Project-level state fallback has been removed.
      - 本函数返回真实源 —— 因为 active story 一定要有对应 work-item state.json
    返回 (state_path, work_item_key) 或 None。
    """
    return None
    mirror_path = None
    mirror_data: dict = {}
    mirror_exists = False
    if mirror_path is not None and mirror_path.is_file():
        mirror_exists = True
        try:
            mirror_data = state.read_state(mirror_path) or {}
        except Exception:
            mirror_data = {}

    project_root = paths.project_root(ade_sdd).resolve()
    auto_root = (project_root / ".auto-engineering").resolve()
    active_key = (mirror_data.get("activeWorkItem") or mirror_data.get("currentWorkItem") or "").strip()
    raw_path = (mirror_data.get("activeStatePath") or "").strip()
    candidates: list[Path] = []
    if raw_path:
        p = Path(raw_path)
        candidates.append(p if p.is_absolute() else project_root / p)
    if active_key:
        keyed_state = paths.find_work_item_state_path(ade_sdd, active_key)
        if keyed_state is not None:
            candidates.append(keyed_state)

    for cand in candidates:
        try:
            resolved = cand.resolve()
            resolved.relative_to(auto_root)
        except Exception:
            continue
        if resolved.is_file():
            return resolved, _state_path_work_item_key(resolved, active_key)

    # 🆕 v3.9.7 fallback：镜像缺失或镜像里记录全失效 → 扫描 .auto-engineering/*
    #   找最近修改的 work-item state.json 作为活跃
    if not mirror_exists:
        candidates_recent: list[Path] = []
        if auto_root.is_dir():
            for child in sorted(auto_root.iterdir()):
                if not child.is_dir():
                    continue
                sp = child / "state.json"
                if sp.is_file():
                    try:
                        resolved = sp.resolve()
                        resolved.relative_to(auto_root)
                        candidates_recent.append(resolved)
                    except Exception:
                        continue
        if candidates_recent:
            # 按 mtime 倒序选最近活跃的
            candidates_recent.sort(key=lambda p: p.stat().st_mtime, reverse=True)
            return candidates_recent[0], _state_path_work_item_key(candidates_recent[0], "")
    return None


def _main_state_path_for_args(ade_sdd: Path, args, prefer_recent: bool = False) -> tuple[Path, str]:
    """🆕 v3.9.3 解析 state 路径：接受 R6 顶层名 或 raw ID 派生顶层名。

    优先级：
      1. --project-state -> 项目级 state.json
      2. --work-item / --story（token）：
         a) token 是 R6 顶层名（PRD-/DR-/Story-/Task-）-> 直接用
         b) token 是 raw ID（STORY-006-BE / BUG-LIFE-001）-> 用 _resolve_top_node_from_token 派生
      3. activeStatePath 镜像

    🆕 v3.10.4 prefer_recent：只读命令传 True，歧义时按 mtime 自动推断最近活跃
    work-item（Pbl.md 问题4）；写命令默认 False，保持硬拒绝。
    """
    if getattr(args, "project_state", False):
        raise ValueError("project-level .ae-sdd/state.json is not supported; use --work-item with a task-scoped state")
    work_item = _work_item_arg(args)
    if work_item:
        existing = paths.find_work_item_state_path(ade_sdd, work_item)
        if existing is not None:
            return existing, _state_path_work_item_key(existing, work_item)
        top_node, features = _resolve_top_node_from_token(ade_sdd, work_item, args)
        if top_node:
            sp = paths.work_item_state_path(ade_sdd, top_node, features)
            return sp, _state_path_work_item_key(sp, sp.parent.name)
        # 解析不出顶层节点 -> 尝试当作顶层名（R6 形式）
        if work_item.startswith(("PRD-", "DR-", "Story-", "Task-")):
            # 用顶层名本身当 work_item_key 走 legacy 单段兼容
            sp = paths.work_items_dir(ade_sdd) / work_item / "state.json"
            return sp, work_item
        raise ValueError(f"cannot resolve work item: {work_item}")
    resolved = work_item_context.resolve_default_state(ade_sdd, prefer_recent=prefer_recent)
    return resolved.path, resolved.key


def _write_active_state_mirror(ade_sdd: Path, state_data: dict, work_item: str, source_path: Path) -> None:
    """No-op: active state is session/work-item scoped, never project-global."""
    return


def _check_and_recover_stuck_mirror(ade_sdd: Path, work_item: str, sp: Path) -> None:
    """🆕 v3.9.11：检测并恢复冻结的 state.json 镜像。

    Args:
        ade_sdd: 项目 .ae-sdd 目录
        work_item: 当前 cmd_state_write 解析出的 work_item key
        sp: 当前 cmd_state_write 解析出的 state.json 路径

    行为：
      1. disabled; project-global mirrors are ignored
      2. 若镜像 activeWorkItem 与传入 work_item 不一致（且都不为空）→ 镜像冻结
      3. 镜像冻结时，扫描 .auto-engineering/*/state.json 按 mtime 选最近活跃
      4. 若最近活跃 work-item 与传入 work_item 一致 → 镜像只是过期，自动刷新
      5. 若不一致 → 输出 warn，建议用户加 --story 显式指定
    """
    mirror_path = None
    if mirror_path is None or not mirror_path.is_file():
        return  # 无镜像，v3.9.8 fallback 已处理
    try:
        mirror = state.read_state(mirror_path) or {}
    except Exception:
        return
    mirror_wi = (mirror.get("activeWorkItem") or mirror.get("currentWorkItem") or "").strip()
    if not mirror_wi or not work_item:
        return
    if mirror_wi == work_item:
        return  # 镜像与目标一致，OK

    # 镜像冻结！扫描 .auto-engineering/ 下最近活跃 work-item
    project_root = paths.project_root(ade_sdd)
    auto_root = project_root / ".auto-engineering"
    if not auto_root.is_dir():
        return
    candidates: list[tuple[Path, float]] = []
    for child in auto_root.iterdir():
        if not child.is_dir():
            continue
        sp_candidate = child / "state.json"
        if sp_candidate.is_file():
            try:
                candidates.append((sp_candidate, sp_candidate.stat().st_mtime))
            except OSError:
                continue
    if not candidates:
        return
    candidates.sort(key=lambda x: x[1], reverse=True)
    recent_path = candidates[0][0]
    recent_wi = recent_path.parent.name

    if recent_wi == work_item:
        # 镜像过期，自动刷新（无侵入恢复）
        try:
            recent_data = state.read_state(recent_path)
            output.warn(
                f"检测到禁用镜像冻结指 {mirror_wi}，"
                f"已自动 fallback 到最近活跃 work-item {work_item}。"
            )
            _write_active_state_mirror(ade_sdd, recent_data, work_item, recent_path)
        except Exception as e:
            output.warn(f"镜像自动恢复失败（{e}），建议手动 `ae-sdd state relocate --story {work_item}`")
    else:
        # 镜像指别的 work-item，且与 cmd 目标不一致 → 显式提示
        output.warn(
            f"镜像 activeWorkItem={mirror_wi} 与本次 state write 目标 {work_item} 不一致。"
            f"建议加 --story {work_item} 显式指定，或跑 `ae-sdd state relocate --story {work_item}` 重定位。"
        )


def _infer_scale_for_work_item(work_item: str, entry_node: str | None) -> tuple[str, str] | None:
    """Infer micro-chain routing for explicit BUG/OPT/CONFIG work items."""
    marker = (entry_node or "").strip().upper()
    item = (work_item or "").strip().upper()
    if marker in {"BUG", "OPT", "CONFIG"}:
        return "微", marker
    if item.startswith("BUG-"):
        return "微", "BUG"
    if item.startswith("OPT-"):
        return "微", "OPT"
    if item.startswith("CONFIG-"):
        return "微", "CONFIG"
    return None


def _default_scale_for_state_new(entry_node: str, work_item_id: str) -> str:
    """Default new state scale by entry semantics instead of always using the large chain.

    🆕 v3.10.0 Route 下移重分级：大=DR入口、中=Story入口、小=CodingPlan入口、微=无文档。
    """
    marker = (entry_node or "").strip().upper()
    item = (work_item_id or "").strip().upper()
    if marker in {"BUG", "OPT", "CONFIG"} or item.startswith(("BUG-", "OPT-", "CONFIG-")):
        return "\u5fae"  # 微：无文档直出 CodingPlan
    if marker == "PLAN" or item.startswith("PLAN-"):
        return "\u5c0f"  # 小：CodingPlan 入口
    if marker == "STORY":
        return "\u4e2d"  # 中：Story 入口
    # DR / PRD(兼容) / 默认 -> 大
    return "\u5927"


def _emit_story_document_resolution_error(args, code: str, message: str,
                                          details: dict | None = None) -> None:
    payload = {
        "ok": False,
        "errorCode": code,
        "message": message,
        "details": details or {},
    }
    if getattr(args, "json", False):
        output.emit(payload, as_json=True)
    else:
        output.err(f"{code}: {message}")


def _resolve_requested_story_document(args, project_dir: Path, *,
                                      story_id: str, story_name: str):
    try:
        resolution = document_storage.resolve_story_document(
            project_dir,
            story_id=story_id,
            story_name=story_name,
        )
    except document_storage.StoryDocumentAmbiguousError as exc:
        _emit_story_document_resolution_error(
            args, exc.code, str(exc), {"candidates": list(exc.candidates)}
        )
        return None
    except document_storage.DocStorageError as exc:
        _emit_story_document_resolution_error(args, exc.code, str(exc))
        return None

    if resolution.path is None:
        rejection = resolution.rejected[0] if resolution.rejected else {}
        code = rejection.get("code") or "STORY_DOC_NOT_FOUND"
        message = (
            f"Story document cannot be bound: storyId={story_id}, "
            f"storyName={resolution.story_name}"
        )
        _emit_story_document_resolution_error(
            args,
            code,
            message,
            {
                "candidates": [str(path) for path in resolution.candidates],
                "rejected": list(resolution.rejected),
            },
        )
        return None
    return resolution


def _story_state_target(ade_sdd: Path, project_dir: Path, story_path: Path,
                        story_id: str) -> dict:
    """Resolve the R2 parent identity without mutating or creating any state."""
    design_dir = paths.project_design_dir(project_dir)
    parent_prd, parent_dr = paths.extract_parent_claim(story_path, doc_kind="story")
    valid_prd = None
    valid_dr = None
    dr_doc = None
    if parent_dr:
        ok, _reason = paths.verify_parent_claim(
            "DR", parent_dr, design_dir, child_id=story_id
        )
        if ok:
            valid_dr = parent_dr
            dr_doc = paths._find_design_doc(design_dir, parent_dr)
    if parent_prd:
        ok, _reason = paths.verify_parent_claim(
            "PRD", parent_prd, design_dir, child_id=story_id
        )
        if ok:
            valid_prd = parent_prd
    if valid_dr and dr_doc:
        claimed_prd, _unused = paths.extract_parent_claim(dr_doc, doc_kind="dr")
        if claimed_prd:
            ok, _reason = paths.verify_parent_claim(
                "PRD", claimed_prd, design_dir, child_id=valid_dr
            )
            if ok:
                valid_prd = claimed_prd

    if valid_prd:
        existing = paths.find_nested_state_by_prd_id(ade_sdd, valid_prd)
        return {
            "entryNode": "PRD", "parentPrdId": valid_prd,
            "parentDrId": valid_dr, "drDoc": dr_doc,
            "existingPath": existing[0] if existing else None,
        }
    if valid_dr:
        existing = paths.find_nested_state_by_dr_id(ade_sdd, valid_dr)
        return {
            "entryNode": "DR", "parentPrdId": None,
            "parentDrId": valid_dr, "drDoc": dr_doc,
            "existingPath": existing[0] if existing else None,
        }
    return {
        "entryNode": "STORY", "parentPrdId": None,
        "parentDrId": None, "drDoc": None, "existingPath": None,
    }


def _fill_new_state_metadata(value: dict, *, cfg: dict, scale: str,
                             state_path: Path, new_uuid: str) -> None:
    final_key = state_path.parent.name
    if cfg.get("projectKey") and not value.get("projectKey"):
        value["projectKey"] = cfg.get("projectKey")
    for key, item in (
        ("scale", scale),
        ("workItemKey", final_key),
        ("currentWorkItem", final_key),
        ("stateMachineId", final_key),
        ("stateMachineName", paths.strip_uuid_prefix(final_key)),
        ("stateUuid", value.get("stateUuid") or new_uuid),
    ):
        if item and not value.get(key):
            value[key] = item


def _apply_story_add_and_binding(value: dict, *, story_id: str,
                                 resolution, parent_dr_id: str | None,
                                 absorbed: bool) -> dict:
    added = False
    if state.get_story_substate(value, story_id) is None:
        added = state.add_story_to_nested_state(
            value,
            story_id,
            initial_phase="story-generated" if absorbed else "initialized",
            parent_dr_id=parent_dr_id if value.get("entryNode") == "PRD" else None,
        )
    bound = state.bind_story_document(
        value,
        story_id,
        story_name=resolution.story_name,
        doc_path=str(resolution.path),
        by="ae-sdd state new --story-name",
    )
    return {"storyAdded": added, "bindingChanged": bound}


def _persist_story_name_state_new(ade_sdd: Path, cfg: dict, requested_scale: str,
                                  story_id: str, resolution, new_uuid: str):
    """Atomically absorb into an existing parent or exclusively create a new state."""
    project_dir = paths.project_root(ade_sdd)
    target = _story_state_target(ade_sdd, project_dir, resolution.path, story_id)
    allowed_root = paths.work_items_dir(ade_sdd)
    existing_path = target.get("existingPath")
    if existing_path is not None:
        store = StateStore(existing_path, allowed_root=allowed_root)
        snapshot = store.read()
        owner = LeaseOwner.current(
            "ae-sdd-cli", f"state-new-story-{os.getpid()}-{os.urandom(4).hex()}"
        )
        operation_key = f"state-new-story-{os.getpid()}-{os.urandom(8).hex()}"
        acquired = None
        try:
            acquired = store.acquire_lease(owner, 30, f"{operation_key}-lease")

            def apply(updated):
                result = _apply_story_add_and_binding(
                    updated,
                    story_id=story_id,
                    resolution=resolution,
                    parent_dr_id=target.get("parentDrId"),
                    absorbed=True,
                )
                _fill_new_state_metadata(
                    updated, cfg=cfg, scale=requested_scale,
                    state_path=existing_path, new_uuid=new_uuid,
                )
                return result

            mutation = store.mutate(
                expected_revision=snapshot.revision,
                lease_id=acquired.lease_id,
                fencing_token=acquired.fencing_token,
                idempotency_key=operation_key,
                operation="state.new-story-binding",
                payload={
                    "storyId": story_id,
                    "storyName": resolution.story_name,
                    "storyDocPath": str(resolution.path),
                },
                mutate=apply,
            )
            return existing_path, mutation.state
        finally:
            if acquired is not None:
                try:
                    store.release_lease(owner, acquired.lease_id, acquired.fencing_token)
                except StateStoreError:
                    pass

    entry_node = target["entryNode"]
    if entry_node == "PRD":
        prd_id = target["parentPrdId"]
        features = {"prd_feature": prd_id.replace("PRD-", "", 1), "prd_id": prd_id}
        biz_name = paths.build_state_machine_name("PRD", features)
        state_path = paths.work_item_state_path(ade_sdd, "PRD", features, state_uuid=new_uuid)
        initial = state.init_nested_state(
            project_key=cfg.get("projectKey") or "",
            entry_node="PRD", state_machine_id=biz_name, state_machine_name=biz_name,
            prd_id=prd_id, state_uuid=new_uuid,
        )
        if target.get("parentDrId"):
            state.ensure_dr_substate(
                initial, target["parentDrId"], initial_phase="dr-generated",
                doc_path=str(target["drDoc"]) if target.get("drDoc") else None,
            )
    elif entry_node == "DR":
        dr_id = target["parentDrId"]
        features = {"dr_feature": dr_id.replace("DR-", "", 1), "dr_id": dr_id}
        biz_name = paths.build_state_machine_name("DR", features)
        state_path = paths.work_item_state_path(ade_sdd, "DR", features, state_uuid=new_uuid)
        initial = state.init_nested_state(
            project_key=cfg.get("projectKey") or "",
            entry_node="DR", state_machine_id=biz_name, state_machine_name=biz_name,
            dr_id=dr_id, state_uuid=new_uuid,
        )
    else:
        features = {"story_ids": [story_id]}
        biz_name = paths.build_state_machine_name("STORY", features)
        state_path = paths.work_item_state_path(ade_sdd, "STORY", features, state_uuid=new_uuid)
        initial = state.init_nested_state(
            project_key=cfg.get("projectKey") or "",
            entry_node="STORY", state_machine_id=biz_name, state_machine_name=biz_name,
            story_ids=[story_id], state_uuid=new_uuid,
        )
    _apply_story_add_and_binding(
        initial, story_id=story_id, resolution=resolution,
        parent_dr_id=target.get("parentDrId"), absorbed=entry_node != "STORY",
    )
    _fill_new_state_metadata(
        initial, cfg=cfg, scale=requested_scale,
        state_path=state_path, new_uuid=new_uuid,
    )
    snapshot = StateStore(state_path, allowed_root=allowed_root).create(initial)
    return state_path, snapshot.state


def cmd_state_read(args, parser):
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    try:
        sp, _work_item = _main_state_path_for_args(ade_sdd, args, prefer_recent=True)
    except work_item_context.AmbiguousWorkItemError as e:
        _emit_work_item_ambiguity(e, args)
        return 1
    except (work_item_context.NoWorkItemStateError, ValueError) as e:
        _emit_state_resolution_error(e, args)
        return 1
    # 🆕 2026-07-03 缺口2:高频命令补 span,记录"被执行过 + 当前 phase"。
    # 这些命令本身 <1ms,span 价值在留痕与判定结果,而非耗时分解。
    with runtime_stats.span("state:read", {"workItem": _work_item or ""}):
        s = state.read_state(sp)
    output.emit(s, as_json=args.json)
    return 0


def cmd_state_new(args, parser):
    """🆕 v3.9.3 创建嵌套 state 机 + 强制 R2 向上归入。
    🆕 v3.10.0 Route 下移重分级：大=DR、中=Story、小=CodingPlan(PLAN)、微=无文档(BUG)。

    新签名：state new --id <ID> --entry-node <PRD|DR|STORY|PLAN|BUG> [--story-ids ...] [--nested]
    """
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    work_item_id = (args.id or "").strip()
    # v3.9.3 废除 --name 形参；如传了也忽略
    if not work_item_id:
        output.err("新状态机必须提供 --id")
        return 1

    requested_entry_node = args.entry_node
    story_ids_raw = getattr(args, "story_ids", "") or ""
    story_ids_list = [s.strip() for s in story_ids_raw.split(",") if s.strip()] if story_ids_raw else []
    use_nested = (getattr(args, "nested", False)
                  or bool(story_ids_list)
                  or (requested_entry_node in ("PRD", "DR", "STORY")))

    # 推断顶层节点
    if not requested_entry_node:
        upper = work_item_id.upper()
        if upper.startswith("PRD-"):
            requested_entry_node = "PRD"  # 🟡 v3.10.0 兼容：PRD 视为 DR 级（大任务）
        elif upper.startswith("DR-"):
            requested_entry_node = "DR"
        elif upper.startswith("PLAN-"):
            # 🆕 v3.10.0：CodingPlan 入口（小任务）
            requested_entry_node = "PLAN"
        elif upper.startswith(("BUG-", "OPT-", "CONFIG-")):
            requested_entry_node = "BUG"  # 微任务无文档
        else:
            requested_entry_node = "STORY"

    # 构造 R6 顶层 features
    from lib.flow_enums import FlowNode
    if not FlowNode.is_nested_entry(requested_entry_node):
        # 🆕 v3.10.0：BUG/OPT/CONFIG -> 微任务（无文档）；PLAN -> 小任务（CodingPlan 入口）
        if requested_entry_node in ("BUG", "OPT", "CONFIG"):
            requested_entry_node = "BUG"  # 微任务无文档，复用 BUG 扁平 state
        elif requested_entry_node == "PLAN":
            pass  # 小任务 CodingPlan 入口，扁平 state
        else:
            output.err(f"entry-node={requested_entry_node} 不支持嵌套 state（仅 PRD/DR/STORY）")
            return 1
    features: dict = {}
    if requested_entry_node == "PRD":
        features["prd_feature"] = work_item_id.replace("PRD-", "", 1)
        features["prd_id"] = work_item_id
    elif requested_entry_node == "DR":
        features["dr_feature"] = work_item_id.replace("DR-", "", 1)
        features["dr_id"] = work_item_id
    elif requested_entry_node == "STORY":
        features["story_ids"] = story_ids_list or [work_item_id]
    elif requested_entry_node == "BUG":
        features["task_id"] = work_item_id  # 🟡 v3.10.0 兼容字段名
    elif requested_entry_node == "PLAN":
        features["plan_id"] = work_item_id  # 🆕 v3.10.0 小任务 CodingPlan 入口

    story_resolution = None
    requested_story_name = (getattr(args, "story_name", "") or "").strip()
    if requested_story_name:
        if requested_entry_node != "STORY" or len(features.get("story_ids") or []) != 1:
            _emit_story_document_resolution_error(
                args,
                "STORY_DOC_BINDING_SCOPE_INVALID",
                "--story-name requires entry-node=STORY with exactly one Story ID",
            )
            return 1
        story_resolution = _resolve_requested_story_document(
            args,
            paths.project_root(ade_sdd),
            story_id=features["story_ids"][0],
            story_name=requested_story_name,
        )
        if story_resolution is None:
            return 1

    work_item_key = paths.work_item_dir_name(requested_entry_node, features)
    # 🆕 v3.10.1：创建时生成 UUID 前缀保证目录名/stateMachineId 全局唯一
    new_uuid = paths.generate_state_uuid()
    sp = paths.work_item_state_path(ade_sdd, requested_entry_node, features, state_uuid=new_uuid)
    # 防重复：目录名带随机 UUID 后 sp.exists() 永远 False，改用业务名后缀匹配查已存在
    existing = paths.find_work_item_state_path(ade_sdd, work_item_key)
    if existing is not None and not args.force:
        output.err(f"状态机已存在：{existing.parent.name}（业务名 {work_item_key}）")
        output.info("如需重建，请加 --force（会覆盖该 state.json）")
        return 1

    cfg = paths.read_config(ade_sdd)
    requested_scale = args.scale or _default_scale_for_state_new(requested_entry_node, work_item_id)

    if story_resolution is not None:
        try:
            final_sp, final_st = _persist_story_name_state_new(
                ade_sdd,
                cfg,
                requested_scale,
                features["story_ids"][0],
                story_resolution,
                new_uuid,
            )
        except StateStoreError as exc:
            _emit_story_document_resolution_error(
                args, exc.code, exc.message, exc.details
            )
            return 1
        except ValueError as exc:
            _emit_story_document_resolution_error(
                args, "STORY_DOC_BIND_FAILED", str(exc)
            )
            return 1
        if args.activate:
            _write_active_state_mirror(ade_sdd, final_st, final_sp.parent.name, final_sp)
        payload = {
            "ok": True,
            "workItemId": work_item_id,
            "workItemKey": work_item_key,
            "statePath": str(final_sp),
            "active": bool(args.activate),
            "stateModel": "nested",
            "entryNode": requested_entry_node,
            "storyIds": features.get("story_ids") or [],
            "storyName": story_resolution.story_name,
            "storyDocPath": str(story_resolution.path),
            "storyDocSource": story_resolution.source,
        }
        if args.json:
            output.emit(payload, as_json=True)
        else:
            output.ok(f"新嵌套状态机已创建或原子吸收：{final_sp.parent.name}")
            output.info(f"  state: {final_sp}")
        return 0

    if use_nested and requested_entry_node in ("PRD", "DR", "STORY"):
        # 🆕 v3.9.3 R2 强制向上归入（递归算法）
        design_dir = paths.project_design_dir(paths.project_root(ade_sdd))
        # 找当前节点文档（如果有）用于抽父级
        doc_path = None
        if requested_entry_node == "STORY" and features.get("story_ids"):
            if story_resolution is not None:
                doc_path = story_resolution.path
            else:
                doc_path = paths.find_doc(paths.project_root(ade_sdd), features["story_ids"][0], "-Story.md")
        elif requested_entry_node == "DR":
            doc_path = paths.find_doc(paths.project_root(ade_sdd), work_item_id, "-DR.md")
        elif requested_entry_node == "PRD":
            doc_path = paths.find_doc(paths.project_root(ade_sdd), work_item_id, "-PRD.md")

        # 跑 R2 递归（🆕 v3.10.1 generate_uuid=True 为新建顶层 state 加 UUID 前缀）
        try:
            final_sp, final_st = state.recursive_r2_absorb(
                ade_sdd, requested_entry_node, features, design_dir,
                doc_path=doc_path, child_id=work_item_id,
                generate_uuid=True,
            )
        except ValueError as e:
            output.err(str(e))
            return 1

        # 若 R2 实际写到了不同的路径（嵌入父级 state），告知用户
        if str(final_sp) != str(sp):
            output.info(f"R2 向上归入：当前节点已嵌进父级 state {final_sp.parent.name}")

        metadata_changed = False
        final_work_item_key = final_sp.parent.name
        if cfg.get("projectKey") and not final_st.get("projectKey"):
            final_st["projectKey"] = cfg.get("projectKey")
            metadata_changed = True
        for key, value in (
            ("scale", requested_scale),
            ("workItemKey", final_work_item_key),
            ("currentWorkItem", final_work_item_key),
            ("stateMachineId", final_work_item_key),
            # 🆕 v3.10.1：stateMachineName 存纯业务名（无 UUID 前缀），供按业务名查找匹配
            ("stateMachineName", paths.strip_uuid_prefix(final_work_item_key)),
            ("stateUuid", final_st.get("stateUuid") or new_uuid),
        ):
            if value and not final_st.get(key):
                final_st[key] = value
                metadata_changed = True
        if story_resolution is not None:
            try:
                binding_changed = state.bind_story_document(
                    final_st,
                    features["story_ids"][0],
                    story_name=story_resolution.story_name,
                    doc_path=str(story_resolution.path),
                    by="ae-sdd state new --story-name",
                )
            except ValueError as exc:
                _emit_story_document_resolution_error(
                    args, "STORY_DOC_BIND_FAILED", str(exc)
                )
                return 1
            metadata_changed = metadata_changed or binding_changed
        if metadata_changed:
            state.write_state(final_sp, final_st)

        if args.activate:
            _write_active_state_mirror(ade_sdd, final_st, final_sp.parent.name, final_sp)
        payload = {
            "ok": True,
            "workItemId": work_item_id,
            "workItemKey": work_item_key,
            "statePath": str(final_sp),
            "active": bool(args.activate),
            "stateModel": "nested",
            "entryNode": requested_entry_node,
            "storyIds": features.get("story_ids") or [],
        }
        if story_resolution is not None:
            payload.update({
                "storyName": story_resolution.story_name,
                "storyDocPath": str(story_resolution.path),
                "storyDocSource": story_resolution.source,
            })
        if args.json:
            output.emit(payload, as_json=True)
        else:
            output.ok(f"新嵌套状态机已创建：{final_sp.parent.name}")
            output.info(f"  state: {final_sp}")
            output.info(f"  stateModel: nested (entryNode={requested_entry_node})")
            if features.get("story_ids"):
                output.info(f"  storyStates: {', '.join(features['story_ids'])}")
            if args.activate:
                output.info("  已设为 active work item")
        return 0

    # v1 扁平 state 路径（v3.9.3 起基本不再使用，保留兼容）
    # 🆕 v3.10.1：扁平 state 也带 UUID 前缀目录名（sp 已在上方带 state_uuid 生成）
    flat_key = sp.parent.name  # 带 UUID 前缀的目录名
    now = _now_iso()
    st = state.read_state(sp)
    st.update({
        "version": "1",
        "projectKey": cfg.get("projectKey"),
        "phase": "initialized",
        "scale": requested_scale,
        "entryNode": requested_entry_node,
        "stateMachineId": flat_key,
        "stateMachineName": paths.strip_uuid_prefix(flat_key),  # 🆕 v3.10.1 纯业务名
        "stateUuid": new_uuid,  # 🆕 v3.10.1
        "workItemId": work_item_id,
        "workItemKey": flat_key,
        "currentWorkItem": flat_key,
        "currentStory": work_item_id,
        "currentTask": None,
        "createdAt": now,
        "lastUpdated": now,
        "history": [],
    })
    if args.task:
        st["currentTask"] = args.task
    state.write_state(sp, st)
    if args.activate:
        _write_active_state_mirror(ade_sdd, st, flat_key, sp)
    if args.json:
        output.emit({"ok": True, "statePath": str(sp)}, as_json=True)
    else:
        output.ok(f"新状态机已创建：{flat_key}")
        output.info(f"  state: {sp}")
    return 0


def cmd_state_bind_story_doc(args, parser):
    """Bind an exact native Story filename to an existing Work Item state."""
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    try:
        sp, work_item = _main_state_path_for_args(ade_sdd, args)
    except work_item_context.AmbiguousWorkItemError as exc:
        _emit_work_item_ambiguity(exc, args)
        return 1
    except (work_item_context.NoWorkItemStateError, ValueError) as exc:
        _emit_state_resolution_error(exc, args)
        return 1
    if not sp.is_file():
        _emit_state_resolution_error(
            ValueError(f"Work Item state does not exist: {sp}"), args
        )
        return 1

    story_id = (args.story or "").strip()
    story_name = (args.story_name or "").strip()
    resolution = _resolve_requested_story_document(
        args,
        paths.project_root(ade_sdd),
        story_id=story_id,
        story_name=story_name,
    )
    if resolution is None:
        return 1

    store = StateStore(sp, allowed_root=paths.work_items_dir(ade_sdd))
    snapshot = store.read()
    existing = state.get_story_document_binding(snapshot.state, story_id)
    try:
        existing_path = (Path(existing.get("docPath") or "").resolve()
                         if existing.get("docPath") else None)
    except OSError:
        existing_path = Path(existing.get("docPath") or "")
    if (existing.get("storyName") == resolution.story_name
            and existing_path == resolution.path):
        payload = {
            "ok": True,
            "changed": False,
            "workItem": work_item,
            "storyId": story_id,
            "storyName": resolution.story_name,
            "storyDocPath": str(resolution.path),
            "storyDocSource": resolution.source,
            "revision": snapshot.revision,
        }
        if args.json:
            output.emit(payload, as_json=True)
        else:
            output.info(f"Story 文档绑定未变：{resolution.path}")
        return 0

    owner = LeaseOwner.current(
        "ae-sdd-cli", f"bind-story-doc-{os.getpid()}-{os.urandom(4).hex()}"
    )
    operation_key = f"bind-story-doc-{os.getpid()}-{os.urandom(8).hex()}"
    acquired = None
    try:
        acquired = store.acquire_lease(owner, 30, f"{operation_key}-lease")

        def apply_binding(updated):
            changed = state.bind_story_document(
                updated,
                story_id,
                story_name=resolution.story_name,
                doc_path=str(resolution.path),
            )
            return {"changed": changed}

        mutation = store.mutate(
            expected_revision=snapshot.revision,
            lease_id=acquired.lease_id,
            fencing_token=acquired.fencing_token,
            idempotency_key=operation_key,
            operation="state.bind-story-doc",
            payload={
                "storyId": story_id,
                "storyName": resolution.story_name,
                "storyDocPath": str(resolution.path),
            },
            mutate=apply_binding,
        )
    except (StateStoreError, ValueError) as exc:
        if isinstance(exc, StateStoreError):
            _emit_story_document_resolution_error(
                args, exc.code, exc.message, exc.details
            )
        else:
            _emit_story_document_resolution_error(
                args, "STORY_DOC_BIND_FAILED", str(exc)
            )
        return 1
    finally:
        if acquired is not None:
            try:
                store.release_lease(
                    owner, acquired.lease_id, acquired.fencing_token
                )
            except StateStoreError as exc:
                output.warn(f"story document binding lease release failed: {exc.code}")

    payload = {
        "ok": True,
        "changed": bool((mutation.result or {}).get("changed")),
        "workItem": work_item,
        "storyId": story_id,
        "storyName": resolution.story_name,
        "storyDocPath": str(resolution.path),
        "storyDocSource": resolution.source,
        "revision": mutation.revision_after,
    }
    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.ok(f"Story 文档已绑定：{resolution.path}")
    return 0


def cmd_state_write(args, parser):
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    try:
        sp, work_item = _main_state_path_for_args(ade_sdd, args)
    except work_item_context.AmbiguousWorkItemError as e:
        _emit_work_item_ambiguity(e, args)
        return 1
    except (work_item_context.NoWorkItemStateError, ValueError) as e:
        _emit_state_resolution_error(e, args)
        return 1
    # 🆕 v3.9.11：镜像冻结检测 — 防 life 项目事故复发
    # 根因（v3.9.10 life 实测）：项目级镜像曾冻结指向 STORY-005 completed，
    #   但 .auto-engineering/ 下另有活跃 STORY-003 work-item。
    #   用户跑 `ae-sdd state write --phase testcase-generated`（未传 --story）时，
    #   _main_state_path_for_args 走 _active_state_from_mirror → 拿到 STORY-005 路径 →
    #   set_phase 拒绝跨步跳跃（completed 后无 next phase）→ 静默报错 → 镜像永远不刷新。
    # 修复：state write 入口先做健康检查，发现镜像指向的 work-item 与 .auto-engineering/ 下
    #   真实活跃 work-item 不一致时，输出 warn + 自动 fallback 到 work-item 源路径
    #   （按 mtime 选最近活跃），并写回正确镜像。force 参数允许显式锁定旧镜像。
    # Project-global mirror recovery is intentionally disabled. State is
    # resolved only from explicit/session/work-item scoped files.
    if not work_item and not getattr(args, "project_state", False):
        output.err("未找到 active work item。新需求必须先创建独立状态机：")
        output.info('  ae-sdd state new --id <ID> --name "<需求名>"')
        output.info("请使用 --work-item 指定任务级 state，或先运行 ae-sdd state new 创建 work-item state。")
        return 1
    s = state.read_state(sp)
    cfg = paths.read_config(ade_sdd)
    if cfg.get("projectKey") and not s.get("projectKey"):
        s["projectKey"] = cfg.get("projectKey")
    if work_item:
        s["currentWorkItem"] = work_item
        s.setdefault("workItemKey", work_item)
        s.setdefault("stateMachineId", work_item)
        # Backward compatibility: older gates still key off currentStory.
        if not s.get("currentStory") and not args.story:
            s["currentStory"] = state.get_active_story(s) if state.is_nested_state(s) else work_item
    effective_state = dict(s)
    if args.story and not effective_state.get("currentStory"):
        effective_state["currentStory"] = args.story
    if work_item and not effective_state.get("currentWorkItem"):
        effective_state["currentWorkItem"] = work_item
    if args.task and not effective_state.get("currentTask"):
        effective_state["currentTask"] = args.task
    memory_result = memory_gate.check_state_transition(
        ade_sdd=ade_sdd,
        state_data=effective_state,
        target_phase=args.phase,
        allow_empty=getattr(args, "allow_empty_memory", False),
    )
    if memory_result.get("blocked"):
        msg = memory_gate.format_transition_block(memory_result)
        if args.json:
            output.emit({"ok": False, "blocked": True, "memory": memory_result, "message": msg}, as_json=True)
        else:
            output.err(msg)
        return 1
    try:
        # 🆕 v3.5.15：首次 state write 携带 --scale 时写入（幂等：已存在则 warn 不覆盖）
        # WorkItem 入口为 BUG/OPT/CONFIG 时默认走微链，避免独立缺陷/优化误落大流程。
        requested_scale = args.scale
        requested_entry_node = args.entry_node
        if not requested_scale and not s.get("scale"):
            inferred = _infer_scale_for_work_item(work_item, requested_entry_node)
            if inferred:
                requested_scale, requested_entry_node = inferred
        if requested_scale:
            existing_scale = s.get("scale")
            if existing_scale and existing_scale != requested_scale:
                output.warn(f"state 已有 scale={existing_scale}，与本次 --scale={requested_scale} 冲突，"
                            f"保留现有 scale（如需切换请先 set_scale 重置）")
            else:
                state.set_scale(s, requested_scale, entry_node=requested_entry_node)

        # 🆕 v3.9.0 嵌套 state 分支：--sub-story 操作子状态 phase；--add-story 归入新 Story
        if getattr(args, "add_story", "") and state.is_nested_state(s):
            new_sid = args.add_story.strip()
            if state.add_story_to_nested_state(s, new_sid):
                output.ok(f"Story {new_sid} 已归入 state {s.get('stateMachineId')} 的 storyStates")
            else:
                output.warn(f"Story {new_sid} 已在 storyStates 内（幂等不覆盖）")

        if getattr(args, "sub_story", "") and state.is_nested_state(s):
            # 操作指定 Story 子状态 phase
            sub_sid = args.sub_story.strip()
            changed = state.set_story_substate_phase(s, sub_sid, args.phase,
                                                      by="ae-sdd state write --sub-story")
        elif state.is_nested_state(s) and args.story and state.get_story_substate(s, args.story):
            # 嵌套 state + --story 指向已存在子状态 → 操作子状态 phase
            changed = state.set_story_substate_phase(s, args.story, args.phase,
                                                      by="ae-sdd state write")
        elif state.is_nested_state(s) and state.get_active_story(s):
            # 嵌套 state 默认推进 activeStory，避免无 --story 时误写顶层 phase。
            changed = state.set_story_substate_phase(s, state.get_active_story(s), args.phase,
                                                      by="ae-sdd state write --active-story")
        else:
            changed = state.set_phase(s, args.phase, by="ae-sdd state write")
    except ValueError as e:
        output.err(str(e))
        return 1
    if args.story and not state.is_nested_state(s):
        s["currentStory"] = args.story
    if work_item and not state.is_nested_state(s):
        s["currentWorkItem"] = work_item
    if args.task and not state.is_nested_state(s):
        s["currentTask"] = args.task
    s["lastUpdated"] = _now_iso()
    store = StateStore(sp, allowed_root=paths.work_items_dir(ade_sdd))
    owner = LeaseOwner(
        agent_id="ae-sdd-legacy-cli",
        session_id=f"state-write-{os.getpid()}",
        host=socket.gethostname(),
        pid=os.getpid(),
    )
    operation_key = f"legacy-state-write-{os.getpid()}-{os.urandom(8).hex()}"
    acquired = None
    try:
        acquired = store.acquire_lease(owner, 30, f"{operation_key}-lease")
        expected_revision = int(s.get("revision", 0)) if type(s.get("revision", 0)) is int else 0

        def apply_legacy_state(updated):
            updated.clear()
            updated.update(s)
            return {"phase": args.phase, "legacyAdapter": True}

        mutation = store.mutate(
            expected_revision=expected_revision,
            lease_id=acquired.lease_id,
            fencing_token=acquired.fencing_token,
            idempotency_key=operation_key,
            operation="legacy.state.write",
            payload={
                "phase": args.phase,
                "story": args.story or "",
                "task": args.task or "",
                "scale": args.scale or "",
                "entryNode": args.entry_node or "",
            },
            mutate=apply_legacy_state,
        )
        s = mutation.state
    except (StateStoreError, ValueError) as e:
        if isinstance(e, StateStoreError):
            output.err(f"{e.code}: {e.message}")
            if e.remediation:
                output.info(f"  -> {e.remediation}")
        else:
            output.err(str(e))
        return 1
    finally:
        if acquired is not None:
            try:
                store.release_lease(owner, acquired.lease_id, acquired.fencing_token)
            except StateStoreError as release_error:
                output.warn(f"legacy state write lease release failed: {release_error.code}")
    _write_active_state_mirror(ade_sdd, s, work_item, sp)
    if changed:
        output.ok(f"state 更新：phase={args.phase}")
    else:
        output.warn(f"state 未变更：phase 已为 {args.phase}（history 不累加）")
    return 0


def cmd_state_relocate(args, parser):
    """🆕 v3.9.0 R5：重定位到 Story 所属 state + 重置该 Story 子状态。

    流程：
      1. 按 --story 扫描现有嵌套 state，定位其所属 state
      2. 记录到任务级/session scoped state，不写项目级镜像
      3. 若非 --no-reset，重置该 Story 子状态到 story-generated（R5）
    """
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    story_id = (args.story or "").strip()
    if not story_id:
        output.err("--story 参数必填")
        return 1

    # 1) 查找 Story 所属嵌套 state
    hit = paths.find_nested_state_by_story_id(ade_sdd, story_id)
    if not hit:
        output.err(f"Story {story_id} 未被任何嵌套 state 管理。")
        output.info("若要新建 state，请跑：")
        output.info(f'  ae-sdd state new --id {story_id} --name "<需求名>" --entry-node STORY --story-ids {story_id} --nested')
        return 1

    state_path, state_data = hit
    state_machine_id = state_data.get("stateMachineId", state_path.parent.name)

    # 2) 切镜像到该 state
    _write_active_state_mirror(ade_sdd, state_data, state_machine_id, state_path)
    output.ok(f"已重定位到 state: {state_machine_id}")
    output.info(f"  state: {state_path}")

    # 3) R5 重置子状态（除非 --no-reset）
    if not args.no_reset:
        if not state.is_nested_state(state_data):
            output.warn("该 state 非 nested 模型，跳过子状态重置")
            return 0
        if state.reset_story_substate(state_data, story_id, by="ae-sdd state relocate"):
            state.write_state(state_path, state_data)
            _write_active_state_mirror(ade_sdd, state_data, state_machine_id, state_path)
            output.ok(f"Story {story_id} 子状态已重置到 {state.STORY_RESET_TARGET_PHASE}")
            output.info(f"  （completedSteps 清空，codingRound 归零，resetHistory 保留审计）")
            output.info(f"  （已写入 artifactInvalidated 信号：下次 task-generate 将强制全量重建 Task）")
        else:
            output.warn(f"Story {story_id} 不在 storyStates 内，未重置")
    return 0


def cmd_state_next_step(args, parser):
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        output.err("未找到 .ae-sdd/ 目录（请先跑 ae-sdd init）")
        return 1
    try:
        sp, _work_item = _main_state_path_for_args(ade_sdd, args, prefer_recent=True)
    except work_item_context.AmbiguousWorkItemError as e:
        _emit_work_item_ambiguity(e, args)
        return 1
    except (work_item_context.NoWorkItemStateError, ValueError) as e:
        _emit_state_resolution_error(e, args)
        return 1
    s = state.read_state(sp)
    suggestion = state.next_step_suggestion(s)
    # 🆕 2026-07-03 缺口2:记录 next-step 判定结果(当前 phase → 建议 next),便于回溯流程跳转。
    with runtime_stats.span("state:next-step",
                            {"currentPhase": suggestion.get("current", ""),
                             "nextPhase": suggestion.get("next", "")}):
        pass  # span 仅作留痕,suggestion 已算出
    if args.json:
        output.emit(suggestion, as_json=True)
    else:
        output.info(f"当前 phase: {suggestion['current']}")
        output.info(f"下一步:     {suggestion['next']}")
        output.info(f"动作:       {suggestion['action']}")
        output.info(f"SKILL:      {suggestion['skill']}")
    return 0


# === 🆕 v3.3.0 PRD 级状态机 CLI ===

def _prd_state_path(project_root: Path, prd_id: str) -> Path:
    """Resolve `.auto-engineering/{PRD-ID}/state.json` path.

    PRD-ID format: PRD-<业务域>-<序号>（如 PRD-CS-001），参见
    `ae-sdd-skill.md §1.2` + `document-storage-skill.md §3.5`。
    """
    return project_root / ".auto-engineering" / prd_id / "state.json"


def _read_prd_state(project_root: Path, prd_id: str) -> dict:
    """Read PRD-level state.json; return {} if not exists (兼容 v3.3.0 之前未建 PRD 级 state)."""
    p = _prd_state_path(project_root, prd_id)
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        output.warn(f"PRD state.json 解析失败: {e}")
        return {}


def cmd_state_prd_init(args, parser):
    """🆕 v3.5.12 — 初始化 PRD 级 state（写入 8 字段 + prdStatus=in_progress）。

    治 P0-9/10：v3.5.12 前无此命令，PRD schema 8 字段全是死字段，
    check_prd_4_layers 永远 fail。本命令补真写入入口。
    """
    from lib import state as state_mod
    project_root = Path.cwd()
    prd_state_path = project_root / ".auto-engineering" / args.prd / "state.json"
    st = state_mod.read_state(prd_state_path)
    state_mod.prd_init(st, args.prd, args.title or "",
                       story_ids=[], size_budget={})
    state_mod.write_state(prd_state_path, st)

    if args.json:
        output.emit({"prdId": args.prd, "status": "in_progress",
                     "written": ["prdId", "storyIds", "crossStoryDeps",
                                 "crossStoryResidualRisks", "sizeBudget",
                                 "prdReview", "gateRegistry", "compactHistory", "prdStatus"]},
                    as_json=True)
    else:
        output.info(f"✅ PRD {args.prd} 初始化完成（prdStatus=in_progress）")
        output.info(f"   写入 8 字段 + prdStatus（治 P0-9/10 死字段）")
    return 0


def cmd_state_prd_check_complete(args, parser):
    """🆕 v3.3.0 — 校验 4 层 AND（G-PRD-1~4），输出未达成项，**不改状态**."""
    project_root = Path.cwd()
    prd_id = args.prd
    ps = _read_prd_state(project_root, prd_id)

    if not ps:
        output.err(f"PRD 级 state.json 不存在：{_prd_state_path(project_root, prd_id)}")
        output.info("提示：先跑 ae-sdd state prd-init（或等 Story 完成 hook 自动写入）")
        return 1

    # 复用 state.check_prd_4_layers（🆕 v3.5.4 抽出，供 HS-7 物理拦截与 CLI 共用）
    result = state.check_prd_4_layers(ps)
    result["prdStatus"] = ps.get("prdStatus", "unknown")
    all_pass = result["all_pass"]

    if args.json:
        output.emit(result, as_json=True)
    else:
        for k in ("G-PRD-1", "G-PRD-2", "G-PRD-3", "G-PRD-4"):
            r = result[k]
            icon = "✅" if r["pass"] else "🔴"
            output.info(f"{icon} {k}: {r['label']}")
            for m in r["missing"]:
                output.info(f"   - {m}")
        output.info("")
        if all_pass:
            output.ok(f"PRD {prd_id} 4 层 AND 全过；可执行 `ae-sdd state prd-complete --prd {prd_id} --runtime <runtime>`")
            return 0
        else:
            output.err(f"PRD {prd_id} 4 层 AND 未全过；阻塞 compact")
            return 1


def cmd_state_prd_complete(args, parser):
    """🆕 v3.3.0 — 校验通过后执行 compact，更新 prdStatus.

    🆕 v3.8.1 S-5：按 --runtime 分支生成 summary.md + runtime 差异化提示。
    实际 compact 由 runtime hook/session 协议执行（保持协议骨架，不直接 exec shell）。
    """
    from lib import state as state_mod
    project_root = Path.cwd()
    prd_id = args.prd
    runtime = args.runtime
    ps = _read_prd_state(project_root, prd_id)

    if not ps:
        output.err(f"PRD 级 state.json 不存在：{_prd_state_path(project_root, prd_id)}")
        return 1

    if ps.get("prdStatus") == "compacted":
        output.warn(f"PRD {prd_id} 已 compacted，跳过")
        return 0

    # 先校验 4 层 AND（建议用户先跑 prd-check-complete）
    output.info(f"PRD {prd_id} 当前 prdStatus = {ps.get('prdStatus', 'unknown')}")
    output.info("提示：建议先跑 `ae-sdd state prd-check-complete --prd {prd_id}` 校验")
    output.info(f"将触发 compact：runtime={runtime}")

    # 🆕 v3.8.1 S-5：调 state.prd_complete 生成 summary.md + 流转 prdStatus + runtime 差异化
    result = state_mod.prd_complete(ps, prd_id, runtime, project_root)
    p = _prd_state_path(project_root, prd_id)
    p.parent.mkdir(parents=True, exist_ok=True)
    state_mod.write_state(p, ps)

    output.ok(f"PRD {prd_id} prdStatus → awaiting_compact；summary.md 已生成")
    output.info(f"  summary: {result['summaryPath']}")
    output.info(f"  {result['runtimeHint']}")
    if result["compactTrigger"]:
        output.info("  claude-code compact-trigger 文件已写（UserPromptSubmit hook 将注入 /compact）")
    output.info(f"下一步：跑 `ae-sdd runtime compact --runtime {runtime} --prd {prd_id}`")
    return 0


def cmd_state_prd_archive(args, parser):
    """🆕 v3.3.0 — 归档 compactHistory 到 state.archive.json."""
    project_root = Path.cwd()
    prd_id = args.prd
    keep_last = args.keep_last
    ps = _read_prd_state(project_root, prd_id)

    if not ps:
        output.err(f"PRD 级 state.json 不存在：{_prd_state_path(project_root, prd_id)}")
        return 1

    history = ps.get("compactHistory", [])
    if len(history) <= keep_last:
        output.info(f"compactHistory 只有 {len(history)} 条，无需归档（keep_last={keep_last}）")
        return 0

    archive_path = project_root / ".auto-engineering" / prd_id / "state.archive.json"
    archive = []
    if archive_path.exists():
        try:
            archive = json.loads(archive_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            archive = []
    archive.extend(history[:-keep_last])
    ps["compactHistory"] = history[-keep_last:]

    archive_path.write_text(json.dumps(archive, ensure_ascii=False, indent=2), encoding="utf-8")
    p = _prd_state_path(project_root, prd_id)
    p.write_text(json.dumps(ps, ensure_ascii=False, indent=2), encoding="utf-8")
    output.ok(f"归档 {len(history) - keep_last} 条到 {archive_path}；state.json 保留最近 {keep_last} 条")
    return 0


def _now_iso() -> str:
    """ISO 8601 UTC timestamp."""
    import datetime as _dt
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_runtime_compact(args, parser):
    """🆕 v3.3.0 - runtime-specific compact 适配层. 🆕 v3.10.3 升级为实际触发 snapshot。

    两层 compact：
    1. 子流程级（v3.10.3 新增）：若有活跃子流程Agent，先 pre_compact_snapshot 写 memory。
    2. PRD 级（v3.3.0 原有）：summary.md + compact-trigger + prdStatus=compacted。

    实际 compact 对话清理由对应 runtime 执行：
    - mavis: `mavis session rotate --handoff-file <summary.md>`
    - claude-code: UserPromptSubmit hook 读 compact-trigger 注入 /compact
    - codex: `codex exec --json --output-last-message`
    """
    runtime = args.runtime
    prd_id = args.prd

    output.info(f"runtime compact: runtime={runtime}, prd={prd_id}")

    # 🆕 v3.10.3 子流程级 compact：若有活跃子流程Agent，snapshot 它的 memory
    from lib import state as state_mod
    from lib import memory_store
    project_root = Path.cwd()

    # 查找项目级 state（非 PRD 级）-- 用 work_item_context 解析活跃 work-item
    main_state_path = None
    try:
        from lib import work_item_context
        resolved = work_item_context.resolve_default_state(project_dir=project_root, prompt="", session_key="")
        if resolved and resolved.get("statePath"):
            main_state_path = Path(resolved["statePath"])
    except Exception:
        pass
    if main_state_path and main_state_path.is_file():
        ms = state_mod.read_state(main_state_path)
        active_agent = state_mod.get_active_subprocess_agent(ms)
        if active_agent:
            output.info(f"活跃子流程Agent: {active_agent['agentId']} ({active_agent.get('seriesType')}/{active_agent.get('entityId')})")
            try:
                scope = memory_store.locate_scope(
                    project=str(project_root),
                    entity_type=active_agent.get("memoryEntityType", active_agent.get("seriesType", "story")),
                    entity_id=active_agent.get("entityId", "default"),
                )
                if memory_store.exists_memory(scope):
                    memory_store.pre_compact_snapshot(
                        scope,
                        current_series=active_agent.get("seriesType", ""),
                        next_step="compact 后续接",
                        pending_items=[],
                        review_loop_status="compact snapshot",
                    )
                    output.ok(f"子流程 memory snapshot 已写入: {scope.entity_dir}")
                else:
                    output.warn(f"子流程 memory 不存在，跳过 snapshot: {scope.entity_dir}")
            except Exception as e:
                output.warn(f"子流程 memory snapshot 失败（不阻断 PRD compact）: {e}")

    if runtime == "mavis":
        summary_path = f".auto-engineering/{prd_id}/summary.md"
        output.info(f"将执行：mavis session rotate --handoff-file {summary_path}")
        output.info("提示：summary.md 必须先由 `ae-sdd state prd-complete` 生成；如需自动触发，加 shell hook")
    elif runtime == "claude-code":
        output.info("将执行：UserPromptSubmit hook 读 compact-trigger 注入 /compact + memory 重载")
    elif runtime == "codex":
        output.info("将执行：")
        output.info("  1. codex plugin add ae-sdd-prd-state")
        output.info("  2. codex exec --json --output-last-message .auto-engineering/{prd_id}/summary.md")
    else:
        output.err(f"未知 runtime：{runtime}（仅支持 mavis / claude-code / codex）")
        return 1

    # 🆕 v3.5.12：补真实 prdStatus 写入（闭环 5 态）
    prd_state_path = project_root / ".auto-engineering" / prd_id / "state.json"
    if prd_state_path.is_file():
        ps = state_mod.read_state(prd_state_path)
        # 若 summary.md 未生成（用户直接跑 runtime compact 跳过 prd-complete），补生成
        summary_path = project_root / ".auto-engineering" / prd_id / "summary.md"
        if not summary_path.is_file():
            state_mod.prd_complete(ps, prd_id, runtime, project_root)
        state_mod.set_prd_status(ps, "compacted")
        state_mod.write_state(prd_state_path, ps)
        output.ok(f"prdStatus -> compacted（v3.5.12 闭环写入）")
        output.info(f"summary.md: {summary_path}")
    else:
        output.warn(f"PRD state.json 不存在（{prd_state_path}），跳过 prdStatus 写入")
    return 0


def _default_runtime_verify_path() -> Path:
    root = Path(__file__).resolve().parent.parent.parent
    if (root / "SKILL.md").is_file():
        return root
    dist = root / "dist" / "ae-sdd"
    if (dist / "SKILL.md").is_file():
        return dist
    return root


def cmd_runtime_verify(args, parser):
    target = Path(args.path).expanduser() if args.path else _default_runtime_verify_path()
    result = runtime_verify.verify_runtime_package(target)
    payload = result.to_dict()

    if args.json:
        output.emit(payload, as_json=True)
    else:
        if result.ok:
            manifest = result.manifest or {}
            output.ok(f"compiled runtime verified: {result.package_path}")
            output.info(f"version: {manifest.get('version', '(unknown)')}")
            output.info(f"runtime_fingerprint: {manifest.get('runtime_fingerprint', '(missing)')}")
            if result.warnings:
                output.warn(f"warnings: {result.warnings}")
        else:
            output.err(f"compiled runtime verify failed: {result.package_path}")
            for item in result.issues:
                output.err(f"  - {item}")
            if result.warnings:
                output.warn(f"warnings: {result.warnings}")
    return 0 if result.ok else 1


def cmd_gates_check(args, parser):
    master = paths.locate_master_source()
    ade_sdd = paths.locate_project_ae_sdd()
    project_key = None
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey")
    if not project_key:
        project_key = "unknown"

    work_item = getattr(args, "work_item", "") or ""
    results = gates.check_all(
        master, ade_sdd, project_key, only=args.only, work_item=work_item
    )
    summary = gates.summarize(results)
    if work_item:
        summary["workItem"] = work_item

    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"跑了 {summary['total']} 门禁：✅ {summary['passed']} / ❌ {summary['failed']} / 🟡 {summary['stubs']} stub")
        for r in summary["results"]:
            mark = "✅" if r["pass"] else "❌"
            duration = f" ({_fmt_ms(r.get('durationMs'))})" if r.get("durationMs") is not None else ""
            output.info(f"  {mark} {r['gate_id']} {r['name']}{duration}: {r['message']}")
            if r.get("action"):
                output.info(f"      → {r['action']}")
        if summary.get("slowest"):
            output.info("最慢门禁:")
            for item in summary["slowest"]:
                output.info(f"  {item['gate_id']} {_fmt_ms(item.get('durationMs'))}")

    # 任何 blocker 失败 → exit 1
    return 0 if summary["all_pass"] else 1


def cmd_gate_ra_required(args, parser):
    """gate ra-required — 需求分析准入门卫（SKILL.md §🛡️ G-RA 契约）

    跑 G-RA-1~6 + FLOW：RA 文档存在 / 8 维度完整 / 衍生章节完整 /
    真实性扫描 / 机械派生深度 / 实现视角完整性 / 流程违规审计。
    进 dr-generate / story-generate / task-generate 前必过（微任务/BUG 豁免）。
    """
    master = paths.locate_master_source()
    # 优先用 --project 指定的目录，否则从 cwd 向上找 .ae-sdd/
    if getattr(args, "project", "") and args.project:
        ade_sdd = paths.locate_project_ae_sdd(Path(args.project))
    else:
        ade_sdd = paths.locate_project_ae_sdd()
    project_key = None
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey")
    if not project_key:
        project_key = "unknown"

    ra_gate_ids = [
        "G-RA-1",
        "G-RA-2",
        "G-RA-3",
        "G-RA-4",
        "G-RA-FLOW-VIOLATION",
        "G-RA-5",
        "G-RA-6",
    ]
    results = []
    for gid in ra_gate_ids:
        # 多个 G-RA 门禁需要 master_source 调扫描器；统一走 check_all 特判。
        r = gates.check_all(master, ade_sdd, project_key, only=gid)
        results.extend(r)

    summary = gates.summarize(results)
    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"🛡️ G-RA 需求分析准入门卫（{summary['total']} 门禁：✅ {summary['passed']} / ❌ {summary['failed']} / 🟡 {summary['stubs']} stub）")
        for r in summary["results"]:
            mark = "✅" if r["pass"] else "❌"
            output.info(f"  {mark} {r['gate_id']} {r['name']}: {r['message']}")
            if r.get("action"):
                output.info(f"      → {r['action']}")
        if not summary["all_pass"]:
            output.info("⚠️ G-RA 未通过：下游 dr-generate / story-generate / task-generate 被阻断。")
            output.info("   修复后重跑 `ae-sdd gate ra-required`，或触发 requirement-analysis-skill 生成 RA。")

    return 0 if summary["all_pass"] else 1


def cmd_gate_coding_required(args, parser):
    """gate coding-required — Coding 真实性准入门卫（CodingModel §6 反模式库）

    跑 G-CODE-1：调用 coding_authenticity_scan.py 扫 AP-1~AP-6 中可静态命中的
    Coding 反模式。进入 CodeReview / 完成判定前必过。
    """
    master = paths.locate_master_source()
    if getattr(args, "project", "") and args.project:
        ade_sdd = paths.locate_project_ae_sdd(Path(args.project))
        project_root = Path(args.project).resolve()
    else:
        ade_sdd = paths.locate_project_ae_sdd()
        project_root = Path.cwd()

    project_key = None
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey")
    if not project_key:
        project_key = "unknown"

    # check_all 会在无 .ae-sdd 时用 cwd；--project 指向非 ae-sdd 根时临时切 cwd。
    old_cwd = Path.cwd()
    try:
        if not ade_sdd and project_root:
            import os
            os.chdir(project_root)
        results = gates.check_all(master, ade_sdd, project_key, only="G-CODE-1")
    finally:
        if old_cwd != Path.cwd():
            import os
            os.chdir(old_cwd)

    summary = gates.summarize(results)
    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"🛡️ G-CODE Coding 真实性门卫（{summary['total']} 门禁：✅ {summary['passed']} / ❌ {summary['failed']} / 🟡 {summary['stubs']} stub）")
        for r in summary["results"]:
            mark = "✅" if r["pass"] else "❌"
            output.info(f"  {mark} {r['gate_id']} {r['name']}: {r['message']}")
            if r.get("action"):
                output.info(f"      → {r['action']}")
        if not summary["all_pass"]:
            output.info("⚠️ G-CODE 未通过：Coding 完成 / CodeReview 前被阻断。")
            output.info("   修复后重跑 `ae-sdd gate coding-required`。")

    return 0 if summary["all_pass"] else 1


def cmd_gate_doc_storage(args, parser):
    """gate doc-storage — 文档落地存放门卫（SKILL.md §🛡️ G-DOC-STORAGE 契约，🆕 v3.4.0）

    单点校验：给定 --path（实际写入路径）是否合规（落在合规根目录 + 非游离位置）。
    与 `gates check --only G-DOC-STORAGE`（扫描全 project_dir）互补：本命令用于"落地前"单点校验。
    """
    target_path = args.path
    if not target_path:
        output.err("必须提供 --path <实际写入路径>")
        return 1

    from pathlib import Path as _P
    p = _P(target_path)
    rel_or_abs = str(p).replace("\\", "/")
    rel_lower = rel_or_abs.lower()

    # 复用 gates.py 的合规根目录 + 游离位置定义
    compliant_roots = gates._DOC_COMPLIANT_ROOTS
    stray_markers = gates._DOC_STRAY_MARKERS

    issues: list[str] = []
    # 游离位置检测
    if any(m in rel_lower for m in stray_markers):
        issues.append(f"路径含游离位置标记（{stray_markers}）")
    # 合规根目录检测：路径中任一段匹配合规根
    in_compliant = any(root in rel_lower.split("/") for root in compliant_roots)
    if not in_compliant:
        # 允许项目根直接落产物（向后兼容），但需 --project 校验；无 --project 时标 warn
        if not args.project:
            issues.append(f"路径不在合规根目录（{compliant_roots}）下，且未提供 --project 无法判定项目根")

    result = {
        "path": target_path,
        "intent": args.intent,
        "compliant": not issues,
        "issues": issues,
    }
    if args.json:
        output.emit(result, as_json=True)
    else:
        if issues:
            output.err(f"❌ G-DOC-STORAGE 校验未通过：{'; '.join(issues)}")
            output.info(f"   路径：{target_path}")
            output.info("   修复：调 document-storage resolve_path 推导路径；禁止硬编码 d:\\tmp\\ 等游离位置")
        else:
            output.ok(f"✅ G-DOC-STORAGE 校验通过：{target_path}")
    return 0 if not issues else 1


def _resolve_ade_sdd_and_project_key(args):
    """统一解析 ade_sdd + project_key（多数命令共用）。

    优先级：--project > cwd 向上找 .ae-sdd/ > unknown。
    """
    project_arg = getattr(args, "project", "") or ""
    ade_sdd = paths.locate_project_ae_sdd(Path(project_arg)) if project_arg else paths.locate_project_ae_sdd()
    project_key = None
    if ade_sdd:
        cfg = paths.read_config(ade_sdd)
        project_key = cfg.get("projectKey")
    if not project_key:
        project_key = "unknown"
    return ade_sdd, project_key


def cmd_doc_save(args, parser):
    """doc save — 一步到位存文档（封装 document_storage.save_doc，🆕 v3.7.2）

    流程：读草稿 → save_doc（resolve+写+版本+ChangeLog+STORING+gitignore）→ 删草稿。
    对齐 document-storage-skill.md §4.3 + §9 写入 SOP。
    """
    ade_sdd, project_key = _resolve_ade_sdd_and_project_key(args)
    if not ade_sdd:
        output.err("找不到 .ae-sdd/ 项目根（可用 --project 指定）")
        return 1

    content_file = Path(args.content_file)
    if not content_file.is_file():
        output.err(f"草稿文件不存在：{args.content_file}")
        return 1
    content = content_file.read_text(encoding="utf-8")

    # version 字符串 → dict（复用 document_storage._normalize_version 的容错逻辑）
    version = None
    if args.version:
        major, minor = document_storage._normalize_version(args.version, True)
        version = {"major": major, "minor": minor}

    result = document_storage.save_doc(
        ade_sdd, project_key, args.intent, content,
        story_id=args.story_id, doc_id=args.doc_id,
        version=version, changelog_note=args.changelog_note,
        work_item_id=args.work_item,
    )

    if not result.success:
        # E000（未实现 intent）给降级提示
        if "E000" in (result.error or ""):
            output.err(f"❌ {result.error}")
            output.info("   该 intent 暂未实现路径模板。降级：LLM 手写到目标路径后用 `ae-sdd doc finalize --path <已写文件>` 补登记。")
        else:
            output.err(f"❌ {result.error}")
        return 1

    # 删草稿（除非 --keep-draft；且草稿不能等于最终路径，避免误删）
    final_path = Path(result.full_path).resolve()
    if not args.keep_draft and content_file.resolve() != final_path:
        content_file.unlink(missing_ok=True)

    output.ok(f"✅ 已存：{result.full_path}")
    if result.new_version:
        output.info(f"   版本：{result.new_version}")
    if args.json:
        output.emit({"success": result.success, "fullPath": result.full_path,
                     "newVersion": result.new_version, "changelogEntry": result.changelog_entry},
                    as_json=True)
    return 0


def cmd_doc_resolve(args, parser):
    """doc resolve — 只推路径不写（封装 document_storage.resolve_path，🆕 v3.7.2）

    用途：LLM 查"会写到哪"、或落地前单点校验路径合规。不写文件、无副作用。
    """
    ade_sdd, project_key = _resolve_ade_sdd_and_project_key(args)
    if not ade_sdd:
        output.err("找不到 .ae-sdd/ 项目根（可用 --project 指定）")
        return 1

    try:
        resolved = document_storage.resolve_path(
            ade_sdd, project_key, args.intent,
            story_id=args.story_id, doc_id=args.doc_id,
            work_item_id=args.work_item,
        )
    except document_storage.DocStorageError as e:
        output.err(f"❌ {e}")
        return 1

    payload = {
        "fullPath": resolved.full_path,
        "dirPath": resolved.dir_path,
        "fileName": resolved.file_name,
        "versionSuffix": resolved.version_suffix,
        "changelogPath": resolved.changelog_path,
        "scope": resolved.scope,
    }
    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.ok(f"📍 路径：{resolved.full_path}")
        if resolved.version_suffix:
            output.info(f"   版本后缀：{resolved.version_suffix}")
        output.info(f"   ChangeLog：{resolved.changelog_path}")
    return 0


def cmd_doc_finalize(args, parser):
    """doc finalize — 对已手写文件补版本号/ChangeLog/STORING（封装 document_storage.finalize_doc，🆕 v3.7.2）

    适用：未实现 intent 的文档 LLM 手写后补登记，或漏跑 save_doc 后处理。
    不覆盖文件内容，只补 ChangeLog + STORING + .gitignore。
    """
    ade_sdd, project_key = _resolve_ade_sdd_and_project_key(args)
    if not ade_sdd:
        output.err("找不到 .ae-sdd/ 项目根（可用 --project 指定）")
        return 1

    if not Path(args.path).is_file():
        output.err(f"目标文件不存在：{args.path}")
        return 1

    try:
        result = document_storage.finalize_doc(
            ade_sdd, project_key, args.intent, args.path,
            story_id=args.story_id, doc_id=args.doc_id,
            changelog_note=args.changelog_note,
            work_item_id=args.work_item,
        )
    except document_storage.DocStorageError as e:
        output.err(f"❌ {e}")
        return 1

    output.ok(f"✅ 已登记：{result.full_path}")
    if result.changelog_entry:
        output.info(f"   ChangeLog：已追加")
    if args.json:
        output.emit({"success": result.success, "fullPath": result.full_path,
                     "newVersion": result.new_version, "changelogEntry": result.changelog_entry},
                    as_json=True)
    return 0


def _project_dir_from_args(args) -> Path:
    if getattr(args, "project", ""):
        return Path(args.project).resolve()
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is not None:
        return paths.project_root(ade_sdd).resolve()
    return Path.cwd().resolve()


def _read_json_file(path_text: str) -> dict:
    path = Path(path_text)
    return json.loads(path.read_text(encoding="utf-8"))


def cmd_baseline_inspect(args, parser):
    project_dir = _project_dir_from_args(args)
    payload, error = baseline.load(project_dir, args.gate)
    result = {
        "path": str(baseline.baseline_path(project_dir, args.gate)),
        "exists": payload is not None,
        "integrity": "valid" if payload is not None and error is None else error,
        "gateId": args.gate,
        "findingCount": len((payload or {}).get("findings", [])),
    }
    if args.json:
        output.emit({**result, "baseline": payload}, as_json=True)
    else:
        mark = "✅" if result["integrity"] == "valid" else "❌"
        output.info(f"{mark} baseline {args.gate}: {result['integrity']} ({result['findingCount']} findings)")
        output.info(f"   path: {result['path']}")
    return 0 if result["integrity"] == "valid" else 1


def cmd_baseline_create(args, parser):
    project_dir = _project_dir_from_args(args)
    if not args.approve:
        output.err("baseline create requires --approve; first-time debt acceptance is explicit")
        return 1
    try:
        report = _read_json_file(args.report_file)
    except (OSError, json.JSONDecodeError) as exc:
        output.err(f"cannot read scan report: {exc}")
        return 1
    payload = baseline.create(
        project_dir,
        args.gate,
        report.get("findings", []),
        created_by=args.created_by,
        scanner_version=args.scanner_version,
        ruleset_fingerprint=args.ruleset_fingerprint,
        project_fingerprint=args.project_fingerprint,
        require_user_approval=True,
    )
    result = {"path": str(baseline.baseline_path(project_dir, args.gate)), "findingCount": len(payload["findings"]), "baseline": payload}
    if args.json:
        output.emit(result, as_json=True)
    else:
        output.ok(f"✅ baseline created: {result['path']} ({result['findingCount']} findings)")
    return 0


def cmd_baseline_diff(args, parser):
    project_dir = _project_dir_from_args(args)
    payload, error = baseline.load(project_dir, args.gate)
    if error:
        output.err(f"baseline unavailable: {error}")
        return 1
    try:
        report = _read_json_file(args.report_file)
    except (OSError, json.JSONDecodeError) as exc:
        output.err(f"cannot read scan report: {exc}")
        return 1
    touched = [p.strip() for p in (args.touched or "").split(",") if p.strip()]
    result = baseline.compare(payload, report.get("findings", []),
                              ruleset_fingerprint=args.ruleset_fingerprint,
                              touched_paths=touched)
    if args.json:
        output.emit(result, as_json=True)
    else:
        mark = "✅" if result["status"] == "PASS_WITH_BASELINE_DEBT" else "❌"
        output.info(f"{mark} {result['status']}: new={len(result['new'])} touchedDebt={len(result['touchedDebt'])} resolved={len(result['resolved'])}")
    return 0 if result["status"] == "PASS_WITH_BASELINE_DEBT" else 1


def cmd_verify_plan(args, parser):
    project_dir = _project_dir_from_args(args)
    changed = [p.strip() for p in (args.changed or "").split(",") if p.strip()]
    if not changed:
        try:
            proc = subprocess.run(["git", "-C", str(project_dir), "diff", "--name-only"], capture_output=True, text=True, check=False)
            changed = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
        except OSError:
            changed = []
    try:
        changed = verification_plan.validate_changed_paths(project_dir, changed)
        work_item = (args.work_item or "").strip()
        result = verification_plan.build_plan(
            project_dir, args.story, changed, args.since_fingerprint, work_item
        )
        if args.persist:
            ade_sdd = project_dir / ".ae-sdd"
            if not ade_sdd.is_dir():
                raise ValueError(f"project has no .ae-sdd directory: {project_dir}")
            if not work_item:
                raise ValueError("--persist requires --work-item")
            state_path = paths.find_work_item_state_path(ade_sdd, work_item)
            if state_path is None:
                raise ValueError(f"cannot resolve existing work item: {work_item}")
            state_data = state.read_state(state_path)
            recorded_story = str(state_data.get("currentStory") or state_data.get("activeStory") or "")
            if recorded_story and recorded_story != args.story:
                raise ValueError(
                    f"work item story mismatch: state={recorded_story}, requested={args.story}"
                )
            state_data["verificationPlan"] = result
            state.write_state(state_path, state_data)
    except ValueError as exc:
        output.err(str(exc))
        return 1
    if args.json:
        output.emit(result, as_json=True)
    else:
        output.info(f"VerificationPlan {args.story}: {', '.join(result['changeClass']) or 'none'}")
        output.info(f"   required: {', '.join(result['required'])}")
        if result["deferredUntilFinal"]:
            output.info(f"   deferred: {', '.join(result['deferredUntilFinal'])}")
    return 0


def cmd_evidence_finalize(args, parser):
    project_dir = _project_dir_from_args(args)
    try:
        manifest_path, manifest = evidence.finalize_manifest(project_dir, args.story)
    except ValueError as exc:
        output.err(str(exc))
        return 1
    result = {
        "manifestPath": str(manifest_path),
        "contentHash": manifest.get("contentHash"),
        "integrityStatus": manifest.get("_integrityStatus"),
    }
    if args.json:
        output.emit(result, as_json=True)
    else:
        output.ok(f"evidence manifest finalized: {manifest_path}")
    return 0


def cmd_evidence_record(args, parser):
    project_dir = _project_dir_from_args(args)
    artifacts = _read_json_file(args.artifacts_file).get("artifacts", []) if args.artifacts_file else []
    entry = evidence.record(
        project_dir,
        args.story,
        kind=args.kind,
        command=args.command,
        input_fingerprint=args.input_fingerprint,
        toolchain_fingerprint=args.toolchain_fingerprint,
        exit_code=args.exit_code,
        artifacts=artifacts,
        summary=_read_json_file(args.summary_file) if args.summary_file else {},
        duration_ms=args.duration_ms,
        freshness_window_seconds=args.freshness_window_seconds,
    )
    if args.json:
        output.emit({"manifestPath": str(evidence.manifest_path(project_dir, args.story)), "entry": entry}, as_json=True)
    else:
        output.ok(f"✅ evidence recorded: {entry['evidenceId']}")
    return 0


def cmd_evidence_lookup(args, parser):
    project_dir = _project_dir_from_args(args)
    entry = evidence.find_reusable(
        project_dir,
        args.story,
        input_fingerprint=args.input_fingerprint,
        command=args.command,
        toolchain_fingerprint=args.toolchain_fingerprint,
    )
    result = {"reusable": entry is not None, "entry": entry, "manifestPath": str(evidence.manifest_path(project_dir, args.story))}
    if args.json:
        output.emit(result, as_json=True)
    elif entry:
        output.ok(f"✅ reusable evidence: {entry['evidenceId']}")
    else:
        output.info("⚪ no reusable evidence")
    return 0


def cmd_update_check(args, parser):
    """update-check — 更新依赖图谱（v3.2 — 改了 A 要同步 BCDEFG）

    两种模式：
    1. 查询模式（--affected <files>）：改了这些文件，连带项是什么 + 该跑哪些检查
       用法：ae-sdd update-check --affected tools/lib/gates.py,source/SKILL.md
    2. 检查模式（默认/--only）：跑 UC-01~UC-05 验证无漏更新
    """
    repo_root = Path(__file__).resolve().parent.parent.parent

    # ── 查询模式：改了文件，问连带项 ──
    if args.affected:
        files = [f.strip() for f in args.affected.split(",") if f.strip()]
        qr = update_graph.query_affected(files, repo_root)
        payload = {
            "changed_files": qr.changed_files,
            "matched_rules": qr.matched_rules,
            "affected_items": qr.affected_items,
            "checks_to_run": qr.checks_to_run,
        }
        if args.json:
            output.emit(payload, as_json=True)
        else:
            output.info(f"🔗 查询：改了 {len(qr.changed_files)} 个文件 → 命中 {len(qr.matched_rules)} 条图谱规则")
            output.info("")
            output.info("📋 连带项（必须同步检查，去重后）：")
            for a in qr.affected_items:
                auto = " [自动可检]" if a["auto_checkable"] else " [人工确认]"
                output.info(f"  • [{a['from_rule']}] {a['path']}{auto}")
                output.info(f"      → {a['action']}")
            output.info("")
            output.info(f"🔍 该跑检查：{qr.checks_to_run}")
            if qr.checks_to_run:
                output.info(f"   跑 `ae-sdd update-check --only {qr.checks_to_run[0]}` 逐项验证（或直接 `ae-sdd update-check` 全量）")
            else:
                output.info("   无需运行图谱检查（未命中已知规则）")
        return 0

    # ── 检查模式：跑 UC-01~UC-12（含 AA 全维对齐 UC-08~12，v3.5.11）──
    # AA（alignment_audit）注册到 update_graph.CHECK_FUNCS，统一调度
    from lib import alignment_audit  # noqa: F401 — 触发 register_to_update_graph()
    results = update_graph.check_all(repo_root, only=args.only)
    summary = update_graph.summarize(results)

    if args.json:
        output.emit(summary, as_json=True)
    else:
        output.info(f"🔗 更新依赖图谱检查（{summary['total']} 项：✅ {summary['passed']} / ❌ {summary['failed']} / 🟡 {summary['warnings']} warn）")
        for c in summary["checks"]:
            mark = "✅" if c["pass"] else ("🟡" if c["severity"] == "warn" else "❌")
            output.info(f"  {mark} {c['check_id']} {c['name']}: {c['message']}")
            if c.get("fix") and not c["pass"]:
                output.info(f"      → {c['fix']}")
        if summary["failed"] > 0:
            output.info("⚠️ 存在漏更新或 AA 对齐缺口：按上述 fix 修复后重跑 `ae-sdd update-check`。")
        else:
            output.info("✅ 更新闭环完整，无漏更新，AA 全维对齐通过。")

    return 0 if summary["failed"] == 0 else 1


def cmd_iteration_check(args, parser):
    """iteration-check — 设计-实现一致性迭代检查（🆕 v3.5.4）

    补 UC-01~07 自动检查的 4 类盲区：HS 物理实现齐全度 / 幽灵命令整段描述 /
    F-1 交叉验证覆盖面 / 已实现未接入。不阻断 dev-sync（report-only），
    与 update-check 互补不替代。

    对应 SOP：ae-sdd-update-skill.md §设计-实现一致性迭代检查
    """
    repo_root = paths.locate_master_source() or Path.cwd()
    if repo_root and repo_root.name == "source":
        repo_root = repo_root.parent  # locate_master_source 返回 source/，取 parent 为仓库根
    if args.project:
        repo_root = Path(args.project)

    from lib import iteration_check as ic
    report = ic.run_all(repo_root)

    if args.json:
        output.emit(report.to_dict(), as_json=True)
    else:
        output.info(f"🆕 v3.5.4 设计-实现一致性迭代检查（补 UC 盲区，report-only 不阻断）")
        output.info(f"跑了 {len(report.checks_run)} 项检查：{', '.join(report.checks_run)}")
        output.info(f"发现 {len(report.findings)} 项（{report.n_warn} warn / {report.n_info} info）")
        output.info("")
        # 按 check_id 分组输出
        from collections import defaultdict
        by_check: dict = defaultdict(list)
        for f in report.findings:
            by_check[f.check_id].append(f)
        check_names = {
            "IC-1": "过时技术栈/幽灵命令扫描",
            "IC-2": "F-1 交叉验证覆盖面",
            "IC-3": "已实现未接入扫描",
            "IC-4": "HS 物理实现粗筛",
        }
        for cid in ("IC-1", "IC-2", "IC-3", "IC-4"):
            findings = by_check.get(cid, [])
            output.info(f"── {cid} {check_names.get(cid, '')}（{len(findings)} 项）──")
            if not findings:
                output.info("  ✅ 无发现")
            for f in findings:
                icon = "🟡" if f.severity == "warn" else "ℹ️"
                output.info(f"  {icon} [{f.severity}] {f.item}")
                output.info(f"      定位: {f.location}")
                output.info(f"      详情: {f.detail}")
            output.info("")

        if report.n_warn > 0:
            output.warn(
                f"发现 {report.n_warn} 项 warn：建议按 ae-sdd-update-skill.md "
                f"§设计-实现一致性迭代检查 SOP 步骤2-4 人工确认并修复"
            )
        else:
            output.ok("无 warn，机器粗筛通过（语义级核对仍需人工 SOP 步骤2）")

    # report-only，始终返回 0（不阻断 dev-sync）
    return 0


def cmd_ra_gate(args, parser):
    """ra-gate — RA 任务入口硬触发（🆕 2026-06-27，建议书 §3.5）

    判定用户输入触发"出文档类任务"时，RA skill 是否强制触发。
    输出：trigger_skill / min_flow / block_direct_output / reasoning。
    与 SKILL.md §4 维判定智能路由表 + RA skill §反模式 8/9 配套。

    凭证前置（v3.4.0 加固）：调用本 CLI 前应已 `ae-sdd enter <projectKey> --story <STORY>`
    领凭证。本 CLI 不强制阻断（向后兼容），但未领凭证时输出 warn。
    """
    input_type = args.input_type

    # 6 类输入类型判定（对齐 SKILL.md §4 维判定智能路由）
    type_map = {
        "pdf-analysis": {
            "trigger_skill": "requirement-analysis-skill",
            "min_flow": "7-step",
            "block_direct_output": True,
            "reasoning": "PDF 分析类任务属于'修订建议书/proposal/分析报告'输入类型，必须走 RA skill 完整 7 步",
        },
        "doc-analysis": {
            "trigger_skill": "requirement-analysis-skill",
            "min_flow": "7-step",
            "block_direct_output": True,
            "reasoning": "文档分析类任务属于'分析报告'输入类型，必须走 RA skill 完整 7 步",
        },
        "proposal": {
            "trigger_skill": "requirement-analysis-skill",
            "min_flow": "7-step",
            "block_direct_output": True,
            "reasoning": "proposal 类任务属于'修订建议书'输入类型，必须走 RA skill 完整 7 步",
        },
        "research": {
            "trigger_skill": "requirement-analysis-skill",
            "min_flow": "7-step",
            "block_direct_output": True,
            "reasoning": "调研类任务属于'调研文档'输入类型，必须走 RA skill 完整 7 步",
        },
        "bug-fix": {
            "trigger_skill": "coding-skill (BUG path)",
            "min_flow": "ra-simplified (5-dim scale)",
            "block_direct_output": False,
            "reasoning": "BUG 类任务走 coding-skill，RA 简化版（仅 5 维规模裁定），intent=BUG 双重豁免",
        },
        "config": {
            "trigger_skill": "coding-skill (CONFIG path)",
            "min_flow": "ra-simplified (5-dim scale)",
            "block_direct_output": False,
            "reasoning": "配置类任务走 coding-skill 特殊-非代码路径，intent=CONFIG 双重豁免",
        },
    }
    result = type_map.get(input_type)
    if result is None:
        output.error(f"未知 input-type: {input_type}（允许: {list(type_map.keys())}）")
        return 2

    # 凭证前置检查（v3.4.0 加固 — 仅 warn 不阻断，向后兼容）
    ade_sdd = paths.locate_project_ae_sdd() if not args.project else paths.locate_project_ae_sdd(Path(args.project))
    entry_warn = None
    if ade_sdd:
        try:
            from lib import session as session_mod
            story_scope = (getattr(args, "story", "") or "").strip()
            if not story_scope:
                try:
                    resolved_state = work_item_context.resolve_default_state(ade_sdd)
                    story_scope = state.get_active_story(resolved_state.data) or resolved_state.key
                except work_item_context.AmbiguousWorkItemError:
                    story_scope = ""
            if not session_mod.has_valid_entry_token(ade_sdd, story_scope):
                entry_warn = "未领 entry token（建议先跑 `ae-sdd enter <projectKey> --story <STORY-ID>`）"
        except Exception:
            pass  # 母版仓库无 .ae-sdd/，跳过

    payload = dict(result)
    payload["input_type"] = input_type
    if entry_warn:
        payload["entry_warn"] = entry_warn

    if args.json:
        output.emit(payload, as_json=True)
    else:
        output.info(f"🆕 v3.5.6 RA 任务入口判定（建议书 §3.5）")
        output.info(f"输入类型：{input_type}")
        output.info(f"触发 SKILL：{result['trigger_skill']}")
        output.info(f"最小流程：{result['min_flow']}")
        output.info(f"阻断直接出文档：{'是' if result['block_direct_output'] else '否'}")
        output.info(f"理由：{result['reasoning']}")
        if entry_warn:
            output.warn(f"⚠️ {entry_warn}")
    return 0


def cmd_flow_violation_scan(args, parser):
    """flow-violation-scan — RA 流程违规审计（🆕 2026-06-27，建议书 §3.4）

    调 scripts/flow_violation_scan.py 跑 8 条规则扫描 RA 文档合规性。
    与 gates check --only G-RA-FLOW-VIOLATION 内部调同一脚本，本 CLI 提供独立入口。
    """
    import subprocess
    master = paths.locate_master_source()
    # 兼容开发仓库（master=source/，脚本在 source/../scripts/）+ 分发包（master=dist/，脚本在 dist/scripts/）
    candidates = []
    if master:
        candidates = [master.parent / "scripts" / "flow_violation_scan.py",
                      master / "scripts" / "flow_violation_scan.py"]
    candidates.append(Path("scripts/flow_violation_scan.py"))
    scanner = next((c for c in candidates if c.is_file()), None)
    if scanner is None:
        output.error(f"未找到 flow_violation_scan.py（候选：{candidates}）")
        return 2

    root = args.root or str(Path.cwd())
    cmd = [sys.executable, str(scanner), "--root", root, "--format", "json"]
    try:
        result = runtime_exec.run_command(
            cmd,
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
            span_name="scanner:flow_violation",
        )
    except subprocess.TimeoutExpired:
        output.error("flow_violation_scan.py 跑超过 120 秒")
        return 3

    report = {}
    if args.json:
        sys.stdout.write(result.stdout)
        try:
            report = json.loads(result.stdout) if result.stdout else {}
        except json.JSONDecodeError:
            pass
    else:
        try:
            report = json.loads(result.stdout) if result.stdout else {}
        except json.JSONDecodeError:
            output.error(f"扫描器 JSON 输出无法解析：{result.stdout[:200]}")
            return 4
        stats = report.get("reportStats", {})
        output.info(f"🆕 v3.5.6 RA 流程违规审计（8 条规则）")
        output.info(f"扫描根：{report.get('root', root)}")
        output.info(f"RA 文件数：{stats.get('raFiles', 0)}")
        output.info(f"状态：{report.get('status', 'UNKNOWN')}")
        output.info(f"阻断违规：{stats.get('blockerViolations', 0)} / 警告违规：{stats.get('warnViolations', 0)}")
        output.info(f"规则通过：{stats.get('rulesPassed', 0)} / 8 / 规则失败：{stats.get('rulesFailed', 0)} / 8")
        findings = report.get("findings", [])
        if findings:
            output.info("")
            output.info("违规清单：")
            for f in findings:
                icon = "🔴" if f.get("severity") == "BLOCKER" else "🟡"
                output.info(f"  {icon} [{f.get('rule')}] {f.get('path')}:{f.get('line')}")
                output.info(f"      {f.get('message')}")

    return 1 if report.get("status") == "FAIL" and args.strict else 0


