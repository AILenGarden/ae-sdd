# ─── 🆕 v3.10.3 subprocess 命令族（3层Agent模型）────────────────────────────


def cmd_subprocess_spawn(args, parser):
    """注册子流程Agent（物理独立 session 接管单个系列）。"""
    try:
        sp = _resolve_state_path_for_args(args)
        st = state.read_state(sp)
        record = state.register_subprocess_agent(
            st,
            series_type=args.series,
            entity_id=args.entity_id,
            memory_entity_type=args.memory_entity_type or "",
            session_id=args.session_id or "",
            deadline=args.deadline or "",
        )
        state.write_state(sp, st)
    except Exception as e:
        output.err(str(e))
        return 1
    output.ok(f"✅ 子流程Agent已注册：{record['agentId']} ({args.series}/{args.entity_id})")
    output.emit(record, as_json=args.json)
    return 0


def cmd_subprocess_list(args, parser):
    """列出子流程Agent。"""
    try:
        sp = _resolve_state_path_for_args(args)
        st = state.read_state(sp)
        agents = state.list_subprocess_agents(st, status=args.status or "")
    except Exception as e:
        output.err(str(e))
        return 1
    output.emit({"agents": agents, "count": len(agents)}, as_json=args.json)
    return 0


def cmd_subprocess_status(args, parser):
    """查询单个子流程Agent状态。"""
    try:
        sp = _resolve_state_path_for_args(args)
        st = state.read_state(sp)
        agents = state.list_subprocess_agents(st)
        match = [a for a in agents if a.get("agentId") == args.agent_id]
        if not match:
            output.err(f"subprocessAgent not found: {args.agent_id}")
            return 1
    except Exception as e:
        output.err(str(e))
        return 1
    output.emit(match[0], as_json=args.json)
    return 0


def cmd_subprocess_collect(args, parser):
    """子流程Agent完成回传：标记 completed + 记录交付物 + 清理 memory。"""
    try:
        sp = _resolve_state_path_for_args(args)
        st = state.read_state(sp)
        deliverables = []
        if args.deliverables:
            import json as _json
            deliverables = _json.loads(args.deliverables)
        record = state.collect_subprocess_agent(st, args.agent_id, deliverables=deliverables)
        state.write_state(sp, st)
        # 清理对应实体的 memory（子流程结束删临时上下文，留业务成果）
        if args.skip_clean_memory:
            clean_result = {"skipped": True}
        else:
            from lib import memory_store
            scope = memory_store.locate_scope(
                project=str(sp.parent.parent),
                entity_type=record.get("memoryEntityType", record.get("seriesType", "story")),
                entity_id=record.get("entityId", "default"),
            )
            clean_result = memory_store.clean_memory(scope)
    except Exception as e:
        output.err(str(e))
        return 1
    output.ok(f"✅ 子流程Agent已收集：{args.agent_id} (deliverables={len(deliverables)})")
    output.emit({"agent": record, "memoryClean": clean_result}, as_json=args.json)
    return 0


