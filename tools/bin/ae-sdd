def cmd_review_loop_verify_exit(args, parser):
    """review-loop verify-exit — 退出条件校验（gates G-REVIEW-LOOP 兜底用）。"""
    from lib import review_loop as rl_mod
    from lib import state as state_mod
    ade_sdd, story_id, sp = _resolve_state_path(args)
    st = state_mod.read_state(sp)
    passed, reason = rl_mod.verify_exit(st.get("reviewLoop") or {})
