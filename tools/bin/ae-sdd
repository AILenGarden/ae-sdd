    # memory toolset (P0): mandatory phase-aware memory hooks
    p_mem = sub.add_parser("memory", help="phase-aware memory toolset", parents=[common])
    mem_sub = p_mem.add_subparsers(dest="subcmd", required=True, metavar="<subcmd>")

    def _memory_common(p):
        p.add_argument("--project", default="", help="project root (default cwd)")
        p.add_argument("--phase", required=True, help="ra / design / coding-plan / coding / review")
        p.add_argument("--story", default="", help="Story ID")
        p.add_argument("--task", default="", help="Task ID")
        p.add_argument("--actor", default="ae-sdd", help="actor name")

    p_mem_enter = mem_sub.add_parser("enter", help="mandatory memory pre-read marker", parents=[common])
    _memory_common(p_mem_enter)
    p_mem_enter.add_argument("--note", default="", help="enter note")
    p_mem_enter.set_defaults(func=cmd_memory_enter)

    p_mem_write = mem_sub.add_parser("write", help="write phase memory", parents=[common])
    _memory_common(p_mem_write)
    p_mem_write.add_argument("--summary", required=True, help="memory summary")
    p_mem_write.add_argument("--layer", default="L1", help="L0/L1/L2/L3/L4")
    p_mem_write.add_argument("--kind", default="observation", help="decision / finding / issue / observation")
    p_mem_write.add_argument("--evidence", action="append", default=[], help="evidence reference")
    p_mem_write.add_argument("--tag", action="append", default=[], help="tag")
    p_mem_write.set_defaults(func=cmd_memory_write)

    p_mem_exit = mem_sub.add_parser("exit", help="mandatory memory post-write gate", parents=[common])
    _memory_common(p_mem_exit)
    p_mem_exit.add_argument("--allow-empty", action="store_true", help="allow no write (explicit exception)")
    p_mem_exit.set_defaults(func=cmd_memory_exit)

    p_mem_read = mem_sub.add_parser("read", help="read phase memory", parents=[common])
    _memory_common(p_mem_read)
    p_mem_read.add_argument("--limit", type=int, default=20, help="max entries")
    p_mem_read.add_argument("--no-project", action="store_true", help="do not include L2 project memory")
    p_mem_read.set_defaults(func=cmd_memory_read)

    p_mem_search = mem_sub.add_parser("search", help="search memory", parents=[common])
    _memory_common(p_mem_search)
    p_mem_search.add_argument("--query", required=True, help="search query")
    p_mem_search.add_argument("--limit", type=int, default=20, help="max entries")
    p_mem_search.set_defaults(func=cmd_memory_search)

    p_mem_promote = mem_sub.add_parser("promote", help="promote memories across layers", parents=[common])
