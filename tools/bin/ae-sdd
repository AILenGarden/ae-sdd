        return 2

    root = args.root or str(Path.cwd())
    cmd = [sys.executable, str(scanner), "--root", root, "--format", "json"]
    try:
        result = runtime_exec.run_command(
            cmd,
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
            span_name="scanner:ra_depth",
        )
    except subprocess.TimeoutExpired:
        output.error("ra_depth_scan.py 跑超过 120 秒")
        return 3

    report = {}
    if args.json:
        sys.stdout.write(result.stdout)
        try:
            report = json.loads(result.stdout) if result.stdout else {}
        except json.JSONDecodeError:
            pass
    else:
        try:
            report = json.loads(result.stdout) if result.stdout else {}
        except json.JSONDecodeError:
            output.error(f"扫描器 JSON 输出无法解析：{result.stdout[:200]}")
            return 4
        rule_stats = report.get("ruleStats", {})
        output.info(f"🆕 v3.5.9 RA 机械派生深度扫描（D1-D5，5 条规则）")
        output.info(f"扫描根：{report.get('root', root)}")
        output.info(f"RA 文件数：{report.get('raFiles', 0)}")
        output.info(f"状态：{report.get('status', 'UNKNOWN')}")
        output.info(f"阻断违规：{report.get('blockers', 0)} / 警告违规：{report.get('warnings', 0)}")
        output.info(f"各规则命中：D1={rule_stats.get('D1', 0)} D2={rule_stats.get('D2', 0)} "
                    f"D3={rule_stats.get('D3', 0)} D4={rule_stats.get('D4', 0)} D5={rule_stats.get('D5', 0)}")
        findings = report.get("findings", [])
        if findings:
            output.info("")
            output.info("违规清单：")
            for f in findings:
                icon = "🔴" if f.get("severity") == "BLOCKER" else "🟡"
                output.info(f"  {icon} [{f.get('rule')}] {f.get('path')}:{f.get('line')}")
                output.info(f"      {f.get('message')}")

    return 1 if report.get("status") == "FAIL" and args.strict else (1 if report.get("blockers", 0) > 0 else 0)


