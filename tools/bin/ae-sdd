            for f in findings:
                icon = "🔴" if f.get("severity") == "BLOCKER" else "🟡"
                output.info(f"  {icon} [{f.get('rule')}] {f.get('path')}:{f.get('line')}")
                output.info(f"      {f.get('message')}")

    return 1 if report.get("status") == "FAIL" and args.strict else (1 if report.get("blockers", 0) > 0 else 0)


def cmd_context_pressure(args, parser):
    """context-pressure — 节点级上下文压力软提示（🆕 v3.5.5）

    5 信号采集（session.userConfirmedPhases / state.events / state.history /
    state.activeAgents / 落盘文档总字节），与可配置阈值比对，
    输出 low / medium / high / critical 评级。**仅软提示，不阻断流程**。

    对应 SOP：source/SKILL.md §⏱️ 节点级上下文压力软提示
    """
    from lib import context_pressure as cp_mod
    ade_sdd = paths.locate_project_ae_sdd()
    story_id = _work_item_arg(args)
    if not story_id and ade_sdd is not None:
        try:
            resolved_state = work_item_context.resolve_default_state(ade_sdd)
            story_id = resolved_state.key
        except work_item_context.AmbiguousWorkItemError as e:
            _emit_work_item_ambiguity(e, args)
            return 1
    report = cp_mod.run_all(ade_sdd, story_id)

    if args.json:
        output.emit(report.to_dict(), as_json=True)
    else:
        # 评级 emoji
        icon = {"low": "🟢", "medium": "⚠ ", "high": "🟠", "critical": "🔴"}.get(
            report.pressure, "ℹ️"
        )
        output.info(f"⏱️  节点级上下文压力（🆕 v3.5.5，report-only 不阻断）")
        output.info(f"   评级：{icon} {report.pressure.upper()}")
        sig = report.signals
        output.info(
            f"   signals: confirmedPhases={sig.get('confirmedPhases', 0)} | "
            f"events={sig.get('events', 0)} | history={sig.get('historyLen', 0)} | "
            f"docBytes={sig.get('docBytes', 0)} | activeAgents={sig.get('activeAgents', 0)}"
        )
        if report.triggered:
            triggers = ", ".join(
                f"{t.signal}={t.value} ≥ {t.threshold}({t.limit})"
                for t in report.triggered
            )
            output.info(f"   触发信号：{triggers}")
        if report.pressure == "critical" and report.suggestions:
            output.warn("critical 级推荐动作（不阻断）：")
            for s in report.suggestions:
                output.info(f"   - {s}")
        output.info(f"   {report.to_dict()['nextAction']}")

    # report-only，始终返回 0（不阻断流程）
    return 0


# ─── 🆕 v3.5.12 review-loop CLI（编排层状态机，治 P0-1/2/4）─────────────────

def _resolve_state_path(args):
    """解析 state.json 路径（--work-item/--story > active 状态机 > 项目级）。"""
    ade_sdd = paths.locate_project_ae_sdd()
    if ade_sdd is None:
        return None, "", Path.cwd() / ".ae-sdd" / "state.json"
    work_item = _work_item_arg(args)
    if work_item:
        sp, resolved_key = _main_state_path_for_args(ade_sdd, args)
        return ade_sdd, work_item or resolved_key, sp
    if getattr(args, "project_state", False):
        raise ValueError("project-level .ae-sdd/state.json is not supported; use --work-item")
    resolved = work_item_context.resolve_default_state(ade_sdd)
    return ade_sdd, resolved.key, resolved.path


def _resolve_state_path_or_error(args):
    try:
        return _resolve_state_path(args)
    except work_item_context.AmbiguousWorkItemError as e:
        _emit_work_item_ambiguity(e, args)
        return None
    except (work_item_context.NoWorkItemStateError, ValueError) as e:
        _emit_state_resolution_error(e, args)
        return None


def cmd_review_loop_start(args, parser):
    """review-loop start — 初始化/读 reviewState，机械派生 Tier，输出派活指令。

    半自动模式（对齐 ⑥.10 test-verifier）：CLI 算 Tier + 状态机，root agent
    按 dispatchHint 用 Agent 工具派 reviewer（智能层 CLI 不耦合 runtime）。
    """
    from lib import review_loop as rl_mod
    from lib import state as state_mod
    resolved = _resolve_state_path_or_error(args)
    if resolved is None:
        return 1
    ade_sdd, story_id, sp = resolved
    st = state_mod.read_state(sp)
    legacy_review = st.get("reviewLoop") or {}
    if legacy_review and int(legacy_review.get("schemaVersion", 0) or 0) < review_batch.SCHEMA_VERSION and sp.is_file():
        backup = sp.with_name("state.review-v1.backup.json")
        if not backup.exists():
            shutil.copy2(sp, backup)
    budgets = {
        "maxAttempts": args.max_attempts,
        "maxValidBatches": args.max_valid_batches,
        "maxRemediations": args.max_remediations,
        "maxWallClockMinutes": args.max_wall_clock_minutes,
    }
    result = rl_mod.start(
        st,
        args.node,
        args.ra_size,
        args.decision_hints or "",
        input_fingerprint=args.input_fingerprint or "",
        budgets={k: v for k, v in budgets.items() if v is not None},
    )
    state_mod.write_state(sp, st)

    if args.json:
        output.emit(result, as_json=True)
    else:
        output.info(f"🔄 review-loop start（🆕 v3.5.12，节点={args.node}）")
        output.info(f"   Tier: {result['tier']}（需 {result['reviewersNeeded']} 个 reviewer）")
        output.info(f"   视角: {', '.join(result['lens'])}")
        output.info(f"   当前进度: round={result['round']} dryCounter={result['dryCounter']}")
        output.info(f"   → {result['dispatchHint']}")
    return 0


def cmd_review_loop_collect(args, parser):
    """review-loop collect — 收 reviewer 报告：验 session + 算新增 + 推进轮次。"""
    from lib import review_loop as rl_mod
    from lib import state as state_mod
    from lib import session as session_mod
    resolved = _resolve_state_path_or_error(args)
    if resolved is None:
        return 1
    ade_sdd, story_id, sp = resolved
    st = state_mod.read_state(sp)

    # 读 root sessionId
    root_sess = session_mod.read_session(ade_sdd, story_id) or {}
    root_sid = root_sess.get("sessionId", "")

    # 解析 reports（JSON 字符串或文件路径列表）
    import json as _json
    reports = []
    role_names = [s.strip().upper() for s in (args.roles or "").split(",") if s.strip()]
    status_names = [s.strip().upper() for s in (args.statuses or "").split(",") if s.strip()]
    for idx, r in enumerate(args.reports.split(",")):
        r = r.strip()
        if not r:
            continue
        # 支持 path|sessionId、report JSON 或 report 文件路径。
        if r.startswith("{"):
            try:
                parsed = _json.loads(r)
                reports.append(parsed if isinstance(parsed, dict) else {"findings": []})
            except _json.JSONDecodeError:
                reports.append({"report": r, "sessionId": "", "findings": []})
        elif "|" in r:
            path, sid = r.split("|", 1)
            reports.append({"report": path.strip(), "sessionId": sid.strip(), "findings": []})
        else:
            reports.append({"report": r, "sessionId": "", "findings": []})
        reports[-1].setdefault("role", role_names[idx] if idx < len(role_names) else "")
        reports[-1].setdefault("status", status_names[idx] if idx < len(status_names) else "PASS")

    # session-ids 参数（与 reports 对齐）
    sids = [s.strip() for s in (args.session_ids or "").split(",") if s.strip()]
    for i, sid in enumerate(sids):
        if i < len(reports):
            reports[i]["sessionId"] = sid

    # findings JSON（可选，从 --findings-json 读）
    if args.findings_json:
        try:
            findings_data = _json.loads(args.findings_json)
            if isinstance(findings_data, list) and findings_data:
                if not reports:
                    reports.append({"report": "", "sessionId": "", "role": "", "status": "PASS", "findings": []})
                # 平均分配给各 reviewer（简化）或全部给第一个
                reports[0]["findings"] = findings_data if len(reports) == 1 else findings_data
        except _json.JSONDecodeError:
            pass

    result = rl_mod.collect(
        st,
        args.node,
        reports,
        root_sid,
        has_red_blocker=args.has_red_blocker,
        input_fingerprint=args.input_fingerprint or "",
        ruleset_fingerprint=args.ruleset_fingerprint or "",
        batch_id=args.batch_id or "",
        strict_roles=True,
    )
    state_mod.write_state(sp, st)

    if args.json:
        output.emit(result, as_json=True)
    else:
        output.info(f"🔄 review-loop collect（节点={args.node}）")
        sc = result.get("sessionCheck", {})
        if not sc.get("passed"):
            output.warn(f"   ❌ session 不独立：{sc.get('reason')}")
            output.info(f"   → root 必须真派 sub-agent（自扮会被 G-09B 阻断）")
            return 1
        output.info(f"   ✅ session: {sc.get('reason')}")
        output.info(f"   round={result['round']} dryCounter={result['dryCounter']} "
                    f"newFindings={len(result.get('newFindings', []))}")
        if result.get("rejected"):
            output.warn(f"   拒收 {len(result['rejected'])} 条（锚点格式非法）")
        action = result.get("nextAction")
        if action in {"exit-normal", "exit-passed"}:
            output.info(f"   → ✅ Review Batch 通过（cleanStreak={result.get('cleanStreak', result['dryCounter'])}），可切相")
        elif action == "escalate-user" and result.get("exitReason") == "stalled":
            output.warn(f"   → ⏹️ 预算耗尽，进入 STALLED（{result.get('budgetReason') or 'budget'}），不得视为通过")
        elif action == "escalate-user":
            output.warn(f"   → ⚠️ 超过循环上限仍有 🔴，升级用户决策")
        elif action == "retry-failed-roles":
            output.warn(f"   → 仅重试失败角色：{', '.join(result.get('retryRoles') or [])}")
        elif action == "start-new-fingerprint-session":
            output.warn("   → 输入指纹漂移，必须创建新 fingerprint session")
        else:
            output.info(f"   → 继续派 reviewer（下一轮）")
    return 0 if result.get("sessionCheck", {}).get("passed", True) else 1


