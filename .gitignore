.gitignore
!apps/ae-sdd-monitor/.gitignore
# =============================================
# IDE / Editor
# =============================================
.idea/
!.idea/.gitignore
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# =============================================
# OS
# =============================================
.DS_Store
Thumbs.db
desktop.ini
# Windows reserved device name created by `> nul` redirection misuse
nul

# =============================================
# Claude Code 本地数据
# =============================================
# 本地插件元数据（plugin.json 由 sync 脚本生成）
.claude-plugin/plugin.json
# 本地 dev hooks（开发者在 ae-sdd 母版仓库里 dogfooding 用的硬编码路径配置）
# 真实目标项目的 hooks 写到目标项目自己的 .claude/settings.json（init-hooks 流程）
.claude/

# ae-sdd local toolset secrets (DB profiles, tokens, local-only adapters)
.ae-sdd/secrets/
# ae-sdd local runtime telemetry (perf report/doctor source data)
.ae-sdd/runtime-stats/
# ae-sdd local session engage markers (per-session gate switch, runtime-only)
.ae-sdd/.session-engaged/
.ae-sdd/.hook-activity/


# =============================================
# 构建 / 依赖
# =============================================
node_modules/
dist/
build/
out/
target/
apps/ae-sdd-monitor/release/
*.class
*.jar

# =============================================
# 临时 / 日志
# =============================================
*.log
*.tmp
*.bak
*.bak.*
*.orig
tmp/
temp/
# 根目录扫描临时文件（_前缀一次性产物，勿入库；仅匹配仓库根，不影响子目录合法 _* 文件）
/_*.txt
/_*.json
/_*.md
/.tmp/

# =============================================
# sync-to-plugin.sh 生成的备份目录
# =============================================
plugins/*.bak*/

# =============================================
# dist/ — 实例化分发包（build-dist.sh 产物）
# =============================================
dist/

# =============================================
# 规则-工具同步 manifest（构建产物，不入库；分发时自动重新生成）
# =============================================
tools/.sync-manifest.json

# =============================================
# ZCode 本地 session plan 临时文件（plan mode 产物，不入库）
# =============================================
.zcode/

# =============================================
# ae-sdd 项目实例化运行时产物（init/flow 生成，不入母版仓库）
# =============================================
.ae-sdd/
.ae-sdd-job-receipts/
.harness/.ae-sdd-job-receipts/
.auto-engineering/
ae-sdd-doc/
# ae-sdd generated docs
ae-sdd-doc/
