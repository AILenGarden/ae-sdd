.gitignore
# =============================================
# IDE / Editor
# =============================================
.idea/
!.idea/.gitignore
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# =============================================
# OS
# =============================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================
# Claude Code 本地数据
# =============================================
# 本地插件元数据（plugin.json 由 sync 脚本生成）
.claude-plugin/plugin.json
# 本地 dev hooks（开发者在 ae-sdd 母版仓库里 dogfooding 用的硬编码路径配置）
# 真实目标项目的 hooks 写到目标项目自己的 .claude/settings.json（init-hooks 流程）
.claude/

# ae-sdd local toolset secrets (DB profiles, tokens, local-only adapters)
.ae-sdd/secrets/

# =============================================
# Python
# =============================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/

# =============================================
# 构建 / 依赖
# =============================================
node_modules/
dist/
build/
out/
target/
*.class
*.jar

# =============================================
# 临时 / 日志
# =============================================
*.log
*.tmp
*.bak
*.orig
tmp/
temp/

# =============================================
# sync-to-plugin.sh 生成的备份目录
# =============================================
plugins/*.bak*/

# =============================================
# dist/ — 实例化分发包（build-dist.sh 产物）
# =============================================
dist/
